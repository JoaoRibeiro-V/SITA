@page "/cadastro-funcionario"
@using SITA.src.Model
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="container" style="max-width: 950px; margin-top: 20px; padding-bottom: 50px;">
    <div class="card shadow-lg border-0" style="border-radius: 15px; border-top: 8px solid #3650a1;">
        
        <div class="card-header bg-white p-4 text-center">
            <h3 class="fw-bold" style="color: #3650a1;"> Registro de Novo Colaborador</h3>
            
        </div>

        <div class="card-body p-4" style="background-color: #fcfcfc;">
            <div class="row g-3">
                <div class="col-12"><h5 class="text-primary border-bottom pb-2">Credenciais e Identificação</h5></div>
                
                <div class="col-md-8">
                    <label class="fw-bold">Nome Completo:</label>
                    <input type="text" class="form-control" @bind="novoFuncionario.Nome" placeholder="Nome Completo" />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">CPF:</label>
                    <input type="text" class="form-control"
                           value="@novoFuncionario.CPF"
                           @oninput="OnCpfInput"
                           placeholder="000.000.000-00" maxlength="14" />
                </div>

                <div class="col-md-7">
                    <label class="fw-bold">E-mail (Login):</label>
                    <input type="email" class="form-control" @bind="novoFuncionario.Email" placeholder="funcionario@gmail.com" />
                </div>
                <div class="col-md-5">
                    <label class="fw-bold">Nível de Acesso:</label>
                    <select class="form-select" @bind="nivelAcessoDigitado">
                        <option value="1">Operacional</option>
                        <option value="2">Professor</option>
                        <option value="3">Secretaria (Edição)</option>
                        <option value="4">Diretoria (Gestão total)</option>
                    </select>
                </div>

                <div class="col-12 mt-4"><h5 class="text-primary border-bottom pb-2">Informações Contratuais</h5></div>

                <div class="col-md-5">
                    <label class="fw-bold">Cargo:</label>
                    <input type="text" class="form-control border-info" @bind="novoFuncionario.Cargo" placeholder="Ex: Professora" />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Departamento:</label>
                    <select class="form-select border-info" @bind="novoFuncionario.Departamento">
                        <option value="Assistente"></option>
                        <option value="Administrativo">Administrativo</option>
                        <option value="Docente">Corpo Docente</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Salário Base (R$):</label>
                    <input type="number" class="form-control border-success fw-bold" @bind="salarioDigitado" step="0.01" />
                </div>

                <div class="col-md-4">
                    <label class="fw-bold">Data de Admissão:</label>
                    <input type="date" class="form-control" @bind="novoFuncionario.DataAdmissao" />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Telefone:</label>
                    <input type="text" class="form-control"
                           value="@novoFuncionario.Telefone"
                           @oninput="OnTelefoneInput"
                           placeholder="(12) 99999-9999" maxlength="15" />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Chave PIX (Pagamento):</label>
                    <input type="text" class="form-control" @bind="novoFuncionario.ChavePix" />
                </div>
            </div>
        </div>

        <div class="card-footer bg-white p-4 d-flex justify-content-end gap-2">
            <button class="btn btn-light px-4 border" @onclick="Voltar">Cancelar</button>
            <button class="btn btn-primary px-5 fw-bold" style="background-color: #3650a1;" @onclick="SalvarFuncionario">
                FINALIZAR E REGISTRAR
            </button>
        </div>
    </div>
</div>

@code {
    private Funcionario novoFuncionario = new Funcionario();
    private decimal salarioDigitado = 0;
    private string nivelAcessoDigitado = "1";

    protected override void OnInitialized()
    {
        novoFuncionario.DataAdmissao = DateTime.Today;
    }
    private void OnCpfInput(ChangeEventArgs e)
    {
        string input = e.Value?.ToString() ?? "";
        string apenasNumeros = new string(input.Where(char.IsDigit).ToArray());

        if (apenasNumeros.Length > 11) apenasNumeros = apenasNumeros.Substring(0, 11);

        string formatado = apenasNumeros;
        if (apenasNumeros.Length > 3) formatado = formatado.Insert(3, ".");
        if (apenasNumeros.Length > 6) formatado = formatado.Insert(7, ".");
        if (apenasNumeros.Length > 9) formatado = formatado.Insert(11, "-");

        novoFuncionario.CPF = formatado;
    }

    private void OnTelefoneInput(ChangeEventArgs e)
    {
        string input = e.Value?.ToString() ?? "";
        string apenasNumeros = new string(input.Where(char.IsDigit).ToArray());

        if (apenasNumeros.Length > 11) apenasNumeros = apenasNumeros.Substring(0, 11);

        string formatado = apenasNumeros;
        if (apenasNumeros.Length > 0) formatado = "(" + formatado;
        if (apenasNumeros.Length > 2) formatado = formatado.Insert(3, ") ");
        if (apenasNumeros.Length > 7) formatado = formatado.Insert(10, "-");

        novoFuncionario.Telefone = formatado;
    }
    private void SalvarFuncionario()
    {
        // Validações de Robustez
        if (string.IsNullOrWhiteSpace(novoFuncionario.Nome) || salarioDigitado <= 0) return;

        try
        {
           
            novoFuncionario.AccessType = new SITA.src.Model.AccessType
            {
                Level = int.Parse(nivelAcessoDigitado)
            };
            
            
            novoFuncionario.Senha = "123456"; 

            // Salvando através do Controller
            FuncionarioController.Register(novoFuncionario);

            // Redireciona para a lista (que faremos a seguir)
            Navigation.NavigateTo("/lista-funcionarios");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Erro ao registrar funcionário: {ex.Message}");
        }
    }

    private void Voltar() => Navigation.NavigateTo("/");
}