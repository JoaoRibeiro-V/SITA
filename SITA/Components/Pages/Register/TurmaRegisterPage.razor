@page "/cadastro-turma"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="form-container">

    <EditForm Model="this" OnValidSubmit="Cadastrar">

        <h2>Cadastro de Turma</h2>

        <input @bind="nome" placeholder="Nome da Turma" />

        <select @bind="turno">
            @foreach (var t in Turma.Turnos)
            {
                <option value="@t">@t</option>
            }
        </select>

        <button type="submit">Cadastrar</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="msg">@message</p>
        }

    </EditForm>

</div>

@code {
    string nome = "";
    string turno = Turma.Turnos[0];
    string message = "";

    void Cadastrar()
    {
        try
        {
            var turma = new Turma
            {
                Nome = nome,
                Turno = turno
            };

            TurmaController.Register(turma);

            message = "Turma cadastrada com sucesso!";
        }
        catch (Exception ex)
        {
            message = $"Erro: {ex.Message}";
        }
    }
}