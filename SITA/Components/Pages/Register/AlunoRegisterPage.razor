@page "/cadastro-aluno"
@namespace SITA.Maui.Components
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Storage
@using SITA.src.Util
@inject NavigationManager Navigation

<div class="container" style="background-color: white; padding: 30px; border-radius: 12px; border: 2px solid #3650a1; max-width: 950px; margin: 20px auto; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">

    <div style="text-align: center; border-bottom: 2px solid #3650a1; margin-bottom: 30px; padding-bottom: 10px;">
        <h2 style="color: #3650a1; font-weight: bold;">FICHA DE MATRÍCULA COMPLETA</h2>
    </div>

    <!-- SEÇÃO 1: Dados do Aluno -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="fw-bold" style="color: #3650a1;">Nome Completo do Aluno:</label>
            <input class="form-control" @bind="novoAluno.Nome" />
        </div>
        <div class="col-md-3">
            <label class="fw-bold" style="color: #3650a1;">Data de Nascimento:</label>
            <input type="date" class="form-control" @bind="novoAluno.DataNascimento" @bind:after="() => CalcularIdade()" />
        </div>
        <div class="col-md-3">
            <label class="fw-bold text-muted">Idade Calculada:</label>
            <div class="p-2 bg-light border rounded">@idadeExtenso</div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <label class="fw-bold" style="color: #3650a1;">RA:</label>
            <input class="form-control bg-light" @bind="novoAluno.RA" />
        </div>
        <div class="col-md-4">
            <label class="fw-bold" style="color: #3650a1;">Religião:</label>
            <select class="form-select border-navy" @bind="novoAluno.Religiao">
                <option value="Católica">Católica</option>
                <option value="Evangélica">Evangélica</option>
                <option value="Espírita">Espírita</option>
                <option value="Umbanda / Candomblé">Umbanda / Candomblé</option>
                <option value="Sem religião">Sem religião</option>
                <option value="Prefiro não informar">Prefiro não informar</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="fw-bold" style="color: #3650a1;">Turma:</label>
            <select class="form-select" @bind="turmaId">
                <option value="">Selecione...</option>
                @foreach (var t in listaTurmas)
                {
                    <option value="@t.Id">@t.Nome</option>
                }
            </select>
        </div>
    </div>

    <!-- SEÇÃO 2: Responsáveis -->
    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #3650a1;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 style="color: #3650a1; font-weight: bold; margin: 0;">Responsáveis</h5>
            <button type="button" class="btn btn-sm fw-bold"
                    style="background-color: #3650a1; color: white; max-width: 280px;"
                    @onclick="AdicionarResponsavel">
                + Adicionar Responsável
            </button>
        </div>

        @for (int i = 0; i < responsaveisForm.Count; i++)
        {
            var idx = i;
            var rf = responsaveisForm[idx];

            <div style="border: 1px solid #c8d3f0; border-radius: 8px; margin-bottom: 12px; overflow: hidden;">

                <!-- Cabeçalho do card do responsável -->
                <div style="background-color: #e8ecf8; padding: 10px 15px; display: flex; justify-content: space-between; align-items: center; cursor: pointer;"
                     @onclick="() => ToggleResponsavel(idx)">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 0.9rem; font-weight: bold; color: #3650a1;">
                            Responsável @(idx + 1)
                            @if (!string.IsNullOrEmpty(rf.NomeExibicao))
                            {
                                <span style="font-weight: normal; color: #555;"> — @rf.NomeExibicao</span>
                            }
                        </span>
                        @if (rf.Confirmado)
                        {
                            <span class="badge bg-success" style="font-size: 0.7rem;">Confirmado</span>
                        }
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        @if (responsaveisForm.Count > 1)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    style="padding: 2px 8px; font-size: 0.75rem;"
                                    @onclick:stopPropagation
                                    @onclick="() => RemoverResponsavel(idx)">
                                ✕
                            </button>
                        }
                        <h6 class="fw-bold m-0"
                            style="
                            transition: transform 0.25s ease;
                            transform: @(rf.Expandido ? "rotate(180deg)" : "rotate(0deg)");
                            ">
                            ▾
                        </h6>
                    </div>
                </div>

                <!-- Corpo expansível -->
                @if (rf.Expandido)
                {
                    <div style="padding: 15px;">

                        <!-- Campo CPF com sugestões -->
                        <div class="row mb-3">
                            <div class="col-md-6 position-relative">
                                <label class="fw-bold">CPF:</label>
                                <input class="form-control @(rf.ResponsavelVinculado != null ? "border-success" : "")"
                                       value="@rf.CpfFormatado"
                                       onkeypress="onlyNumbers(event)"
                                       @oninput="e => OnCpfResponsavelInput(e, idx)"
                                       placeholder="000.000.000-00"
                                       maxlength="14"
                                       disabled="@rf.Confirmado" />

                                @if (rf.Sugestoes.Any() && !rf.Confirmado)
                                {
                                    <div class="list-group position-absolute w-100" style="z-index: 1000; top: 100%;">
                                        @foreach (var r in rf.Sugestoes)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action"
                                                    @onclick="() => SelecionarResponsavelExistente(idx, r)">
                                                <strong>@r.Nome</strong><br />
                                                <small>@Mask.FormatCpf(r.CPF)</small>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold">Grau de Parentesco:</label>
                                <select class="form-select" @bind="rf.TipoParentesco" disabled="@rf.Confirmado">
                                    @foreach (var kv in Responsavel.TipoParentescoMap)
                                    {
                                        <option value="@kv.Key">@kv.Value</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Campos de dados do responsável -->
                            <div class="row mb-3">
                                <div class="col-md-9">
                                    <label class="fw-bold">Nome Completo:</label>
                                    <input class="form-control" @bind="rf.Nome"
                                           placeholder="Nome completo"
                                           disabled="@rf.Confirmado" />
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold">CEP:</label>
                                    <input class="form-control" @bind="rf.CEP"
                                           placeholder="00000-000"
                                           type="text"
                                           onkeypress="onlyNumbers(event)"
                                           @oninput="e => OnCEPResponsavelInput(e, idx)"
                                           maxlength="9"
                                           disabled="@rf.Confirmado" />
                                </div>
                            
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="fw-bold">Telefone:</label>
                                    <input class="form-control"
                                           value="@rf.TelefoneFormatado"
                                           onkeypress="onlyNumbers(event)"
                                           @oninput="e => OnTelefoneResponsavelInput(e, idx)"
                                           placeholder="(00) 00000-0000"
                                           maxlength="15"
                                           disabled="@rf.Confirmado" />
                                </div>
                                <div class="col-md-6">
                                    <label class="fw-bold">Endereço:</label>
                                    <input class="form-control" @bind="rf.Endereco"
                                           placeholder="Rua, número, bairro..."
                                           disabled="@rf.Confirmado" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-9">
                                    <label class="fw-bold">E-mail:</label>
                                    <input class="form-control" @bind="rf.Email"
                                           placeholder="email@exemplo.com"
                                           type="email"
                                           disabled="@rf.Confirmado" />
                                </div>
                                <div class="col-md-3">
                                <label class="fw-bold">Data de Nascimento:</label>
                                <input type="date" class="form-control" @bind="rf.DataNascimento"/>
                            </div>
                            </div>
                        

                        @if (!string.IsNullOrEmpty(rf.ErroCampo))
                        {
                            <div class="alert alert-danger py-2">@rf.ErroCampo</div>
                        }

                        <!-- Botão confirmar (só aparece se não confirmado) -->
                        @if (!rf.Confirmado)
                        {
                            <button type="button" class="btn fw-bold"
                                    style="background-color: #3650a1; color: white;"
                                    @onclick="() => ConfirmarResponsavel(idx)">
                                Confirmar Responsável
                            </button>
                        }
                        else
                        {
                            <!-- Botão editar (só aparece se confirmado) -->
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => EditarResponsavel(idx)">
                                Editar
                            </button>
                        }

                    </div>
                }

            </div>
        }
    </div>

    <!-- SEÇÃO 3: Contatos de Emergência -->
    <div style="background-color: #ffffff; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #f0a500;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 style="color: #9a6500; font-weight: bold; margin: 0;">Contatos de Emergência</h5>

            <button type="button" class="btn btn-sm fw-bold"
                    style="background-color: #f0a500; color: white; max-width: 280px;"
                    @onclick="AdicionarContatoEmergencia">
                + Adicionar Contato
            </button>
        </div>

        @if (!contatosEmergencia.Any())
        {
            <p class="text-muted fst-italic">Nenhum contato de emergência adicionado.</p>
        }

        @for (int i = 0; i < contatosEmergencia.Count; i++)
        {
            var idx = i;
            var contato = contatosEmergencia[idx];

            <div style="border: 1px solid #ffe0a0; border-radius: 8px; margin-bottom: 12px; overflow: hidden;">

                <!-- Cabeçalho -->
                <div style="
                    background-color: #fff4da;
                    padding: 10px 15px;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    cursor: pointer;"
                     @onclick="() => contato.Expandido = !contato.Expandido">

                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 0.9rem; font-weight: bold; color: #9a6500;">
                            Contato @(idx + 1)

                            @if (!string.IsNullOrWhiteSpace(contato.Nome))
                            {
                                <span style="font-weight: normal; color: #555;">
                                    — @contato.Nome
                                </span>
                            }
                        </span>
                    </div>

                    <div style="display: flex; gap: 8px; align-items: center;">

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                style="padding: 2px 8px; font-size: 0.75rem;"
                                @onclick:stopPropagation
                                @onclick="() => RemoverContatoEmergencia(idx)">
                            ✕
                        </button>

                        <h6 class="fw-bold m-0"
                            style="
                            transition: transform 0.25s ease;
                            transform: @(contato.Expandido ? "rotate(180deg)" : "rotate(0deg)");
                            ">
                            ▾
                        </h6>
                    </div>
                </div>

                <!-- Corpo -->
                @if (contato.Expandido)
                {
                    <div style="padding: 15px;">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold">Nome Completo:</label>

                                <input class="form-control"
                                       @bind="contato.Nome"
                                       placeholder="Nome completo" />
                            </div>
                            <div class="col-md-4">
                                <label class="fw-bold">Telefone:</label>

                                <input class="form-control"
                                       value="@telefonesContatos[idx]"
                                       onkeypress="onlyNumbers(event)"
                                       @oninput="e => OnTelefoneContatoInput(e, idx)"
                                       placeholder="(00) 00000-0000"
                                       maxlength="15" />
                            </div>
                            <div class="col-md-2">
                                <label class="fw-bold">Parentesco:</label>

                                <select class="form-select"
                                        @bind="contato.GrauParentesco">

                                    <option value="">Selecione</option>
                                    <option value="Mãe">Mãe</option>
                                    <option value="Pai">Pai</option>
                                    <option value="Avó">Avó</option>
                                    <option value="Avô">Avô</option>
                                    <option value="Tia">Tia</option>
                                    <option value="Tio">Tio</option>
                                    <option value="Irmão(ã)">Irmão(ã)</option>
                                    <option value="Outro">Outro</option>
                                </select>
                            </div>
                            
                        </div>

                    </div>
                }

            </div>
        }
    </div>

    <!-- SEÇÃO 4: Saúde -->
    <div style="background-color: #fff5f5; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #d9534f;">
        <h5 style="color: #d9534f; font-weight: bold;">Saúde</h5>

        <div class="row mt-3">
            <div class="col-md-6">
                <label class="fw-bold">Pediatra do Aluno:</label>
                <input class="form-control" @bind="novoAluno.NomePediatra" />
            </div>
            <div class="col-md-6">
                <label class="fw-bold">Orientações de Emergência:</label>
                <textarea class="form-control" @bind="novoAluno.OrientacoesEmergencia"></textarea>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label>Alergias (pressione Enter para adicionar):</label>
                <input class="form-control" @bind="addAlergia" @onkeyup="HandleAlergiaKeyUp" />
                <div class="mt-2">
                    @foreach (var a in novoAluno.Alergias ?? new())
                    {
                        <span class="badge bg-danger me-1">@a</span>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label>Condições Especiais (pressione Enter para adicionar):</label>
                <input class="form-control" @bind="addCondicao" @onkeyup="HandleCondicoesKeyUp" />
                <div class="mt-2">
                    @foreach (var c in novoAluno.CondicoesEspeciais ?? new())
                    {
                        <span class="badge bg-warning text-dark me-1">@c</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- SEÇÃO 5: Financeiro -->
    <div class="row mb-4">
        <div class="col-md-6">
            <label class="fw-bold">Valor da Mensalidade (R$):</label>
            <input type="number" class="form-control" @bind="valorMatriculaDigitada" step="0.01" />
        </div>
        <div class="col-md-6">
            <label class="fw-bold">Parcela Inicial (R$):</label>
            <input type="number" class="form-control" @bind="valorParcelaInicial" step="0.01" />
        </div>
    </div>

    <!-- Botões finais -->
    <div class="d-flex gap-3 mt-4">
        <button class="btn btn-outline-secondary w-25 p-3 fw-bold"
                @onclick='() => Navigation.NavigateTo("/alunos")'>
            CANCELAR
        </button>
        <button class="btn w-75 p-3 fw-bold" style="background-color: #3650a1; color: white;"
                @onclick="SalvarAluno">
            FINALIZAR MATRÍCULA E GERAR CARNÊ
        </button>
    </div>

    @if (!string.IsNullOrEmpty(msgErro))
    {
        <div class="alert alert-danger mt-3">@msgErro</div>
    }

</div>

@code {
    private class ResponsavelForm
    {
        public string CpfFormatado { get; set; } = "";
        public string CEP { get; set; } = "";
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string TelefoneFormatado { get; set; } = "";
        public string Endereco { get; set; } = "";
        public DateTime DataNascimento { get; set; } = DateTime.Now;
        public int TipoParentesco { get; set; } = 6;
        public bool Confirmado { get; set; } = false;
        public bool Expandido { get; set; } = true;
        public Responsavel? ResponsavelVinculado { get; set; } = null; // responsável já existente no sistema
        public List<Responsavel> Sugestoes { get; set; } = new();
        public string ErroCampo { get; set; } = "";

        // Nome de exibição no cabeçalho do card
        public string NomeExibicao => ResponsavelVinculado?.Nome ?? Nome;
    }
    private class ContatoEmergenciaForm
    {
        public string Nome { get; set; } = "";
        public string GrauParentesco { get; set; } = "";
        public string Telefone { get; set; } = "";
        public bool Expandido { get; set; } = true;
    }

    private Aluno novoAluno = new Aluno
    {
        Alergias = new List<string>(),
        CondicoesEspeciais = new List<string>()
    };

    private List<Turma> listaTurmas = new();
    private List<Responsavel> todosResponsaveis = new();

    private List<ResponsavelForm> responsaveisForm = new();
    private List<ContatoEmergenciaForm> contatosEmergencia = new();
    private List<string> telefonesContatos = new();

    private decimal valorMatriculaDigitada = 0;
    private decimal valorParcelaInicial = 0;
    private string idadeExtenso = "0 anos e 0 meses";
    private string turmaId = "";
    private string addAlergia = "";
    private string addCondicao = "";
    private string msgErro = "";

    protected override void OnInitialized()
    {
       
        listaTurmas = TurmaController.GetAll();
        todosResponsaveis = ResponsavelController.GetAll();

        // Inicia com um responsável vazio
        responsaveisForm.Add(new ResponsavelForm());
    }

    private void AdicionarResponsavel()
    {
        responsaveisForm.Add(new ResponsavelForm { Expandido = true });
    }

    private void RemoverResponsavel(int idx)
    {
        if (responsaveisForm.Count <= 1) return;
        responsaveisForm.RemoveAt(idx);
    }

    private void ToggleResponsavel(int idx)
    {
        responsaveisForm[idx].Expandido = !responsaveisForm[idx].Expandido;
    }

    private void OnCpfResponsavelInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];

        responsaveisForm[idx].CpfFormatado = Mask.FormatCpf(digits);
        responsaveisForm[idx].ResponsavelVinculado = null;

        // Busca sugestões entre responsáveis cadastrados
        responsaveisForm[idx].Sugestoes = todosResponsaveis
            .Where(r => !string.IsNullOrEmpty(r.CPF) && r.CPF.Contains(digits))
            .Take(5)
            .ToList();
    }

    private void OnTelefoneResponsavelInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        responsaveisForm[idx].TelefoneFormatado = Mask.FormatPhone(digits);
    }
    private void OnCEPResponsavelInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 8) digits = digits[..8];
        responsaveisForm[idx].CEP = Mask.FormatCEP(digits);
    }
    private void SelecionarResponsavelExistente(int idx, Responsavel r)
    {
        var rf = responsaveisForm[idx];
        rf.ResponsavelVinculado = r;
        rf.CpfFormatado = Mask.FormatCpf(r.CPF ?? "");
        rf.Nome = r.Nome ?? "";
        rf.Email = r.Email ?? "";
        rf.TelefoneFormatado = Mask.FormatPhone(r.Telefone ?? "");
        rf.Endereco = r.Endereco ?? "";
        rf.Sugestoes.Clear();
        rf.ErroCampo = "";
    }

    private void ConfirmarResponsavel(int idx)
    {
        var rf = responsaveisForm[idx];
        rf.ErroCampo = "";

        var cpfLimpo = Mask.RemoveMask(rf.CpfFormatado);

        // Valida campos obrigatórios
        if (string.IsNullOrWhiteSpace(cpfLimpo) || cpfLimpo.Length != 11)
        {
            rf.ErroCampo = "CPF inválido.";
            return;
        }
        if (string.IsNullOrWhiteSpace(rf.Nome))
        {
            rf.ErroCampo = "Nome é obrigatório.";
            return;
        }

        rf.Confirmado = true;
        rf.Expandido = false; // minimiza ao confirmar
    }

    private void EditarResponsavel(int idx)
    {
        // Ao editar, só permite alterar campos que não o CPF (CPF fica disabled mesmo)
        responsaveisForm[idx].Confirmado = false;
        responsaveisForm[idx].Expandido = true;
    }

    private void AdicionarContatoEmergencia()
    {
        contatosEmergencia.Add(new ContatoEmergenciaForm());
        telefonesContatos.Add("");
    }

    private void RemoverContatoEmergencia(int idx)
    {
        contatosEmergencia.RemoveAt(idx);
        telefonesContatos.RemoveAt(idx);
    }

    private void OnTelefoneContatoInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        telefonesContatos[idx] = Mask.FormatPhone(digits);
        contatosEmergencia[idx].Telefone = Mask.RemoveMask(telefonesContatos[idx]);
    }
    

    private void CalcularIdade()
    {
        DateTime data = novoAluno.DataNascimento ?? DateTime.Today;
        DateTime hoje = DateTime.Today;
        int anos = hoje.Year - data.Year;
        if (hoje < data.AddYears(anos)) anos--;
        int meses = hoje.Month - data.Month;
        if (hoje.Day < data.Day) meses--;
        if (meses < 0) meses += 12;
        idadeExtenso = $"{anos} anos e {meses} meses";
        novoAluno.Idade = anos;
    }

    private async Task SalvarAluno()
    {
        msgErro = "";

        // Valida nome do aluno
        if (string.IsNullOrWhiteSpace(novoAluno.Nome))
        {
            msgErro = "Nome do aluno é obrigatório.";
            return;
        }

        // Valida que ao menos um responsável está confirmado
        if (!responsaveisForm.Any(rf => rf.Confirmado))
        {
            msgErro = "Confirme ao menos um responsável antes de finalizar.";
            return;
        }

        if (valorMatriculaDigitada <= 0)
        {
            msgErro = "Informe o valor da mensalidade.";
            return;
        }

        try
        {
            novoAluno.ContatosEmergencia = contatosEmergencia.Select(c => new ContatoEmergencia
            {
                Nome = c.Nome,
                GrauParentesco = c.GrauParentesco,
                Telefone = c.Telefone
            }).ToList();
            novoAluno.DataCadastro = DateTime.Now;

            AlunoController.Register(novoAluno);

            // Processa cada responsável confirmado
            foreach (var rf in responsaveisForm.Where(rf => rf.Confirmado))
            {
                var cpfLimpo = Mask.RemoveMask(rf.CpfFormatado);
                Responsavel resp;

                if (rf.ResponsavelVinculado != null)
                {
                    // Usa o responsável já existente no sistema
                    resp = rf.ResponsavelVinculado;
                }
                else
                {
                    // Verifica se já existe um com esse CPF
                    resp = ResponsavelController.Get("CPF", cpfLimpo)
                           ?? CriarNovoResponsavel(rf, cpfLimpo);
                }

                ResponsavelController.AddParentesco(resp, novoAluno, rf.TipoParentesco);
            }

            // Primeiro responsável confirmado gera o carnê
            var respPrincipal = responsaveisForm
                .Where(rf => rf.Confirmado)
                .Select(rf => rf.ResponsavelVinculado
                              ?? ResponsavelController.Get("CPF", Mask.RemoveMask(rf.CpfFormatado)))
                .FirstOrDefault(r => r != null);

            if (respPrincipal != null)
            {
                DateTime fimAno = new DateTime(DateTime.Today.Year, 12, 31);
                ReceitaController.GerarCarneAluno(novoAluno, respPrincipal, valorMatriculaDigitada, fimAno);

                if (valorParcelaInicial > 0)
                    ReceitaController.GerarParcelaInicial(novoAluno, respPrincipal, valorParcelaInicial);
            }

            if (!string.IsNullOrEmpty(turmaId))
            {
                var turma = TurmaController.Get(turmaId, null);
                if (turma != null)
                    TurmaController.AddAlunoToTurma(turma, novoAluno);
            }

            Navigation.NavigateTo("/alunos");
        }
        catch (Exception ex)
        {
            msgErro = "Erro: " + ex.Message;
        }
    }

    private Responsavel CriarNovoResponsavel(ResponsavelForm rf, string cpfLimpo)
    {
        var user = new User
        {
            Nome = rf.Nome,
            CPF = cpfLimpo,
            Email = rf.Email,
            AccessType = new AccessType { Level = 0 }
        };
        user.Senha = PasswordHandler.HashPassword(rf.DataNascimento.ToString("yyyy-MM-dd").Replace("/", ""), user.Salt);

        UserController.Register(user);

        var resp = ResponsavelController.CreateByUser(user);
        resp.Telefone = Mask.RemoveMask(rf.TelefoneFormatado);
        resp.Endereco = rf.Endereco;
        resp.CEP = Mask.RemoveMask(rf.CEP);

        ResponsavelController.Register(resp);
        return resp;
    }

    private void HandleAlergiaKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAlergia))
        {
            novoAluno.Alergias ??= new();
            novoAluno.Alergias.Add(addAlergia.Trim());
            addAlergia = "";
        }
    }

    private void HandleCondicoesKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addCondicao))
        {
            novoAluno.CondicoesEspeciais ??= new();
            novoAluno.CondicoesEspeciais.Add(addCondicao.Trim());
            addCondicao = "";
        }
    }
