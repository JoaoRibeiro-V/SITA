@page "/cadastro-responsavel"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="form-container">

    <h2>Cadastro de Responsável</h2>

    <EditForm Model="this" OnValidSubmit="Cadastrar">

        <input @bind="nome" @onkeydown="HandleNomeKeyDown" placeholder="Nome" />

        <input value="@cpf"
               @ref="cpfInput"
               @oninput="OnCpfInput"
               @onkeydown="HandleCpfKeyDown"
               onkeypress="onlyNumbers(event)"
               placeholder="CPF"
               maxlength="14" />

        <input @bind="email" @ref="emailInput" @onkeydown="HandleEmailKeyDown" placeholder="Email" />

        <input value="@telefone"
               @ref="telefoneInput"
               @oninput="OnTelefoneInput"
               @onkeydown="HandleTelefoneKeyDown"
               placeholder="Telefone"
               maxlength="15" />

        <input @bind="endereco" @ref="enderecoInput" @onkeydown="HandleEnderecoKeyDown" placeholder="Endereço" />

        <input type="password" @bind="senha" placeholder="Senha" />

        <button type="submit">Cadastrar</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="msg">@message</p>
        }

    </EditForm>

</div>

@code {
    string nome = "";
    string cpf = "";
    string email = "";
    string telefone = "";
    string endereco = "";
    string senha = "";
    string message = "";

    ElementReference cpfInput;
    ElementReference emailInput;
    ElementReference telefoneInput;
    ElementReference enderecoInput;
    ElementReference senhaInput;

    async Task HandleNomeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await cpfInput.FocusAsync();
    }

    async Task HandleCpfKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await emailInput.FocusAsync();
    }

    async Task HandleEmailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await telefoneInput.FocusAsync();
    }

    async Task HandleTelefoneKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await enderecoInput.FocusAsync();
    }

    async Task HandleEnderecoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await senhaInput.FocusAsync();
    }

    void OnCpfInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        cpf = Mask.FormatCpf(digits);
    }

    void OnTelefoneInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        telefone = Mask.FormatPhone(digits);
    }

    void Cadastrar()
    {
        try
        {
            string cleanCpf = Mask.RemoveMask(cpf);
            string cleanPhone = Mask.RemoveMask(telefone);

            string? error =
                Validator.ValidateRequired(
                    (nome, "Nome"),
                    (cleanCpf, "CPF"),
                    (email, "Email"),
                    (senha, "Senha")
                )
                ?? Validator.ValidateCPF(cleanCpf)
                ?? Validator.ValidateEmail(email)
                ?? Validator.ValidatePassword(senha)
                ?? Validator.ValidateDuplicateCPF(cleanCpf)
                ?? Validator.ValidateDuplicateEmail(email);

            if (error != null)
            {
                message = error;
                return;
            }

            User user = new User
            {
                Nome = nome,
                CPF = cleanCpf,
                Email = email,
                AccessType = new AccessType { Level = 0 }
            };

            user.Senha = PasswordHandler.HashPassword(senha, user.Salt);

            UserController.Register(user);

            Responsavel responsavel = ResponsavelController.CreateByUser(user);

            responsavel.Telefone = cleanPhone;
            responsavel.Endereco = endereco;

            ResponsavelController.Register(responsavel);

            message = "Responsável cadastrado com sucesso!";
        }
        catch (Exception ex)
        {
            message = $"Erro: {ex.Message}";
        }
    }
}