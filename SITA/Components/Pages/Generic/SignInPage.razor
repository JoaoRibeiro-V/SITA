@page "/signin"
@namespace SITA.Maui.Components
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Controller
@using SITA.Maui
@inject NavigationManager Navigation

<div class="body">
    <section class="fundo">

        <div class="campos">

            <!-- LOGO -->
            <span>
                <img src="assets/images/Logo.png" alt="logo" />
            </span>

            <!-- USER (CPF) -->
            <input @bind="userName"
                   @oninput="OnCpfInput"
                   class="form-control"
                   type="text"
                   placeholder="Usuário (CPF)"
                   maxlength="14" />

            <!-- PASSWORD -->
            <input @bind="password"
                   class="form-control"
                   type="password"
                   placeholder="Senha"
                   />

            <!-- ERROR -->
            @if (showError)
            {
                <p style="color:red; text-align:center;">
                    @errorMessage
                </p>
            }

            <!-- LOGIN BUTTON -->
            <button @onclick="HandleSignIn" id="confirmar">
                Entrar
            </button>

            <!-- SIGNUP -->
            <div style="text-align: center; margin-top: 20px;">
                <button @onclick="IrParaCadastro"
                        style="background: transparent; border: none; color: #000000; cursor: pointer; text-decoration: underline;">
                    Não tem conta? Criar conta agora
                </button>
            </div>

        </div>
    </section>

    <!-- BACKGROUND DECOR -->
    <div class="bola1">
        <div class="bola2">
            <div class="bola3"></div>
        </div>
    </div>

    <svg class="linha" viewBox="0 0 1000 700" preserveAspectRatio="none">
        <path d="
        M0,0
        L0,100
        C200,200 400,50 600,150
        S900,400 700,600
        S300,650 1000,700
        L1000,0
        Z
        " fill="#264ECA" stroke="#264ECA" stroke-width="2" />
    </svg>
</div>

@code {
    private string userName = "";
    private string password = "";
    private string errorMessage = "";
    private bool showError = false;

    private void OnCpfInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "")
            .Where(char.IsDigit)
            .ToArray());

        if (digits.Length > 11)
            digits = digits[..11];

        userName = Mask.FormatCpf(digits);
    }

    private void HandleSignIn()
    {
        string cleanCpf = Mask.RemoveMask(userName);

        string? error = Validator.ValidateLogin(cleanCpf, password);

        if (error != null)
        {
            DisplayError(error);
            return;
        }
        User? user = UserController.Get("CPF", cleanCpf);


        if (user == null || !PasswordHandler.VerifyPassword(password, user.Senha))
        {
            DisplayError("Usuário ou senha inválidos.");
            return;
        }

        MauiProgram.AppSession.InitSession(user);
        Navigation.NavigateTo("/");
    }

    private void DisplayError(string message)
    {
        errorMessage = message;
        showError = true;
    }

    private void IrParaCadastro()
    {
        Navigation.NavigateTo("/signup");
    }
}