@page "/nova-despesa"
@using SITA.src.Model
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="container" style="max-width: 900px; margin-top: 30px; margin-bottom: 50px;">
    <div class="card shadow-lg border-0" style="border-radius: 15px; border-top: 8px solid #000080;">
        <div class="card-header bg-white p-4">
            <h3 class="fw-bold" style="color: #000080;">📄 Registro de Despesa e Nota Fiscal</h3>
            <p class="text-muted">CNPJ da Escola: <strong>00.000.000/0001-00</strong></p>
        </div>

        <div class="card-body p-4" style="background-color: #fcfcfc;">
            <div class="row g-3">
                <div class="col-12"><h5 class="text-secondary border-bottom pb-2">Informações Gerais</h5></div>

                <div class="col-md-5">
                    <label class="fw-bold">Descrição do Item/Serviço:</label>
                    <input type="text" class="form-control" @bind="novaDespesa.Descricao" placeholder="Ex: Produtos de Limpeza" />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Categoria:</label>

                    <select class="form-select" @bind="novaDespesa.Categoria">

                        <optgroup label="Contas">
                            <option>Conta de Luz</option>
                            <option>Conta de Água</option>
                            <option>Internet</option>
                            <option>Telefone</option>
                            <option>Aluguel</option>
                        </optgroup>

                        <optgroup label="Funcionários">
                            <option>Salários</option>
                            <option>Treinamentos</option>
                        </optgroup>

                        <optgroup label="Materiais">
                            <option>Material Escolar</option>
                            <option>Papelaria</option>
                            <option>Livros Didáticos</option>
                            <option>Uniformes</option>
                        </optgroup>

                        <optgroup label="Infraestrutura">
                            <option>Limpeza</option>
                            <option>Produtos de Higiene</option>
                            <option>Manutenção do Prédio</option>
                        </optgroup>

                        <optgroup label="Tecnologia">
                            <option>Computadores</option>
                            <option>Impressoras</option>
                            <option>Equipamentos</option>
                        </optgroup>

                        <optgroup label="Administrativo">
                            <option>Eventos</option>
                        </optgroup>

                        <optgroup label="Transporte">
                            <option>Combustível</option>
                            <option>Transporte</option>
                        </optgroup>

                        <option>Outros</option>

                    </select>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Valor Total:</label>

                    <div class="input-group">

                        <span class="input-group-text">
                            R$
                        </span>

                        <input type="text"
                               class="form-control border-primary text-end"
                               placeholder="0,00"
                               @bind="valorDigitadoTexto" />

                    </div>
                </div>

                <div class="col-12 mt-4"><h5 class="text-secondary border-bottom pb-2">Dados Fiscais (NF-e)</h5></div>

                <div class="col-md-6">
                    <label class="fw-bold">Fornecedor (Razão Social):</label>
                    <input type="text" class="form-control" @bind="novaDespesa.Fornecedor" />
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">CNPJ do Fornecedor:</label>
                    <input type="text" class="form-control"
                           value="@cnpjFormatado"
                           @oninput="OnCnpjInput"
                           placeholder="00.000.000/0000-00"
                           maxlength="18" />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Nº da Nota Fiscal:</label>
                    <input type="text" class="form-control" @bind="novaDespesa.NumeroNotaFiscal" maxlength="9" />
                </div>
                <div class="col-md-8">
                    <label class="fw-bold">Chave de Acesso (44 dígitos):</label>
                    <input type="text" class="form-control" @bind="novaDespesa.ChaveAcessoNF" maxlength="44" />
                </div>

                <div class="col-12 mt-4"><h5 class="text-secondary border-bottom pb-2">Controle de Pagamento</h5></div>

                <div class="col-md-5">
                    <label class="fw-bold">Quem realizou o pagamento?</label>
                    <input type="text" class="form-control" @bind="novaDespesa.QuemPagou" placeholder="Nome do Responsável" />
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Data de Vencimento:</label>
                    <input type="date" class="form-control" @bind="novaDespesa.DataVencimento" />
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Status:</label>
                    <select class="form-select" @onchange="OnStatusChange">
                        <option value="false">Pendente</option>
                        <option value="true">Pago</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white p-4 d-flex justify-content-end gap-2">
            <button class="btn btn-light px-4" @onclick="Cancelar">Voltar</button>
            <button class="btn btn-success px-5 fw-bold" @onclick="Salvar">EFETIVAR REGISTRO</button>
        </div>
    </div>
</div>

@code {

    private Despesa novaDespesa = new Despesa();
    private string valorDigitadoTexto = string.Empty;
    private string cnpjFormatado = "";

    
    protected override void OnInitialized()
    {
        novaDespesa.DataVencimento = DateTime.Today;
        novaDespesa.Categoria = "Infraestrutura";
    }

    private void OnCnpjInput(ChangeEventArgs e)
    {
        string input = e.Value?.ToString() ?? "";
        // Remove tudo que não é número
        string apenasNumeros = new string(input.Where(char.IsDigit).ToArray());

        if (apenasNumeros.Length > 14) apenasNumeros = apenasNumeros.Substring(0, 14);

     
        cnpjFormatado = apenasNumeros;
        if (apenasNumeros.Length > 2) cnpjFormatado = cnpjFormatado.Insert(2, ".");
        if (apenasNumeros.Length > 5) cnpjFormatado = cnpjFormatado.Insert(6, ".");
        if (apenasNumeros.Length > 8) cnpjFormatado = cnpjFormatado.Insert(10, "/");
        if (apenasNumeros.Length > 12) cnpjFormatado = cnpjFormatado.Insert(15, "-");

        novaDespesa.CnpjFornecedor = cnpjFormatado;
    }

    private void OnStatusChange(ChangeEventArgs e)
    {
        novaDespesa.Status = bool.Parse(e.Value?.ToString() ?? "false");
    }

    private float ParseValor(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return 0;

        texto = texto.Trim();
        texto = texto.Replace(".", ",");

        if (float.TryParse(
            texto,
            System.Globalization.NumberStyles.Any,
            new System.Globalization.CultureInfo("pt-BR"),
            out float valor))
        {
            return valor;
        }

        return 0;
    }

    private void Salvar()
    {
        float valorDigitado = ParseValor(valorDigitadoTexto);
        if (valorDigitado <= 0 || string.IsNullOrWhiteSpace(novaDespesa.Descricao)) return;

        try
        {
            novaDespesa.Valor = valorDigitado;
            DespesaController.Register(novaDespesa);
            Navigation.NavigateTo("/despesas");
        }
        catch (Exception ex)
        {
           
            System.Diagnostics.Debug.WriteLine($"ERRO SITA: {ex.Message}");
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/despesas");
}