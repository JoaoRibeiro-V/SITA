@page "/lista-funcionarios/{FuncionarioId:guid?}"
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Util
@inject NavigationManager Navigation

<div class="header-padrao-sita">
    <h1>Quadro de Colaboradores</h1>

    <div class="header-acoes-sita">
        <button class="btn-cadastrar-sita" @onclick='() => Navigation.NavigateTo("/cadastro-funcionario")'>
            + Novo Funcionário
        </button>

        <input class="input-pesquisa-sita"
               @bind="search"
               @bind:event="oninput"
               placeholder="Pesquisar funcionário..." />
    </div>
</div>
<style>
    /* Header padrão SITA */
    .header-padrao-sita {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
    }

        /* Título padrão */
        .header-padrao-sita h1 {
            color: #3650a1;
            font-weight: bold;
            font-size: 2.5rem;
            margin: 0;
        }

    /* Área do botão e pesquisa */
    .header-acoes-sita {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Botão padrão com tamanho fixo */
    .btn-cadastrar-sita {
        background: linear-gradient(135deg, #3650a1 0%, #20335e 100%);
        border: none;
        width: 190px;
        height: 44px;
        padding: 0 16px;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        color: white;
        cursor: pointer;
        transition: 0.2s;
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        /* Hover do botão */
        .btn-cadastrar-sita:hover {
            opacity: 0.95;
        }

    /* Campo de pesquisa padrão */
    .input-pesquisa-sita {
        width: 180px;
        height: 44px;
        padding: 8px;
        border-radius: 5px;
        border: 1px solid #ccc;
        font-size: 0.95rem;
        outline: none;
        box-sizing: border-box;
    }

        /* Foco do input */
        .input-pesquisa-sita:focus {
            border-color: #3650a1;
        }

</style>

<section style="padding: 20px; width:100%">
    <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">
        <thead>
            <tr style="color: white;">
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-left-radius: 8px;">Nome</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Cargo</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Departamento</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Acesso</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Salário</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-right-radius: 8px;">Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var funcionario in funcionariosFiltrados)
            {
                <tr @onclick="() => AbrirModal(funcionario)"
                    style="cursor: pointer; background: transparent;">
                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @funcionario.Nome
                    </td>
                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @funcionario.Cargo
                    </td>
                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(funcionario.Departamento ?? "N/A")
                    </td>
                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @funcionario.AccessType?.GetAccessName()
                    </td>
                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        R$ @funcionario.SalarioBase.ToString("N2")
                    </td>
                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(funcionario.Ativo ? "Ativo" : "Inativo")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

@if (mostrarModalFuncionario && funcionarioSelecionado != null)
{
    <div class="overlay-modal">
        <div class="modal-funcionario @(animarModal ? "modal-aberta" : "")">
            <div class="modal-topo">
                <h2>@funcionarioSelecionado.Nome</h2>
                <button class="btn-fechar" @onclick="FecharModal">×</button>
            </div>
            <br />

            <div class="abas-modal">
                <button class="@(abaAtiva == "ficha" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "ficha"'>
                    Ficha do Colaborador
                </button>
                <button class="@(abaAtiva == "financeiro" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "financeiro"'>
                    Financeiro
                </button>
            </div>

            <div class="conteudo-modal">
                @if (abaAtiva == "ficha")
                {
                    <div class="ficha-container">
                        <div class="ficha-titulo">
                            <h2>FICHA DO COLABORADOR</h2>
                        </div>

                        <div class="linha">
                            <div class="campo campo-grande">
                                <label>Nome Completo:</label>
                                <input @bind="Nome" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>
                            <div class="campo campo-medio">
                                <label>CPF:</label>
                                <input value="@CPF" readonly />
                            </div>
                        </div>

                        <div class="linha">
                            <div class="campo campo-terco">
                                <label>Email:</label>
                                <input @bind="Email" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>
                            <div class="campo campo-terco">
                                <label>Telefone:</label>
                                <input @bind="Telefone" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>
                            <div class="campo campo-terco">
                                <label>Chave Pix:</label>
                                <input @bind="ChavePix" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>
                        </div>

                        <div class="bloco responsavel">
                            <h3>Informações Profissionais</h3>
                            <div class="linha">
                                <div class="campo metade">
                                    <label>Cargo:</label>
                                    <input @bind="Cargo" @bind:event="oninput" disabled="@(!modoEdicao)" />
                                </div>
                                <div class="campo metade">
                                    <label>Departamento:</label>
                                    <input @bind="Departamento" @bind:event="oninput" disabled="@(!modoEdicao)" />
                                </div>
                            </div>
                            <div class="linha">
                                <div class="campo metade">
                                    <label>Salário Base:</label>
                                    <input type="number" step="0.01" @bind="SalarioBase" @bind:event="oninput" disabled="@(!modoEdicao)" />
                                </div>
                                <div class="campo metade">
                                    <label>Data de Admissão:</label>
                                    <input type="date" @bind="DataAdmissao" disabled="@(!modoEdicao)" />
                                </div>
                            </div>
                            <div class="linha">
                                <div class="campo metade">
                                    <label>Nível de Acesso:</label>
                                    @if (modoEdicao)
                                    {
                                        <select @bind="NivelAcesso">
                                            <option value="1">Funcionário</option>
                                            <option value="2">Professor</option>
                                            <option value="3">Secretário</option>
                                            <option value="4">Diretor</option>
                                            <option value="5">Administrador</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <input value="@funcionarioSelecionado.AccessType?.GetAccessName()" readonly />
                                    }
                                </div>
                                <div class="campo metade">
                                    <label>Status:</label>
                                    @if (modoEdicao)
                                    {
                                        <select @bind="Ativo">
                                            <option value="true">Ativo</option>
                                            <option value="false">Inativo</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <input value="@(funcionarioSelecionado.Ativo ? "Ativo" : "Inativo")" readonly />
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(msgErro))
                        {
                            <div class="alert alert-danger mt-3">@msgErro</div>
                        }

                        <div class="d-flex gap-3 mt-4">
                            @if (modoEdicao)
                            {
                                <button class="btn btn-outline-secondary w-25 p-3 fw-bold" @onclick="CancelarEdicao">CANCELAR</button>
                                <button class="btn w-75 p-3 fw-bold" style="background-color: #3650a1; color: white;" @onclick="SalvarFuncionario">
                                    SALVAR
                                </button>
                            }
                            else
                            {
                                <button class="btn w-100 p-3 fw-bold" style="background-color: #3650a1; color: white;" @onclick="HabilitarEdicao">
                                    EDITAR
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (abaAtiva == "financeiro")
                {
                    <div class="aba-financeiro">
                        <h2>FINANCEIRO - DESPESAS</h2>

                        @if (DespesasFuncionario.Any())
                        {
                            <div class="row mb-3 g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Pesquisar</label>
                                    <input class="form-control" placeholder="Categoria..."
                                           @bind="pesquisaFinanceiro" @bind:event="oninput" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Status</label>
                                    <select class="form-select" @bind="statusFinanceiro">
                                        <option value="">Todos</option>
                                        <option value="Pago">Pago</option>
                                        <option value="Pendente">Pendente</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Data Inicial</label>
                                    <input type="date" class="form-control" @bind="dataInicioFinanceiro" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Data Final</label>
                                    <input type="date" class="form-control" @bind="dataFimFinanceiro" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Ordenar Valor</label>
                                    <select class="form-select" @bind="ordemValorFinanceiro">
                                        <option value="">Padrão</option>
                                        <option value="asc">Menor → Maior</option>
                                        <option value="desc">Maior → Menor</option>
                                    </select>
                                </div>
                            </div>

                            <table class="table table-sm table-bordered table-striped mt-3">
                                <thead style="background-color:#3650a1; color:white;">
                                    <tr>
                                        <th>Mês</th>
                                        <th>Categoria</th>
                                        <th>Vencimento</th>
                                        <th>Valor</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in DespesasFinanceirasPaginadas)
                                    {
                                        <tr @onclick="() => GoDespesa(d.Id)" style="cursor: pointer;">
                                            <td>@d.DataVencimento.ToString("MM/yyyy")</td>
                                            <td>@d.Categoria</td>
                                            <td>@d.DataVencimento.ToString("dd/MM/yyyy")</td>
                                            <td>R$ @d.GetValorTotal().ToString("N2")</td>
                                            <td>
                                                <span class="badge @(d.IsPago() ? "bg-success" : "bg-warning text-dark")">
                                                    @(d.GetStatusTexto())
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="d-flex justify-content-center align-items-center mt-3 gap-1">
                                <button class="btn btn-link p-1" style="width: 24px; height: 24px;"
                                        disabled="@(paginaAtual == 1)" @onclick="() => MudarPagina(paginaAtual - 1)">
                                    ‹
                                </button>

                                @foreach (var p in GetPaginasVisiveis())
                                {
                                    if (p == null)
                                    {
                                        <span class="px-2" style="font-size: 0.8rem;">...</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm @(paginaAtual == p ? "btn-primary" : "btn-outline-primary") px-2 py-0"
                                                @onclick="() => MudarPagina(p.Value)">
                                            @p
                                        </button>
                                    }
                                }

                                <button class="btn btn-link p-1" style="width: 24px; height: 24px;"
                                        disabled="@(paginaAtual == totalPaginas)" @onclick="() => MudarPagina(paginaAtual + 1)">
                                    ›
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">Nenhuma despesa encontrada.</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .linha-clicavel {
        cursor: pointer;
    }

        .linha-clicavel:hover {
            background: #f6f8ff;
        }

    .overlay-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        transition: 0.2s;
        opacity: 1;
    }

    .modal-funcionario {
        width: 95%;
        max-width: 850px;
        max-height: 92vh;
        overflow-y: auto;
        background: white;
        border-radius: 16px;
        padding: 24px;
        transform: scale(0.96);
        transition: 0.2s;
    }

    .modal-aberta {
        transform: scale(1);
    }

    .modal-topo {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-fechar {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 8px;
        background: #ef4444;
        color: white;
        font-size: 22px;
        cursor: pointer;
    }

    .abas-modal {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

        .abas-modal button {
            border: none;
            background: #e5e7eb;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    .aba-ativa {
        background: #3650a1 !important;
        color: white;
    }

    .ficha-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .ficha-titulo {
        text-align: center;
        border-bottom: 2px solid #3650a1;
        padding-bottom: 10px;
    }

    .linha {
        display: flex;
        gap: 15px;
    }

    .campo {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .campo-grande {
