</style>

@code {
    [Parameter] public Guid? FuncionarioId { get; set; }

    List<Funcionario> funcionarios = new();
    string search = "";

    IEnumerable<Funcionario> funcionariosFiltrados =>
        funcionarios.Where(f => string.IsNullOrEmpty(search) ||
        (f.Nome?.ToLower().Contains(search.ToLower()) ?? false));

    private bool mostrarModalFuncionario = false;
    private string abaAtiva = "ficha";
    private Funcionario? funcionarioSelecionado;
    private bool modoEdicao = false;
    private bool animarModal = false;

    private string Nome = "";
    private string CPF = "";
    private string Email = "";
    private string Telefone = "";
    private string ChavePix = "";
    private string Cargo = "";
    private string Departamento = "";
    private decimal SalarioBase = 0;
    private DateTime DataAdmissao = DateTime.Now;
    private int NivelAcesso = 1;
    private bool Ativo = true;
    private string msgErro = "";

    private int paginaAtual = 1;
    private int itensPorPagina = 6;
    private string pesquisaFinanceiro = "";
    private string statusFinanceiro = "";
    private string ordemValorFinanceiro = "";
    private DateTime? dataInicioFinanceiro;
    private DateTime? dataFimFinanceiro;

    private List<Despesa> DespesasFuncionario = new();

    private int totalPaginas =>
        (int)Math.Ceiling((double)DespesasFinanceirasFiltradas.Count() / itensPorPagina);

    private IEnumerable<Despesa> DespesasFinanceirasFiltradas
    {
        get
        {
            var query = DespesasFuncionario.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(pesquisaFinanceiro))
            {
                query = query.Where(d =>
                    (d.Categoria?.Contains(pesquisaFinanceiro, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (statusFinanceiro == "Pago")
            {
                query = query.Where(d => d.IsPago());
            }
            else if (statusFinanceiro == "Pendente")
            {
                query = query.Where(d => !d.IsPago());
            }

            if (dataInicioFinanceiro.HasValue)
            {
                query = query.Where(d => d.DataVencimento.Date >= dataInicioFinanceiro.Value.Date);
            }

            if (dataFimFinanceiro.HasValue)
            {
                query = query.Where(d => d.DataVencimento.Date <= dataFimFinanceiro.Value.Date);
            }

            query = ordemValorFinanceiro switch
            {
                "asc" => query.OrderBy(d => d.GetValorTotal()),
                "desc" => query.OrderByDescending(d => d.GetValorTotal()),
                _ => query.OrderBy(d => d.DataVencimento)
            };

            return query;
        }
    }

    private List<Despesa> DespesasFinanceirasPaginadas =>
        DespesasFinanceirasFiltradas
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    protected override void OnInitialized() => LoadData();

    void LoadData()
    {
        funcionarios = FuncionarioController.GetAll();

        if (FuncionarioId != null)
        {
            funcionarioSelecionado = FuncionarioController.Get(FuncionarioId.ToString(), null);
            CarregarDadosFuncionario();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && FuncionarioId != null)
        {
            var funcionario = FuncionarioController.Get(FuncionarioId.ToString(), null);
            if (funcionario != null)
            {
                await AbrirModal(funcionario);
            }
        }
    }

    private void CarregarDadosFuncionario()
    {
        if (funcionarioSelecionado == null) return;

        Nome = funcionarioSelecionado.Nome ?? "";
        CPF = Mask.FormatCpf(funcionarioSelecionado.CPF ?? "");
        Email = funcionarioSelecionado.Email ?? "";
        Telefone = funcionarioSelecionado.Telefone ?? "";
        ChavePix = funcionarioSelecionado.ChavePix ?? "";
        Cargo = funcionarioSelecionado.Cargo ?? "";
        Departamento = funcionarioSelecionado.Departamento ?? "";
        SalarioBase = funcionarioSelecionado.SalarioBase;
        DataAdmissao = funcionarioSelecionado.DataAdmissao;
        NivelAcesso = funcionarioSelecionado.AccessType?.Level ?? 1;
        Ativo = funcionarioSelecionado.Ativo;

        CarregarDespesas();
    }

    private void CarregarDespesas()
    {
        if (funcionarioSelecionado == null) return;

        DespesasFuncionario = DespesaController.GetAll()
            .Where(d => d is Salario salario && salario.Funcionario?.Id == funcionarioSelecionado.Id)
            .OrderBy(d => d.DataVencimento)
            .ToList();

        paginaAtual = 1;
    }

    private async Task AbrirModal(Funcionario funcionario)
    {
        funcionarioSelecionado = funcionario;
        abaAtiva = "ficha";
        mostrarModalFuncionario = true;
        animarModal = false;
        CarregarDadosFuncionario();

        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        animarModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharModal()
    {
        animarModal = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        mostrarModalFuncionario = false;
        funcionarioSelecionado = null;
    }

    private void HabilitarEdicao()
    {
        modoEdicao = true;
    }

    private void CancelarEdicao()
    {
        modoEdicao = false;
        CarregarDadosFuncionario();
        msgErro = "";
    }

    private async Task SalvarFuncionario()
    {
        if (funcionarioSelecionado == null) return;

        if (string.IsNullOrWhiteSpace(Nome))
        {
            msgErro = "Nome é obrigatório.";
            return;
        }

        try
        {
            bool salarioAlterado = funcionarioSelecionado.SalarioBase != SalarioBase;

            funcionarioSelecionado.Nome = Nome;
            funcionarioSelecionado.Email = Email;
            funcionarioSelecionado.Telefone = Telefone;
            funcionarioSelecionado.ChavePix = ChavePix;
            funcionarioSelecionado.Cargo = Cargo;
            funcionarioSelecionado.Departamento = Departamento;
            funcionarioSelecionado.SalarioBase = SalarioBase;
            funcionarioSelecionado.DataAdmissao = DataAdmissao;
            funcionarioSelecionado.AccessType = new AccessType { Level = NivelAcesso };
            funcionarioSelecionado.Ativo = Ativo;
            if (salarioAlterado)
            {
                var despesasPendentes = DespesaController.GetAll()
                    .Where(d => d is Salario s
                        && s.Funcionario?.Id == funcionarioSelecionado.Id
                        && !d.IsPago());

                foreach (var despesa in despesasPendentes)
                    despesa.Valor = (float)SalarioBase;
            }

            modoEdicao = false;
            LoadData();
            msgErro = "";
        }
        catch (Exception ex)
        {
            msgErro = "Erro: " + ex.Message;
        }
    }

    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++)
                paginas.Add(i);
            return paginas;
        }

        paginas.Add(1);
        if (paginaAtual > 4) paginas.Add(null);

        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);

        for (int i = inicio; i <= fim; i++)
            paginas.Add(i);

        if (paginaAtual < totalPaginas - 3) paginas.Add(null);
        paginas.Add(totalPaginas);

        return paginas;
    }

    private void MudarPagina(int p)
    {
        if (p >= 1 && p <= totalPaginas)
            paginaAtual = p;
    }

    void GoDespesa(Guid id) => Navigation.NavigateTo($"/dashboard-financeiro/despesa/{id}");
}