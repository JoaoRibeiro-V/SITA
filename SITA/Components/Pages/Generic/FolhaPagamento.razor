@page "/folha-pagamento/{AlunoId:guid?}"
@using SITA.src.Model
@using SITA.src.Storage
@using SITA.src.Controller

<div class="container mt-4" style="background-color: white; padding: 25px; border-radius: 12px; border: 2px solid #000080; max-width: 1000px; margin: auto;">
    
    <h3 style="color: #000080; font-weight: bold; text-align: center;">Gestão Financeira</h3>
    <hr />

    <!-- ================= FUNCIONÁRIO ================= -->
    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #000080;">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label><b>Selecionar Funcionário:</b></label>
            <select class="form-select" @onchange="OnFuncionarioSelected">
                <option value="">Selecione um colaborador...</option>
                @foreach (var f in funcionariosDisponiveis)
                {
                    <option value="@f.Id">@f.Nome (@f.Cargo)</option>
                }
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label><b>Mês de Referência:</b></label>
            <input type="month" class="form-control" @bind="mesReferencia" />
        </div>
    </div>

    @if (funcionarioSelecionado != null)
    {
        <div class="p-3 mt-2" style="background-color: #f8f9fa; border-radius: 8px; border: 1px dashed #000080;">
            <h5><b>Resumo do Lançamento:</b></h5>
            <p>Colaborador: <b>@funcionarioSelecionado.Nome</b></p>
            <p>Salário Base: <span class="text-success">R$ @funcionarioSelecionado.SalarioBase</span></p>

            <div class="row">
                <div class="col-md-6">
                    <label>Bônus/Extras:</label>
                    <input type="number" class="form-control" @bind="bonus" />
                </div>
                <div class="col-md-6">
                    <label>Descontos:</label>
                    <input type="number" class="form-control" @bind="descontos" />
                </div>
            </div>

            <h4 class="mt-3">Total: <b>R$ @CalcularTotal().ToString("N2")</b></h4>

            <button class="btn btn-success w-100 mt-3" @onclick="GerarPagamento">
                CONFIRMAR
            </button>
        </div>
    }
    </div>
    <hr />

    <!-- ================= ALUNO ================= -->
    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #000080;">
        <h5 style="color: #000080; font-weight: bold;">Selecionar Aluno</h5>

        <div class="position-relative">
            <input class="form-control @(alunoSelecionado != null ? "border-success" : "")"
                   value="@buscaAluno"
                   @oninput="OnAlunoInput"
                   placeholder="Nome ou RA..." />

            @if (sugestoesAlunos.Any())
            {
                <div class="list-group position-absolute w-100" style="z-index: 1000;">
                    @foreach (var a in sugestoesAlunos)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                @onclick="() => SelecionarAluno(a)">
                            <strong>@a.Nome</strong>
                            <small> - RA: @a.RA</small>
                        </button>
                    }
                </div>
            }

            @if (alunoSelecionado != null)
            {
                <div class="text-success mt-1">
                    ✔ @alunoSelecionado.Nome selecionado
                </div>
            }
        </div>
    </div>

    <!-- ================= TABELA ================= -->
    @if (alunoSelecionado != null)
    {
        <h5 style="color:#000080;"><b>Mensalidades</b></h5>

        @if (receitasAluno.Any())
        {
            <table class="table table-sm table-bordered table-striped mt-3">
                <thead style="background-color:#000080; color:white;">
                    <tr>
                        <th>Mês</th>
                        <th>Vencimento</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in receitasPaginadas)
                    {
                        <tr>
                            <td>@r.DataVencimento.ToString("MM/yyyy")</td>
                            <td>@r.DataVencimento.ToString("dd/MM/yyyy")</td>
                            <td>R$ @r.Valor.ToString("N2")</td>
                            <td>
                                <span class="badge @GetStatusBadge(r.Status)">
                                    @r.GetStatusTexto()
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-outline-primary btn-square"
                                        @onclick="() => ConfirmarPagamento(r)">
                                    ✓
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-center align-items-center mt-3 gap-1">

                <!-- Left -->
                <button class="btn btn-link p-1"
                        style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                        disabled="@(paginaAtual == 1)"
                        @onclick="() => MudarPagina(paginaAtual - 1)">
                    ‹
                </button>

                <!-- Pages -->
                @foreach (var p in GetPaginasVisiveis())
                {
                    if (p == null)
                    {
                        <span class="px-2" style="font-size: 0.8rem;">...</span>
                    }
                    else
                    {
                        <button class="btn btn-sm @(paginaAtual == p ? "btn-primary" : "btn-outline-primary") px-2 py-0"
                                style="width:32px; height:28px; font-size:0.75rem; display:flex; align-items:center; justify-content:center;"
                                @onclick="() => MudarPagina(p.Value)">
                            @p
                        </button>
                    }
                }

                <!-- Right -->
                <button class="btn btn-link p-1"
                        style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                        disabled="@(paginaAtual == totalPaginas)"
                        @onclick="() => MudarPagina(paginaAtual + 1)">
                    ›
                </button>

            </div>
        }
        else
        {
            <div class="alert alert-warning">Nenhuma mensalidade encontrada.</div>
        }
    }

    @if (!string.IsNullOrEmpty(feedbackMsg))
    {
        <div class="alert alert-info mt-3">@feedbackMsg</div>
    }
</div>

@code {
    [Parameter] public Guid? AlunoId { get; set; }

    private List<Funcionario> funcionariosDisponiveis = new();
    private List<Aluno> alunos = new();
    private List<Aluno> sugestoesAlunos = new();
    private List<Receita> receitasAluno = new();

    private string buscaAluno = "";
    private Aluno? alunoSelecionado;

    private Funcionario? funcionarioSelecionado;
    private DateTime mesReferencia = DateTime.Now;
    private decimal bonus = 0;
    private decimal descontos = 0;
    private string feedbackMsg = "";

    // PAGINAÇÃO
    private int paginaAtual = 1;
    private int itensPorPagina = 6;

    private int totalPaginas =>
        (int)Math.Ceiling((double)receitasAluno.Count / itensPorPagina);

    private List<Receita> receitasPaginadas =>
        receitasAluno
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    protected override void OnInitialized()
    {
        funcionariosDisponiveis = FuncionarioController.GetAll().OrderBy(f => f.Nome).ToList();
        alunos = AlunoController.GetAll().OrderBy(a => a.Nome).ToList();
    }

    protected override void OnParametersSet()
    {
        if (AlunoId.HasValue && alunos.Any())
        {
            var aluno = alunos.FirstOrDefault(a => a.Id == AlunoId.Value);
            if (aluno != null)
                SelecionarAluno(aluno);
        }
    }

    private void OnFuncionarioSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            funcionarioSelecionado = funcionariosDisponiveis.FirstOrDefault(f => f.Id == id);
        }
    }

    private decimal CalcularTotal()
    {
        if (funcionarioSelecionado == null) return 0;
        return funcionarioSelecionado.SalarioBase + bonus - descontos;
    }
    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++)
                paginas.Add(i);

            return paginas;
        }

        paginas.Add(1);

        if (paginaAtual > 4)
            paginas.Add(null); // "..."

        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);

        for (int i = inicio; i <= fim; i++)
            paginas.Add(i);

        if (paginaAtual < totalPaginas - 3)
            paginas.Add(null); // "..."

        paginas.Add(totalPaginas);

        return paginas;
    }

    private void GerarPagamento()
    {
        if (funcionarioSelecionado == null) return;

        var salario = new Salario
        {
            Funcionario = funcionarioSelecionado,
            MesReferencia = mesReferencia.ToString("MM/yyyy"),
            Valor = (float)CalcularTotal(),
            DataEmissao = DateTime.Now
        };

        SalarioController.Register(salario);
        feedbackMsg = "Pagamento registrado com sucesso!";
    }

    private void OnAlunoInput(ChangeEventArgs e)
    {
        buscaAluno = e.Value?.ToString() ?? "";

        sugestoesAlunos = alunos
            .Where(a => (a.Nome?.ToLower().Contains(buscaAluno.ToLower()) ?? false)
                     || (a.RA?.Contains(buscaAluno) ?? false))
            .Take(5)
            .ToList();
    }

    private void SelecionarAluno(Aluno a)
    {
        alunoSelecionado = a;
        buscaAluno = a.Nome;
        sugestoesAlunos.Clear();

        CarregarReceitas();
    }

    private void CarregarReceitas()
    {
        if (alunoSelecionado == null) return;

        receitasAluno = ReceitaController
            .GetAll()
            .Where(r => r.Aluno != null && r.Aluno.Id == alunoSelecionado.Id)
            .OrderBy(r => r.DataVencimento)
            .ToList();

        paginaAtual = 1; // RESET PAGINAÇÃO
    }

    private void MudarPagina(int p)
    {
        if (p >= 1 && p <= totalPaginas)
            paginaAtual = p;
    }
    private void ConfirmarPagamento(Receita receitaSelecionada)
    {
        if (receitaSelecionada == null)
            return;
        receitaSelecionada.Status = Receita.ReceitaStatus.Pago;

        // Recarrega tudo
        CarregarReceitas();

        // Mantém seleção atualizada (optional)
        receitaSelecionada = receitasAluno
            .FirstOrDefault(r => r.Id == receitaSelecionada.Id);
    }

    private string GetStatusBadge(Receita.ReceitaStatus status) => status switch
    {
        Receita.ReceitaStatus.Pago => "bg-success",
        Receita.ReceitaStatus.EmAtraso => "bg-danger",
        Receita.ReceitaStatus.EmAndamento => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}