@page "/folha-pagamento/aluno/{AlunoId:guid?}"
@page "/folha-pagamento/receita/{ReceitaId:guid?}"
@page "/folha-pagamento/despesas/{DespesaId:guid?}"
@using SITA.src.Model
@using SITA.src.Storage
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="container mt-4" style="background-color: white; padding: 25px; border-radius: 12px; border: 2px solid #3650a1; max-width: 1000px; margin: auto;">

    <h3 style="color: #3650a1; font-weight: bold; text-align: center;">Gestão Financeira</h3>
    <hr />
    <br />
    <h4> FUNCIONÁRIO </h4>
        <hr />
    <!-- ================= FUNCIONÁRIO ================= -->
    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #3650a1;">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label><b>Selecionar Funcionário:</b></label>
                <select class="form-select" @onchange="OnFuncionarioSelected">
                    <option value="">Selecione um colaborador...</option>
                    @foreach (var f in funcionariosDisponiveis)
                    {
                        <option value="@f.Id">@f.Nome (@f.Cargo)</option>
                    }
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label><b>Mês de Referência:</b></label>
                <input type="month" class="form-control" @bind="mesReferencia" />
            </div>
        </div>

        @if (funcionarioSelecionado != null)
        {
            <div class="p-3 mt-2" style="background-color: #f8f9fa; border-radius: 8px; border: 1px dashed #3650a1;">
                <h5><b>Resumo do Lançamento:</b></h5>
                <p>Colaborador: <b>@funcionarioSelecionado.Nome</b></p>
                <p>Salário Base: <span class="text-success">R$ @funcionarioSelecionado.SalarioBase</span></p>

                <div class="row">
                    <div class="col-md-6">
                        <label>Bônus/Extras:</label>
                        <input type="number" class="form-control" @bind="bonus" />
                    </div>
                    <div class="col-md-6">
                        <label>Descontos:</label>
                        <input type="number" class="form-control" @bind="descontos" />
                    </div>
                </div>

                <h4 class="mt-3">Total: <b>R$ @CalcularTotal().ToString("N2")</b></h4>

                <button class="btn btn-success w-100 mt-3" @onclick="GerarPagamento">
                    CONFIRMAR
                </button>
            </div>
        }
    </div>
    
    <h4> ALUNO </h4>
    <hr />
    <!-- ================= ALUNO ================= -->
    <div id="aluno-section" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #3650a1;">
        <h5 style="color: #3650a1; font-weight: bold;">Selecionar Aluno</h5>

        <div class="position-relative">
            <input class="form-control @(alunoSelecionado != null ? "border-success" : "")"
                   value="@buscaAluno"
                   @oninput="OnAlunoInput"
                   placeholder="Nome ou RA..." />

            @if (sugestoesAlunos.Any())
            {
                <div class="list-group position-absolute w-100" style="z-index: 1000;">
                    @foreach (var a in sugestoesAlunos)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                @onclick="() => SelecionarAluno(a)">
                            <strong>@a.Nome</strong>
                            <small> - RA: @a.RA</small>
                        </button>
                    }
                </div>
            }

            @if (alunoSelecionado != null)
            {
                <div class="text-success mt-1">
                    ✔ @alunoSelecionado.Nome selecionado
                </div>
            }
        </div>
    </div>

    <!-- ================= TABELA MENSALIDADES ================= -->
    @if (alunoSelecionado != null)
    {
        <h5 style="color:#3650a1;"><b>Mensalidades</b></h5>

        @if (receitasAluno.Any())
        {
            <table class="table table-sm table-bordered table-striped mt-3">
                <thead style="background-color:#3650a1; color:white;">
                    <tr>
                        <th>Mês</th>
                        <th>Vencimento</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in receitasPaginadas)
                    {
                        <tr>
                            <td>@r.DataVencimento.ToString("MM/yyyy")</td>
                            <td>@r.DataVencimento.ToString("dd/MM/yyyy")</td>
                            <td>R$ @r.Valor.ToString("N2")</td>
                            <td>
                                <span class="badge @GetStatusBadge(r.Status)">
                                    @r.GetStatusTexto()
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-outline-primary btn-square"
                                        @onclick="() => ConfirmarPagamentoReceita(r)">
                                    ✓
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-center align-items-center mt-3 gap-1">
                <button class="btn btn-link p-1"
                        style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                        disabled="@(paginaAtual == 1)"
                        @onclick="() => MudarPagina(paginaAtual - 1)">
                    ‹
                </button>

                @foreach (var p in GetPaginasVisiveis())
                {
                    if (p == null)
                    {
                        <span class="px-2" style="font-size: 0.8rem;">...</span>
                    }
                    else
                    {
                        <button class="btn btn-sm @(paginaAtual == p ? "btn-primary" : "btn-outline-primary") px-2 py-0"
                                style="width:32px; height:28px; font-size:0.75rem; display:flex; align-items:center; justify-content:center;"
                                @onclick="() => MudarPagina(p.Value)">
                            @p
                        </button>
                    }
                }

                <button class="btn btn-link p-1"
                        style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                        disabled="@(paginaAtual == totalPaginas)"
                        @onclick="() => MudarPagina(paginaAtual + 1)">
                    ›
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Nenhuma mensalidade encontrada.</div>
        }
    }

    <h4> RECEITAS </h4>
    <hr />

    <div id="receita-section" style="background-color: #f0fff4; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #28a745;">

        <h5 style="color: #28a745; font-weight: bold;">
            Selecionar Receita
        </h5>

        <div class="position-relative">

            <input class="form-control @(receitaSelecionadaDetalhes != null ? "border-success" : "")"
                   value="@buscaReceita"
                   @oninput="OnReceitaInput"
                   placeholder="Descrição, origem ou aluno..." />

            @if (sugestoesReceitas.Any())
            {
                <div class="list-group position-absolute w-100" style="z-index: 1000;">

                    @foreach (var r in sugestoesReceitas)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                @onclick="() => SelecionarReceitaDetalhes(r)">

                            <strong>@r.Descricao</strong>

                            <small class="text-muted">
                                - @r.Aluno?.Nome
                            </small>

                            <br />

                            <small class="text-muted">
                                @r.GetTypeTexto()
                                |
                                R$ @r.Valor.ToString("N2")
                            </small>

                        </button>
                    }

                </div>
            }

            @if (receitaSelecionadaDetalhes != null)
            {
                <div class="text-success mt-1">
                    ✔ Receita selecionada
                </div>
            }

        </div>
    </div>
    @if (receitaSelecionadaDetalhes != null)
    {
        <div style="background-color: #f0fff4; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #28a745;">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 style="color: #28a745; font-weight: bold; margin: 0;">
                    Detalhes da Receita
                </h5>

                <button style="width: 10%"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="LimparReceita">

                    Limpar

                </button>

            </div>

            <div class="row mt-3">

                <div class="col-md-6">

                    <p><strong>Descrição:</strong> @receitaSelecionadaDetalhes.Descricao</p>

                    <p><strong>Origem:</strong> @receitaSelecionadaDetalhes.Origem</p>

                    <p><strong>Tipo:</strong> @receitaSelecionadaDetalhes.GetTypeTexto()</p>

                    <p><strong>Aluno:</strong> @receitaSelecionadaDetalhes.Aluno?.Nome</p>

                </div>

                <div class="col-md-6">

                    <p>
                        <strong>Vencimento:</strong>
                        @receitaSelecionadaDetalhes.DataVencimento.ToString("dd/MM/yyyy")
                    </p>

                    <p>
                        <strong>Valor:</strong>

                        <span class="text-success fw-bold">
                            R$ @receitaSelecionadaDetalhes.Valor.ToString("N2")
                        </span>
                    </p>

                    <p>
                        <strong>Status:</strong>

                        <span class="badge @GetStatusBadge(receitaSelecionadaDetalhes.Status)">
                            @receitaSelecionadaDetalhes.GetStatusTexto()
                        </span>
                    </p>

                    <p>
                        <strong>Responsável:</strong>
                        @receitaSelecionadaDetalhes.Responsavel?.Nome
                    </p>

                </div>

            </div>

            @if (receitaSelecionadaDetalhes.Status != Receita.ReceitaStatus.Pago)
            {
                <button class="btn btn-success w-100 mt-3"
                        @onclick="() => ConfirmarPagamentoReceita(receitaSelecionadaDetalhes)">
                    CONFIRMAR RECEBIMENTO
                </button>
            }
            else
            {
                <div class="alert alert-success mt-3 mb-0">
                    Receita já recebida.
                </div>
            }

        </div>
    }

    <h4> DESPESAS </h4>
    <hr />

    <div id="despesa-section" style="background-color: #fff5f5; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #d9534f;">
        <h5 style="color: #d9534f; font-weight: bold;">Selecionar Despesa</h5>

        <div class="position-relative">
            <input class="form-control @(despesaSelecionada != null ? "border-success" : "")"
                   value="@buscaDespesa"
                   @oninput="OnDespesaInput"
                   placeholder="Descrição, fornecedor ou categoria..." />

            @if (sugestoesDespesas.Any())
            {
                <div class="list-group position-absolute w-100" style="z-index: 1000;">
                    @foreach (var d in sugestoesDespesas)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                @onclick="() => SelecionarDespesa(d)">
                            <strong>@d.Descricao</strong>
                            <small class="text-muted"> - @d.Fornecedor</small>
                            <br />
                            <small class="text-muted">@d.Categoria | R$ @d.Valor.ToString("N2")</small>
                        </button>
                    }
                </div>
            }

            @if (despesaSelecionada != null)
            {
                <div class="text-success mt-1">
                    ✔ @despesaSelecionada.Descricao selecionada
                </div>
            }
        </div>
    </div>

    <!-- ================= DETALHES DA DESPESA ================= -->
    @if (despesaSelecionada != null)
    {
        <div style="background-color: #fff5f5; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #d9534f;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="color: #d9534f; font-weight: bold; margin: 0;">Detalhes da Despesa</h5>
                <button style="width: 10%" class="btn btn-sm btn-outline-secondary" @onclick="LimparDespesa">
                    Limpar
                </button>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <p><strong>Descrição:</strong> @despesaSelecionada.Descricao</p>
                    <p><strong>Fornecedor:</strong> @despesaSelecionada.Fornecedor</p>
                    <p><strong>Categoria:</strong> @despesaSelecionada.Categoria</p>
                    @if (!string.IsNullOrEmpty(despesaSelecionada.NumeroNotaFiscal))
                    {
                        <p><strong>Nota Fiscal:</strong> @despesaSelecionada.NumeroNotaFiscal</p>
                    }
                    @if (!string.IsNullOrEmpty(despesaSelecionada.CnpjFornecedor))
                    {
                        <p><strong>CNPJ Fornecedor:</strong> @despesaSelecionada.CnpjFornecedor</p>
                    }
                </div>
                <div class="col-md-6">
                    <p><strong>Vencimento:</strong> @despesaSelecionada.DataVencimento.ToString("dd/MM/yyyy")</p>
                    <p><strong>Valor:</strong> <span class="text-danger fw-bold">R$ @despesaSelecionada.Valor.ToString("N2")</span></p>
                    <p>
                        <strong>Status:</strong>
                        <span class="badge @(despesaSelecionada.IsPago ? "bg-success" : "bg-warning text-dark")">
                            @(despesaSelecionada.IsPago ? "Pago" : "Pendente")
                        </span>
                    </p>
                    @if (!string.IsNullOrEmpty(despesaSelecionada.QuemPagou))
                    {
                        <p><strong>Pago por:</strong> @despesaSelecionada.QuemPagou</p>
                    }
                    <p><strong>Usuário de emissão:</strong> @despesaSelecionada.UsuarioCriacao?.Nome</p>
                </div>
            </div>

            @if (!despesaSelecionada.IsPago)
            {
                <button class="btn btn-success w-100 mt-3" @onclick="ConfirmarPagamentoDespesa">
                    CONFIRMAR PAGAMENTO
                </button>
            }
            else
            {
                <div class="alert alert-success mt-3 mb-0">
                    <i class="oi oi-check"></i> Despesa já paga em @despesaSelecionada.DataPagamento.ToString("dd/MM/yyyy")
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(feedbackMsg))
    {
        <div class="alert alert-info mt-3">@feedbackMsg</div>
    }
</div>

@code {
    [Parameter] public Guid? AlunoId { get; set; }
    [Parameter] public Guid? ReceitaId { get; set; }
    [Parameter] public Guid? DespesaId { get; set; }

    private Receita? receitaSelecionadaDetalhes;
    private List<Receita> todasReceitas = new();
    private List<Receita> sugestoesReceitas = new();

    private string buscaReceita = "";

    private List<Funcionario> funcionariosDisponiveis = new();
    private List<Aluno> alunos = new();
    private List<Aluno> sugestoesAlunos = new();
    private List<Receita> receitasAluno = new();

    private List<Despesa> todasDespesas = new();
    private List<Despesa> sugestoesDespesas = new();

    private string buscaAluno = "";
    private string buscaDespesa = "";
    private Aluno? alunoSelecionado;

    private Funcionario? funcionarioSelecionado;
    private DateTime mesReferencia = DateTime.Now;
    private decimal bonus = 0;
    private decimal descontos = 0;
    private string feedbackMsg = "";

    private Despesa? despesaSelecionada;

    private int paginaAtual = 1;
    private int itensPorPagina = 6;

    private int totalPaginas =>
        (int)Math.Ceiling((double)receitasAluno.Count / itensPorPagina);

    private List<Receita> receitasPaginadas =>
        receitasAluno
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    protected override void OnInitialized()
    {
        funcionariosDisponiveis = FuncionarioController.GetAll().OrderBy(f => f.Nome).ToList();
        alunos = AlunoController.GetAll().OrderBy(a => a.Nome).ToList();
        todasDespesas = DespesaController.GetAll().OrderBy(d => d.DataVencimento).ToList();
        todasReceitas = ReceitaController.GetAll().OrderBy(r => r.DataVencimento).ToList();
    }

    protected override void OnParametersSet()
    {
        if (AlunoId.HasValue)
        {
            var aluno = alunos.FirstOrDefault(a => a.Id == AlunoId.Value);

            if (aluno != null)
            {
                SelecionarAluno(aluno);
                return;
            }
        }
        if (DespesaId.HasValue)
        {
            var despesa = DespesaController.Get("Id", DespesaId.Value.ToString());
            if (despesa != null)
            {
                SelecionarDespesa(despesa);
                return;
            }
        }

        if (ReceitaId.HasValue)
        {
            var receita = ReceitaController.Get("Id", ReceitaId.Value.ToString());

            if (receita != null)
            {
                SelecionarReceitaDetalhes(receita);
            }
        }
    }

    private void OnReceitaInput(ChangeEventArgs e)
    {
        buscaReceita = e.Value?.ToString() ?? "";

        sugestoesReceitas = todasReceitas
            .Where(r =>
                (r.Descricao?.ToLower().Contains(buscaReceita.ToLower()) ?? false)
                || (r.Origem?.ToLower().Contains(buscaReceita.ToLower()) ?? false)
                || (r.Aluno?.Nome?.ToLower().Contains(buscaReceita.ToLower()) ?? false))
            .Take(5)
            .ToList();
    }

    private void SelecionarReceitaDetalhes(Receita receita)
    {
        receitaSelecionadaDetalhes = receita;

        buscaReceita = receita.Descricao ?? "";

        sugestoesReceitas.Clear();
    }

    private void LimparReceita()
    {
        receitaSelecionadaDetalhes = null;

        buscaReceita = "";

        sugestoesReceitas.Clear();
    }

    private void OnFuncionarioSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            funcionarioSelecionado = funcionariosDisponiveis.FirstOrDefault(f => f.Id == id);
        }
    }

    private decimal CalcularTotal()
    {
        if (funcionarioSelecionado == null) return 0;
        return funcionarioSelecionado.SalarioBase + bonus - descontos;
    }

    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++)
                paginas.Add(i);

            return paginas;
        }

        paginas.Add(1);

        if (paginaAtual > 4)
            paginas.Add(null);

        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);

        for (int i = inicio; i <= fim; i++)
            paginas.Add(i);

        if (paginaAtual < totalPaginas - 3)
            paginas.Add(null);

        paginas.Add(totalPaginas);

        return paginas;
    }

    private void GerarPagamento()
    {
        if (funcionarioSelecionado == null) return;

        var salario = new Salario
        {
            Funcionario = funcionarioSelecionado,
            MesReferencia = mesReferencia.ToString("MM/yyyy"),
            Valor = (float)CalcularTotal(),
            DataEmissao = DateTime.Now
        };

        SalarioController.Register(salario);
        feedbackMsg = "Pagamento registrado com sucesso!";
    }

    private void OnAlunoInput(ChangeEventArgs e)
    {
        buscaAluno = e.Value?.ToString() ?? "";

        sugestoesAlunos = alunos
            .Where(a => (a.Nome?.ToLower().Contains(buscaAluno.ToLower()) ?? false)
                     || (a.RA?.Contains(buscaAluno) ?? false))
            .Take(5)
            .ToList();
    }

    private void SelecionarAluno(Aluno a)
    {
        alunoSelecionado = a;
        buscaAluno = a.Nome;
        sugestoesAlunos.Clear();

        CarregarReceitas();
    }

    private void CarregarReceitas()
    {
        if (alunoSelecionado == null) return;

        receitasAluno = ReceitaController
            .GetAll()
            .Where(r => r.Aluno != null && r.Aluno.Id == alunoSelecionado.Id)
            .OrderBy(r => r.DataVencimento)
            .ToList();

        paginaAtual = 1;
    }

    private void MudarPagina(int p)
    {
        if (p >= 1 && p <= totalPaginas)
            paginaAtual = p;
    }

    private void ConfirmarPagamentoReceita(Receita receita)
    {
        if (receita == null) return;

        receita.Status = Receita.ReceitaStatus.Pago;

        CarregarReceitas();
        feedbackMsg = "Receita confirmada como paga!";
    }

    private void OnDespesaInput(ChangeEventArgs e)
    {
        buscaDespesa = e.Value?.ToString() ?? "";

        sugestoesDespesas = todasDespesas
            .Where(d => (d.Descricao?.ToLower().Contains(buscaDespesa.ToLower()) ?? false)
                     || (d.Fornecedor?.ToLower().Contains(buscaDespesa.ToLower()) ?? false)
                     || (d.Categoria?.ToLower().Contains(buscaDespesa.ToLower()) ?? false))
            .Take(5)
            .ToList();
    }

    private void SelecionarDespesa(Despesa d)
    {
        despesaSelecionada = d;
        buscaDespesa = d.Descricao ?? "";
        sugestoesDespesas.Clear();
    }

    private void LimparDespesa()
    {
        despesaSelecionada = null;
        buscaDespesa = "";
        sugestoesDespesas.Clear();
    }

    private void ConfirmarPagamentoDespesa()
    {
        if (despesaSelecionada == null) return;

        despesaSelecionada.Status = true;
        despesaSelecionada.DataPagamento = DateTime.Now;

        feedbackMsg = "Despesa confirmada como paga!";
        StateHasChanged();
    }

    private string GetStatusBadge(Receita.ReceitaStatus status) => status switch
    {
        Receita.ReceitaStatus.Pago => "bg-success",
        Receita.ReceitaStatus.EmAtraso => "bg-danger",
        Receita.ReceitaStatus.EmAndamento => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}