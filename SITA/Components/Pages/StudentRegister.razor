@page "/cadastro-aluno"
@namespace SITA.Maui.Components
@using SITA.src.Model
@using SITA.src.Util
@using SITA.Maui
@inject NavigationManager Navigation

<div style="background-color: white; padding: 20px; border-radius: 10px; border: 2px solid #000080; max-width: 800px; margin: auto;">
    <h2 style="color: #000080; text-align: center;">Ficha de Matrícula / Inscrição</h2>
    <hr />

    <div class="form-group">
        <label><b>Nome Completo do Aluno:</b></label>
        <input class="form-control" @bind="novoAluno.Nome" placeholder="Nome do aluno" />

        <label class="mt-2"><b>CPF do Responsável Financeiro (Já cadastrado):</b></label>
        <input class="form-control" @bind="novoAluno.ResponsavelCPF" placeholder="000.000.000-00" />
    </div>

    <h4 style="color: #000080; margin-top: 20px;">Dados de Saúde</h4>
    <div style="background-color: #f0f8ff; padding: 15px; border-radius: 5px; border: 1px solid #d1e9ff;">
        <label><b>Alergias (Enter para adicionar):</b></label>
        <input class="form-control" @bind="addAlergia" @onkeyup="HandleAlergiaKeyUp" />
        <div class="mt-2">
            @foreach (var alg in novoAluno.Alergias)
            {
                <span class="badge bg-danger me-1">@alg</span>
            }
        </div>

        <label class="mt-2"><b>Condições Especiais:</b></label>
        <input class="form-control" @bind="addCondicao" @onkeyup="HandleCondicoesKeyUp" />
        <div class="mt-2">
            @foreach (var cond in novoAluno.CondicoesEspeciais)
            {
                <span class="badge bg-warning text-dark me-1">@cond</span>
            }
        </div>
    </div>

    <button class="btn" style="background-color: #000080; color: white; width: 100%; margin-top: 20px; font-weight: bold;" @onclick="SalvarAluno">
        FINALIZAR MATRÍCULA E GERAR FINANCEIRO
    </button>
    
    @if (exibirSucesso)
    {
        <div class="alert alert-success mt-3 text-center">Matrícula e Carnê gerados com sucesso!</div>
    }
    @if (!string.IsNullOrEmpty(msgErro))
    {
        <div class="alert alert-danger mt-3">@msgErro</div>
    }
</div>

@code {
    private Aluno novoAluno = new Aluno();
    private string addAlergia = "";
    private string addCondicao = "";
    private string msgErro = "";
    private bool exibirSucesso = false;

    private async Task SalvarAluno()
    {
        if (string.IsNullOrWhiteSpace(novoAluno.Nome) || string.IsNullOrWhiteSpace(novoAluno.ResponsavelCPF))
        {
            msgErro = "Nome do aluno e CPF do responsável são obrigatórios.";
            return;
        }

        try
        {
            // 1. Vincular ao Responsável antes de salvar
            var respStorage = MauiProgram.AppStorage.GetStorage<Responsavel>();
            var responsavel = respStorage.GetData(novoAluno.ResponsavelCPF);

            if (responsavel == null)
            {
                msgErro = "Responsável não encontrado! Cadastre o responsável primeiro.";
                return;
            }

            // 2. Salvar Aluno
            var alunoStorage = MauiProgram.AppStorage.GetStorage<Aluno>();
            alunoStorage.AddData(novoAluno.Id.ToString(), novoAluno);

            // 3. Atualizar Responsável com o vínculo do novo Aluno
            responsavel.AddParentesco(novoAluno, 6); // 6 = Outro/Responsável
            respStorage.AddData(responsavel.CPF, responsavel);

            // 4. Gerar Carnê de Mensalidades (12 parcelas de R$ 850,00 como exemplo)
            GerarCarne(novoAluno);

            exibirSucesso = true;
            msgErro = "";
            novoAluno = new Aluno();
            StateHasChanged();
            await Task.Delay(3000);
            exibirSucesso = false;
        }
        catch (Exception ex) { msgErro = $"Erro: {ex.Message}"; }
    }

    private void GerarCarne(Aluno aluno)
    {
        var storageReceita = MauiProgram.AppStorage.GetStorage<Receita>();
        DateTime vencimento = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 10).AddMonths(1);

        for (int i = 1; i <= 12; i++)
        {
            var parcela = new Receita
            {
                AlunoId = aluno.Id,
                ResponsavelCPF = aluno.ResponsavelCPF,
                Valor = 850.00f,
                Descricao = $"Mensalidade {i}/12 - {aluno.Nome}",
                DataVencimento = vencimento.AddMonths(i - 1),
                Status = 0,
                Origem = "Mensalidade"
            };
            storageReceita.AddData(parcela.Id.ToString(), parcela);
        }
    }

    private void HandleAlergiaKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAlergia)) { novoAluno.Alergias.Add(addAlergia); addAlergia = ""; } }
    private void HandleCondicoesKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addCondicao)) { novoAluno.CondicoesEspeciais.Add(addCondicao); addCondicao = ""; } }
}