    private string addAlergia = "";
    private string addCondicao = "";
    private string msgErro = "";
    private bool exibirSucesso = false;

    private async Task SalvarAluno()
    {
        if (string.IsNullOrWhiteSpace(novoAluno.Nome) || string.IsNullOrWhiteSpace(novoAluno.ResponsavelCPF))
        {
            msgErro = "Nome do aluno e CPF do responsável são obrigatórios.";
            return;
        }

        try
        {
            // 1. Vincular ao Responsável antes de salvar
            var respStorage = MauiProgram.AppStorage.GetStorage<Responsavel>();
            var responsavel = respStorage.GetData(novoAluno.ResponsavelCPF);

            if (responsavel == null)
            {
                msgErro = "Responsável não encontrado! Cadastre o responsável primeiro.";
                return;
            }

            // 2. Salvar Aluno
            var alunoStorage = MauiProgram.AppStorage.GetStorage<Aluno>();
            alunoStorage.AddData(novoAluno.Id.ToString(), novoAluno);

            // 3. Atualizar Responsável com o vínculo do novo Aluno
            responsavel.AddParentesco(novoAluno, 6); // 6 = Outro/Responsável
            respStorage.AddData(responsavel.CPF, responsavel);

            // 4. Gerar Carnê de Mensalidades (12 parcelas de R$ 850,00 como exemplo)
            GerarCarne(novoAluno);

            exibirSucesso = true;
            msgErro = "";
            novoAluno = new Aluno();
            StateHasChanged();
            await Task.Delay(3000);
            exibirSucesso = false;
        }
        catch (Exception ex) { msgErro = $"Erro: {ex.Message}"; }
    }

    private void GerarCarne(Aluno aluno)
    {
        var storageReceita = MauiProgram.AppStorage.GetStorage<Receita>();
        DateTime vencimento = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 10).AddMonths(1);

        for (int i = 1; i <= 12; i++)
        {
            var parcela = new Receita
            {
                AlunoId = aluno.Id,
                ResponsavelCPF = aluno.ResponsavelCPF,
                Valor = 850.00f,
                Descricao = $"Mensalidade {i}/12 - {aluno.Nome}",
                DataVencimento = vencimento.AddMonths(i - 1),
                Status = 0,
                Origem = "Mensalidade"
            };
            storageReceita.AddData(parcela.Id.ToString(), parcela);
        }
    }

    private void HandleAlergiaKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAlergia)) { novoAluno.Alergias.Add(addAlergia); addAlergia = ""; } }
