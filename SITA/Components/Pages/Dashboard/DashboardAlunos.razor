@page "/alunos/{AlunoId:guid?}"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Controller
@using SITA.src.Services
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JS

<!--  HEADER  -->
<div class="header" style="display:flex; justify-content:space-between; align-items:center; padding:20px;">
    <h1 style="color:#3650a1; font-weight:bold;">Alunos Matriculados</h1>
    <div style="display:flex; gap:10px;">
        <button class="btn-cadastrar" @onclick='() => Navigation.NavigateTo("/cadastro-aluno")'
                style="background-color:#3650a1; color:white; border:none; padding:10px 20px; border-radius:5px; font-weight:bold;">
            + Nova Matrícula
        </button>
        <input @bind="search" @bind:event="oninput" placeholder="Pesquisar aluno..."
               style="padding:8px; border-radius:5px; border:1px solid #ccc;" />
    </div>
</div>

<!--  TABELA  -->
<section style="padding:20px; width:100%">
    <table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif;">
        <thead>
            <tr style="color:white;">
                <th style="padding:15px 12px; text-align:left; background:#3650a1; border-top-left-radius:8px;">Nome</th>
                <th style="padding:15px 12px; text-align:left; background:#3650a1;">RA</th>
                <th style="padding:15px 12px; text-align:left; background:#3650a1;">Idade</th>
                <th style="padding:15px 12px; text-align:left; background:#3650a1;">Turma</th>
                <th style="padding:15px 12px; text-align:left; background:#3650a1;">Responsável</th>
                <th style="padding:15px 12px; text-align:left; background:#3650a1; border-top-right-radius:8px;">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var aluno in alunosFiltrados)
            {
                <tr @onclick="() => AbrirModal(aluno)" style="cursor:pointer; background:transparent;">
                    <td style="padding:15px 12px; border-bottom:2px solid #3650a1;">@aluno.Nome</td>
                    <td style="padding:15px 12px; border-bottom:2px solid #3650a1;">@aluno.RA</td>
                    <td style="padding:15px 12px; border-bottom:2px solid #3650a1;">@aluno.Idade anos</td>
                    <td style="padding:15px 12px; border-bottom:2px solid #3650a1;">@(aluno.Turma?.Nome ?? "Sem Turma")</td>
                    <td style="padding:15px 12px; border-bottom:2px solid #3650a1;">@GetResponsavelNome(aluno)</td>
                    <td style="padding:15px 12px; border-bottom:2px solid #3650a1;">@(aluno.Turma != null ? "Ativo" : "Pendências")</td>
                </tr>
            }
        </tbody>
    </table>
</section>

<!--  MODAL PRINCIPAL (FICHA DO ALUNO)  -->
@if (mostrarModalAluno && alunoSelecionado != null)
{
    <div class="overlay-modal">
        <div class="modal-aluno @(animarModal ? "modal-aberta" : "")">

            <div class="modal-topo">
                <h2>@alunoSelecionado.Nome</h2>
                <button class="btn-fechar" @onclick="FecharModal">×</button>
            </div>
            <br />

            <div class="abas-modal">
                <button class="@(abaAtiva == "ficha" ? "aba-ativa" : "")" @onclick='() => abaAtiva = "ficha"'>
                    Ficha de Matrícula
                </button>
                <button class="@(abaAtiva == "financeiro" ? "aba-ativa" : "")" @onclick='() => abaAtiva = "financeiro"'>
                    Financeiro
                </button>
            </div>

            <div class="conteudo-modal">

                <!-- ══ ABA FICHA ══════════════════════════════════════════════ -->
                @if (abaAtiva == "ficha")
                {
                    <div class="ficha-container">

                        <div class="ficha-titulo"><h2>FICHA DE MATRÍCULA COMPLETA</h2></div>

                        <!-- Nome / nascimento / idade -->
                        <div class="linha">
                            <div class="campo campo-grande">
                                <label>Nome Completo do Aluno:</label>
                                <input @bind="Nome" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>
                            <div class="campo campo-medio">
                                <label>Data de Nascimento:</label>
                                <input type="date" @bind="dataNascimento" @bind:after="CalcularIdade" disabled="@(!modoEdicao)" />
                            </div>
                            <div class="campo campo-medio">
                                <label class="label-cinza">Idade Calculada:</label>
                                <div class="caixa-idade">@idadeExtenso</div>
                            </div>
                        </div>

                        <!-- RA / Religião / Turma -->
                        <div class="linha">
                            <div class="campo campo-terco">
                                <label>RA:</label>
                                <input value="@RA" readonly />
                            </div>
                            <div class="campo campo-terco">
                                <label>Religião:</label>
                                <input @bind="Religiao" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>
                            <div class="campo campo-terco">
                                <label>Turma:</label>
                                @if (modoEdicao)
                                {
                                    <select @bind="turmaId">
                                        <option value="">Selecione...</option>
                                        @foreach (var t in listaTurmas)
                                        {
                                            <option value="@t.Id">@t.Nome</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input value="@(alunoSelecionado.Turma?.Nome ?? "Sem Turma")" readonly />
                                }
                            </div>
                        </div>

                        <hr />

                        <!--  RESPONSÁVEIS  -->
                        <div style="background-color:#f8f9fa; padding:20px; border-radius:8px; margin-bottom:25px; border-left:5px solid #3650a1;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 style="color:#3650a1; font-weight:bold; margin:0;">Responsáveis</h5>
                                @if (modoEdicao)
                                {
                                    <button type="button" class="btn btn-sm fw-bold"
                                            style="background-color:#3650a1; color:white; max-width: 280px;"
                                            @onclick="AdicionarResponsavelRascunho">
                                        + Adicionar Responsável
                                    </button>
                                }
                            </div>

                            @{
                                // Em modo edição usa o rascunho; em visualização usa a lista carregada
                                var listaExibida = modoEdicao ? responsaveisRascunho : responsaveisEdicao;
                            }

                            @for (int i = 0; i < listaExibida.Count; i++)
                            {
                                var idx = i;
                                var rf = listaExibida[idx];

                                <div style="border:1px solid #c8d3f0; border-radius:8px; margin-bottom:12px; overflow:hidden;">

                                    <!-- Cabeçalho -->
                                    <div style="background-color:#e8ecf8; padding:10px 15px; display:flex; justify-content:space-between; align-items:center; cursor:pointer;"
                                         @onclick="() => rf.Expandido = !rf.Expandido">
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            <span style="font-size:0.9rem; font-weight:bold; color:#3650a1;">
                                                Responsável @(idx + 1)
                                                @if (!string.IsNullOrEmpty(rf.NomeExibicao))
                                                {
                                                    <span style="font-weight:normal; color:#555;"> — @rf.NomeExibicao</span>
                                                }
                                            </span>
                                            @if (rf.Confirmado)
                                            {
                                                <span class="badge bg-success" style="font-size:0.7rem;">Confirmado</span>
                                            }
                                        </div>
                                        <div style="display:flex; gap:8px; align-items:center;">
                                            <!-- Botão VER (modo visualização) -->
                                            @if (!modoEdicao && rf.ResponsavelObj != null)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        style="padding:2px 10px; font-size:0.75rem;"
                                                        @onclick:stopPropagation
                                                        @onclick="() => AbrirModalResponsavel(rf.ResponsavelObj, rf.TipoParentesco)">
                                                    Ver
                                                </button>
                                            }
                                            <!-- Botão remover (só no rascunho, mínimo 1) -->
                                            @if (modoEdicao && responsaveisRascunho.Count > 1)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        style="padding:2px 8px; font-size:0.75rem;"
                                                        @onclick:stopPropagation
                                                        @onclick="() => RemoverResponsavelRascunho(idx)">
                                                    ✕
                                                </button>
                                            }
                                            <h6 class="fw-bold m-0"
                                                style="transition:transform 0.25s ease; transform:@(rf.Expandido ? "rotate(180deg)" : "rotate(0deg)")">
                                                ▾
                                            </h6>
                                        </div>
                                    </div>

                                    <!-- Corpo -->
                                    @if (rf.Expandido)
                                    {
                                        <div style="padding:15px;">

                                            @if (modoEdicao)
                                            {
                                                <div class="row mb-3">
                                                    <div class="col-md-6 position-relative">
                                                        <label class="fw-bold">CPF:</label>
                                                        @if (rf.EhExistente || rf.Confirmado)
                                                        {
                                                            <input class="form-control" value="@Mask.FormatCpf(rf.CpfFormatado)" readonly />
                                                        }
                                                        else
                                                        {
                                                            <input class="form-control @(rf.ResponsavelObj != null ? "border-success" : "")"
                                                                   value="@rf.CpfFormatado"
                                                                   onkeypress="onlyNumbers(event)"
                                                                   @oninput="e => OnCpfRascunhoInput(e, idx)"
                                                                   placeholder="000.000.000-00"
                                                                   maxlength="14" />
                                                            @if (rf.Sugestoes.Any())
                                                            {
                                                                <div class="list-group position-absolute w-100" style="z-index:1000; top:100%;">
                                                                    @foreach (var r in rf.Sugestoes)
                                                                    {
                                                                        <button type="button" class="list-group-item list-group-item-action"
                                                                                @onclick="() => SelecionarResponsavelRascunho(idx, r)">
                                                                            <strong>@r.Nome</strong><br />
                                                                            <small>@Mask.FormatCpf(r.CPF)</small>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="fw-bold">Grau de Parentesco:</label>
                                                        <select class="form-select" @bind="rf.TipoParentesco">
                                                            @foreach (var kv in Responsavel.TipoParentescoMap)
                                                            {
                                                                <option value="@kv.Key">@kv.Value</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="row mb-3">
                                                    <div class="col-md-9">
                                                        <label class="fw-bold">Nome Completo:</label>
                                                        <input class="form-control" @bind="rf.Nome"
                                                               disabled="@(rf.EhExistente || rf.Confirmado)" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="fw-bold">CEP:</label>
                                                        <input class="form-control" value="@rf.CEP"
                                                               onkeypress="onlyNumbers(event)"
                                                               @oninput="e => OnCEPRascunhoInput(e, idx)"
                                                               maxlength="9"
                                                               disabled="@(rf.EhExistente || rf.Confirmado)" />
                                                    </div>
                                                </div>

                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <label class="fw-bold">Telefone:</label>
                                                        <input class="form-control"
                                                               value="@rf.TelefoneFormatado"
                                                               onkeypress="onlyNumbers(event)"
                                                               @oninput="e => OnTelefoneRascunhoInput(e, idx)"
                                                               placeholder="(00) 00000-0000"
                                                               maxlength="15"
                                                               disabled="@(rf.EhExistente || rf.Confirmado)" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="fw-bold">Endereço:</label>
                                                        <input class="form-control" @bind="rf.Endereco"
                                                               disabled="@(rf.EhExistente || rf.Confirmado)" />
                                                    </div>
                                                </div>

                                                <div class="row mb-3">
                                                    <div class="col-md-9">
                                                        <label class="fw-bold">E-mail:</label>
                                                        <input class="form-control" @bind="rf.Email" type="email"
                                                               disabled="@(rf.EhExistente || rf.Confirmado)" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="fw-bold">Data de Nascimento:</label>
                                                        <input type="date" class="form-control" @bind="rf.DataNascimento"
                                                               disabled="@(rf.EhExistente || rf.Confirmado)" />
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(rf.ErroCampo))
                                                {
                                                    <div class="alert alert-danger py-2">@rf.ErroCampo</div>
                                                }

                                                @if (!rf.EhExistente && !rf.Confirmado)
                                                {
                                                    <button type="button" class="btn fw-bold"
                                                            style="background-color:#3650a1; color:white;"
                                                            @onclick="() => ConfirmarResponsavelRascunho(idx)">
                                                        Confirmar Responsável
                                                    </button>
                                                }
                                                else if (!rf.EhExistente && rf.Confirmado)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                                            @onclick="() => rf.Confirmado = false">
                                                        Editar
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <!-- Visualização resumida -->
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <small class="text-muted">CPF</small>
                                                        <p class="mb-1">@Mask.FormatCpf(rf.CpfFormatado)</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <small class="text-muted">Parentesco</small>
                                                        <p class="mb-1">@(Responsavel.TipoParentescoMap.TryGetValue(rf.TipoParentesco, out var grau) ? grau : "—")</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <small class="text-muted">Telefone</small>
                                                        <p class="mb-1">@Mask.FormatPhone(rf.TelefoneFormatado)</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <small class="text-muted">E-mail</small>
                                                        <p class="mb-1">@(rf.Email ?? "—")</p>
                                                    </div>
                                                </div>
                                            }

                                        </div>
                                    }

                                </div>
                            }
                        </div>

                        <!--  CONTATOS DE EMERGÊNCIA  -->
                        <div style="background-color:#ffffff; padding:20px; border-radius:8px; margin-bottom:25px; border-left:5px solid #f0a500;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 style="color:#9a6500; font-weight:bold; margin:0;">Contatos de Emergência</h5>
                                @if (modoEdicao)
                                {
                                    <button type="button" class="btn btn-sm fw-bold"
                                            style="background-color:#f0a500; color:white; max-width: 280px;"
                                            @onclick="AdicionarContatoRascunho">
                                        + Adicionar Contato
                                    </button>
                                }
                            </div>

                            @if (modoEdicao)
                            {
                                @if (!contatosRascunho.Any())
                                {
                                    <p class="text-muted fst-italic">Nenhum contato de emergência adicionado.</p>
                                }

                                @for (int i = 0; i < contatosRascunho.Count; i++)
                                {
                                    var idx = i;
                                    var c = contatosRascunho[idx];

                                    <div style="border:1px solid #ffe0a0; border-radius:8px; margin-bottom:12px; overflow:hidden;">
                                        <div style="background-color:#fff4da; padding:10px 15px; display:flex; justify-content:space-between; align-items:center; cursor:pointer;"
                                             @onclick="() => c.Expandido = !c.Expandido">
                                            <span style="font-size:0.9rem; font-weight:bold; color:#9a6500;">
                                                Contato @(idx + 1)
                                                @if (!string.IsNullOrWhiteSpace(c.Nome))
                                                {
                                                    <span style="font-weight:normal; color:#555;"> — @c.Nome</span>
                                                }
                                            </span>
                                            <div style="display:flex; gap:8px; align-items:center;">
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        style="padding:2px 8px; font-size:0.75rem;"
                                                        @onclick:stopPropagation
                                                        @onclick="() => RemoverContatoRascunho(idx)">
                                                    ✕
                                                </button>
                                                <h6 class="fw-bold m-0"
                                                    style="transition:transform 0.25s ease; transform:@(c.Expandido ? "rotate(180deg)" : "rotate(0deg)")">
                                                    ▾
                                                </h6>
                                            </div>
                                        </div>
                                        @if (c.Expandido)
                                        {
                                            <div style="padding:15px;">
                                                <div class="row">
                                                    <div class="col-md-5">
                                                        <label class="fw-bold" style="font-size:0.85rem;">Nome:</label>
                                                        <input class="form-control form-control-sm" @bind="c.Nome" placeholder="Nome completo" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="fw-bold" style="font-size:0.85rem;">Telefone:</label>
                                                        <input class="form-control form-control-sm"
                                                               value="@telefonesRascunho[idx]"
                                                               onkeypress="onlyNumbers(event)"
                                                               @oninput="e => OnTelefoneContatoRascunhoInput(e, idx)"
                                                               placeholder="(00) 00000-0000"
                                                               maxlength="15" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="fw-bold" style="font-size:0.85rem;">Parentesco:</label>
                                                        <select class="form-select form-select-sm" @bind="c.GrauParentesco">
                                                            <option value="">Selecione</option>
                                                            <option value="Mãe">Mãe</option>
                                                            <option value="Pai">Pai</option>
                                                            <option value="Avó">Avó</option>
                                                            <option value="Avô">Avô</option>
                                                            <option value="Tia">Tia</option>
                                                            <option value="Tio">Tio</option>
                                                            <option value="Irmão(ã)">Irmão(ã)</option>
                                                            <option value="Outro">Outro</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                @if (alunoSelecionado.ContatosEmergencia.Any())
                                {
                                    <table class="table table-sm table-bordered mt-2">
                                        <thead style="background-color:#f0a500; color:white;">
                                            <tr><th>Nome</th><th>Parentesco</th><th>Telefone</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in alunoSelecionado.ContatosEmergencia)
                                            {
                                                <tr>
                                                    <td>@c.Nome</td>
                                                    <td>@c.GrauParentesco</td>
                                                    <td>@Mask.FormatPhone(c.Telefone)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p class="text-muted fst-italic">Nenhum contato de emergência cadastrado.</p>
                                }
                            }
                        </div>

                        <hr />

                        <!--  SAÚDE  -->
                        <div class="bloco saude">
                            <h3>Saúde e Emergência</h3>
                            <div class="linha">
                                <div class="campo metade">
                                    <label>Pediatra do Aluno:</label>
                                    <input @bind="Pediatra" @bind:event="oninput" disabled="@(!modoEdicao)" />
                                </div>
                                <div class="campo metade">
                                    <label>Orientações de Emergência:</label>
                                    <textarea @bind="Orientacoes" @bind:event="oninput" disabled="@(!modoEdicao)">@Orientacoes</textarea>
                                </div>
                            </div>
                            <div class="linha">
                                <div class="campo metade">
                                    <label>Alergias @(modoEdicao ? "(Enter para adicionar)" : ""):</label>
                                    @if (modoEdicao)
                                    {
                                        <input @bind="addAlergia" @onkeyup="HandleAlergiaKeyUp" placeholder="Digite e pressione Enter" />
                                    }
                                    <div class="lista-tags">
                                        @if (Alergias.Any())
                                        {
                                            @foreach (var a in Alergias)
                                            {
                                                <span class="tag alergia">@a</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma alergia informada.</span>
                                        }
                                    </div>
                                </div>
                                <div class="campo metade">
                                    <label>Condições Especiais @(modoEdicao ? "(Enter para adicionar)" : ""):</label>
                                    @if (modoEdicao)
                                    {
                                        <input @bind="addCondicao" @onkeyup="HandleCondicoesKeyUp" placeholder="Digite e pressione Enter" />
                                    }
                                    <div class="lista-tags">
                                        @if (CondicoesEspeciais.Any())
                                        {
                                            @foreach (var c in CondicoesEspeciais)
                                            {
                                                <span class="tag condicao">@c</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma condição informada.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(msgErro))
                        {
                            <div class="alert alert-danger mt-3">@msgErro</div>
                        }

                        <!-- Botões -->
                        <div class="d-flex gap-3 mt-4">
                            @if (modoEdicao)
                            {
                                <button class="btn btn-outline-secondary w-25 p-3 fw-bold" @onclick="CancelarEdicao">CANCELAR</button>
                                <button class="btn w-75 p-3 fw-bold" style="background-color:#3650a1; color:white;" @onclick="SalvarAluno">SALVAR</button>
                            }
                            else
                            {
                                <button class="btn w-100 p-3 fw-bold" style="background-color:#3650a1; color:white;" @onclick="HabilitarEdicao">EDITAR</button>
                                <button class="btn w-100 p-3 fw-bold" style="background-color:#3650a1; color:white;" @onclick="GerarPdfFicha">GERAR PDF</button>
                            }
                        </div>

                    </div>
                }

                <!-- ══ ABA FINANCEIRO ═════════════════════════════════════════ -->
                @if (abaAtiva == "financeiro")
                {
                    <div class="aba-financeiro">
                        <h2>FINANCEIRO</h2>
                        @if (ReceitasAluno.Any())
                        {
                            <div class="row mb-3 g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Pesquisar</label>
                                    <input class="form-control" placeholder="Tipo..." @bind="pesquisaFinanceiro" @bind:event="oninput" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Status</label>
                                    <select class="form-select" @bind="statusFinanceiro">
                                        <option value="">Todos</option>
                                        <option value="Pago">Pago</option>
                                        <option value="EmAndamento">Em Andamento</option>
                                        <option value="EmAtraso">Em Atraso</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Data Inicial</label>
                                    <input type="date" class="form-control" @bind="dataInicioFinanceiro" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Data Final</label>
                                    <input type="date" class="form-control" @bind="dataFimFinanceiro" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Ordenar Valor</label>
                                    <select class="form-select" @bind="ordemValorFinanceiro">
                                        <option value="">Padrão</option>
                                        <option value="asc">Menor → Maior</option>
                                        <option value="desc">Maior → Menor</option>
                                    </select>
                                </div>
                            </div>
                            <table class="table table-sm table-bordered table-striped mt-3">
                                <thead style="background-color:#3650a1; color:white;">
                                    <tr><th>Mês</th><th>Tipo</th><th>Vencimento</th><th>Valor</th><th>Status</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in ReceitasFinanceirasPaginadas)
                                    {
                                        <tr @onclick="() => GoReceita(r.Id)" style="cursor:pointer;">
                                            <td>@r.DataReferente.ToString("MM/yyyy")</td>
                                            <td>@r.GetTypeTexto()</td>
                                            <td>@r.DataVencimento.ToString("dd/MM/yyyy")</td>
                                            <td>R$ @r.GetValorTotal().ToString("N2")</td>
                                            <td><span class="badge @GetStatusBadge(r.Status)">@r.GetStatusTexto()</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-center align-items-center mt-3 gap-1">
                                <button class="btn btn-link p-1" style="width:24px;height:24px;line-height:1;text-decoration:none;"
                                        disabled="@(paginaAtual == 1)" @onclick="() => MudarPagina(paginaAtual - 1)">
                                    ‹
                                </button>
                                @foreach (var p in GetPaginasVisiveis())
                                {
                                    if (p == null)
                                    {
                                        <span class="px-2" style="font-size:0.8rem;">...</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm @(paginaAtual == p ? "btn-primary" : "btn-outline-primary") px-2 py-0"
                                                style="width:32px;height:28px;font-size:0.75rem;display:flex;align-items:center;justify-content:center;"
                                                @onclick="() => MudarPagina(p.Value)">
                                            @p
                                        </button>
                                    }
                                }
                                <button class="btn btn-link p-1" style="width:24px;height:24px;line-height:1;text-decoration:none;"
                                        disabled="@(paginaAtual == totalPaginas)" @onclick="() => MudarPagina(paginaAtual + 1)">
                                    ›
                                </button>
                            </div>
                        }
                        else
                        {

                            <div class="alert alert-warning">Nenhuma mensalidade encontrada.</div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
}

<!--  MODAL RESPONSÁVEL  -->
@if (mostrarModalResponsavel && responsavelModal != null)
{
    <div class="overlay-modal" style="z-index:99999;">
