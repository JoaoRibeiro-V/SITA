                    <div>
                        <small class="text-muted">Endereço</small>
                        <p style="font-weight:bold;margin:0;">@(responsavelModal.Endereco ?? "—")</p>
                    </div>
                    <div>
                        <small class="text-muted">CEP</small>
                        <p style="font-weight:bold;margin:0;">@(responsavelModal.CEP ?? "—")</p>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                    <small class="text-muted">E-mail</small>
                    <p style="font-weight:bold;margin:0;">@(responsavelModal.Email ?? "—")</p>
                </div>
                    <div>
                        <small class="text-muted">Data de Nascimento</small>
                        <p style="font-weight:bold;margin:0;">@(responsavelModal.DataNascimento?.ToString("dd/MM/yyyy") ?? "—")</p>
                    </div>
                </div>

                
               
                
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
