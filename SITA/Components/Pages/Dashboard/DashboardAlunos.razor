@page "/alunos/{AlunoId:guid?}"
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Util
@inject NavigationManager Navigation

<div class="header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
    <h1 style="color: #3650a1; font-weight: bold;">Alunos Matriculados</h1>
    <div style="display: flex; gap: 10px;">
       
        <button class="btn-cadastrar" @onclick='() => Navigation.NavigateTo("/cadastro-aluno")'
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Nova Matrícula
        </button>

        <button class="btn-cadastrar" @onclick='() => Navigation.NavigateTo("/cadastro-responsavel")'
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Novo Responsável
        </button>

        <input @bind="search" @bind:event="oninput" placeholder="Pesquisar aluno..." style="padding: 8px; border-radius: 5px; border: 1px solid #ccc;" />
    </div>
</div>
<section style="padding: 20px; width:100%" >

    <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">

        <thead>
            <tr style="color: white;">
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-left-radius: 8px;">Nome</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">RA</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Idade</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Turma</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Responsável</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-right-radius: 8px;">Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var aluno in alunosFiltrados)
            {
                <tr @onclick="() => AbrirModalAluno(aluno)"
                    style="cursor: pointer; background: transparent;">

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.Nome
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.RA
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.Idade anos
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(aluno.Turma?.Nome ?? "Sem Turma")
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @GetResponsavelNome(aluno)
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(aluno.Turma != null ? "Ativo" : "Pendências")
                    </td>

                </tr>
            }
        </tbody>

    </table>

</section>

@if ((mostrarModalAluno && alunoSelecionado != null))
{
    <div class="overlay-modal">
        <div class="modal-aluno">

            <div class="modal-topo">
                <h2>@alunoSelecionado.Nome</h2>

                <button class="btn-fechar" @onclick="FecharModal">
                    ×
                </button>
            </div>

            <div class="abas-modal">
                <button class="@(abaAtiva == "ficha" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "ficha"'>
                    Ficha de Matrícula
                </button>

                <button class="@(abaAtiva == "financeiro" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "financeiro"'>
                    Financeiro
                </button>
            </div>

            <div class="conteudo-modal">

                @if (abaAtiva == "ficha")
                {
                    <div class="ficha-container">

                        <div class="ficha-titulo">
                            <h2>FICHA DE MATRÍCULA COMPLETA</h2>
                        </div>

                        <div class="linha">
                            <div class="campo campo-grande">
                                <label>Nome Completo do Aluno:</label>
                                <input @bind="Nome" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-medio">
                                <label>Data de Nascimento:</label>
                                <input type="date" @bind="dataNascimento" @bind:after="CalcularIdade" disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-medio">
                                <label class="label-cinza">Idade Calculada:</label>
                                <div class="caixa-idade">
                                    @idadeExtenso
                                </div>
                            </div>
                        </div>

                        <div class="linha">
                            <div class="campo campo-terco">
                                <label>RA:</label>
                                <input value="@RA" readonly />
                            </div>

                            <div class="campo campo-terco">
                                <label>Religião:</label>
                                <input @bind="Religiao" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-terco">
                                <label>Turma:</label>
                                @if (modoEdicao)
                                {
                                    <select @bind="turmaId">
                                        <option value="">Selecione...</option>
                                        @foreach (var t in listaTurmas)
                                        {
                                            <option value="@t.Id">@t.Nome</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input value="@(alunoSelecionado.Turma?.Nome ?? "Sem Turma")" readonly />
                                }
                            </div>
                        </div>

                        <div class="bloco responsavel">
                            <h3>Dados do Responsável</h3>

                            <div class="linha">
                                <div class="campo metade position-relative">
                                    <label>CPF do Responsável:</label>
                                    @if (modoEdicao)
                                    {
                                        <input value="@responsavelCpf"
                                               @oninput="OnCpfInput"
                                               placeholder="000.000.000-00"
                                               maxlength="14" />

                                        @if (sugestoesResponsaveis.Any())
                                        {
                                            <div class="list-group position-absolute w-100" style="z-index: 1000; background: white; border: 1px solid #ccc;">
                                                @foreach (var r in sugestoesResponsaveis)
                                                {
                                                    <button type="button"
                                                            class="list-group-item list-group-item-action"
                                                            @onclick="() => SelecionarResponsavel(r)">
                                                        <strong>@r.Nome</strong><br />
                                                        <small>@Mask.FormatCpf(r.CPF)</small>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <input value="@responsavelCpf" readonly />
                                        
                                    }
                                    <small>@responsavelNome</small>
                                </div>

                                <div class="campo metade">
                                    <label>Grau de Parentesco:</label>
                                    @if (modoEdicao)
                                    {
                                        <select @bind="tipoParentesco">
                                            <option value="1">Pai / Mãe</option>
                                            <option value="2">Avô / Avó</option>
                                            <option value="4">Tio / Tia</option>
                                            <option value="6">Outro Responsável</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <input value="@(GetResponsavelGrau(alunoSelecionado))" readonly />
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="bloco saude">
                            <h3>Saúde e Emergência</h3>

                            <div class="linha">
                                <div class="campo metade">
                                    <label>Pediatra do Aluno:</label>
                                    <input @bind="Pediatra" @bind:event="oninput" disabled="@(!modoEdicao)" />
                                </div>

                                <div class="campo metade">
                                    <label>Orientações de Emergência:</label>
                                    <textarea @bind="Orientacoes" @bind:event="oninput" disabled="@(!modoEdicao)">@Orientacoes</textarea>
                                </div>
                            </div>

                            <div class="linha">
                                <div class="campo metade">
                                    <label>Alergias @(modoEdicao ? "(Enter para adicionar)" : ""):</label>

                                    @if (modoEdicao)
                                    {
                                        <input @bind="addAlergia" @onkeyup="HandleAlergiaKeyUp" placeholder="Digite e pressione Enter" />
                                    }

                                    <div class="lista-tags">
                                        @if (Alergias != null && Alergias.Any())
                                        {
                                            @foreach (var alergia in Alergias)
                                            {
                                                <span class="tag alergia">@alergia</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma alergia informada.</span>
                                        }
                                    </div>
                                </div>

                                <div class="campo metade">
                                    <label>Condições Especiais @(modoEdicao ? "(Enter para adicionar)" : ""):</label>

                                    @if (modoEdicao)
                                    {
                                        <input @bind="addCondicao" @onkeyup="HandleCondicoesKeyUp" placeholder="Digite e pressione Enter" />
                                    }

                                    <div class="lista-tags">
                                        @if (CondicoesEspeciais != null && CondicoesEspeciais.Any())
                                        {
                                            @foreach (var condicao in CondicoesEspeciais)
                                            {
                                                <span class="tag condicao">@condicao</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma condição informada.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(msgErro))
                        {
                            <div class="alert alert-danger mt-3">@msgErro</div>
                        }

                        <div class="d-flex gap-3 mt-4">
                            @if (modoEdicao)
                            {
                                <button class="btn btn-outline-secondary w-25 p-3 fw-bold" @onclick="CancelarEdicao">CANCELAR</button>
                                <button class="btn w-75 p-3 fw-bold" style="background-color: #3650a1; color: white;" @onclick="SalvarAluno">
                                    SALVAR
                                </button>
                            }
                            else
                            {
                                <button class="btn w-100 p-3 fw-bold" style="background-color: #3650a1; color: white;" @onclick="HabilitarEdicao">
                                    EDITAR
                                </button>
                            }
                        </div>

                    </div>
                }

                @if (abaAtiva == "financeiro")
                {
                    <div class="aba-financeiro">
                        <h2>FINANCEIRO</h2>

                        <p>Aqui entra a tabela de mensalidades e receitas do aluno.</p>
                    </div>
                }

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? AlunoId { get; set; }

    List<Aluno> alunos = new();
    List<Responsavel> responsaveis = new();
    List<Turma> listaTurmas = new();
    List<Responsavel> sugestoesResponsaveis = new();
    string search = "";

    IEnumerable<Aluno> alunosFiltrados =>
        alunos.Where(a => string.IsNullOrEmpty(search) ||
        (a.Nome?.ToLower().Contains(search.ToLower()) ?? false));

    protected override void OnInitialized() => LoadData();

    void LoadData()
    {
        alunos = AlunoController.GetAll();
        responsaveis = ResponsavelController.GetAll();
        listaTurmas = TurmaController.GetAll();

        if(AlunoId != null)
        {
            alunoSelecionado = AlunoController.Get(AlunoId.ToString(), null);
            mostrarModalAluno = true;
            CarregarDadosAluno();
        }
        
    }

    string GetResponsavelCPF(Aluno aluno)
    {
        var resp = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.CPF ?? "-";
    }

    string GetResponsavelNome(Aluno aluno)
    {
        var resp = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.Nome ?? "-";
    }

    string GetResponsavelGrau(Aluno aluno)
    {
        var resp = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.GetAlunoParentesco(aluno).GetParentesco() ?? "-";
    }

    void GoAluno(Guid id) => Navigation.NavigateTo($"/aluno-details/{id}");

    private bool mostrarModalAluno = false;
    private string abaAtiva = "ficha";
    private Aluno? alunoSelecionado;
    private bool modoEdicao = false;

    private string Nome = "";
    private DateTime? dataNascimento;
    private string RA = "";
    private string Religiao = "";
    private string turmaId = "";
    private string responsavelCpf = "";
    private string responsavelNome = "";
    private int tipoParentesco = 6;
    private string Pediatra = "";
    private string Orientacoes = "";
    private List<string> Alergias = new();
    private List<string> CondicoesEspeciais = new();
    private string idadeExtenso = "";
    private string addAlergia = "";
    private string addCondicao = "";
    private string msgErro = "";

    private Responsavel? responsavelSelecionado;
    private Responsavel? responsavelAluno;

    private void AbrirModalAluno(Aluno aluno)
    {
        alunoSelecionado = aluno;
        abaAtiva = "ficha";
        modoEdicao = false;
        CarregarDadosAluno();
        mostrarModalAluno = true;
    }

    private void CarregarDadosAluno()
    {
        if (alunoSelecionado == null) return;

        Nome = alunoSelecionado.Nome ?? "";
        dataNascimento = alunoSelecionado.DataNascimento;
        RA = alunoSelecionado.RA ?? "";
        Religiao = alunoSelecionado.Religiao ?? "";
        turmaId = alunoSelecionado.Turma?.Id.ToString() ?? "";
        Pediatra = alunoSelecionado.NomePediatra ?? "";
        Orientacoes = alunoSelecionado.OrientacoesEmergencia ?? "";
        Alergias = new List<string>(alunoSelecionado.Alergias ?? new List<string>());
        CondicoesEspeciais = new List<string>(alunoSelecionado.CondicoesEspeciais ?? new List<string>());

        responsavelAluno = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == alunoSelecionado.Id) == true);

        if (responsavelAluno != null)
        {
            responsavelCpf = Mask.FormatCpf(responsavelAluno.CPF ?? "");
            responsavelNome = responsavelAluno.Nome;
            var parentesco = responsavelAluno.GetParentescos()?.FirstOrDefault(p => p.Aluno.Id == alunoSelecionado.Id);
            tipoParentesco = parentesco?.Tipo ?? 6;
        }

        CalcularIdade();
    }

    private void HabilitarEdicao()
    {
        modoEdicao = true;
    }

    private void CancelarEdicao()
    {
        modoEdicao = false;
        CarregarDadosAluno();
        msgErro = "";
    }

    private void FecharModal()
    {
        mostrarModalAluno = false;
        alunoSelecionado = null;
        modoEdicao = false;
        msgErro = "";
    }

    private void CalcularIdade()
    {
        DateTime data = dataNascimento ?? DateTime.Today;
        DateTime hoje = DateTime.Today;
        int anos = hoje.Year - data.Year;
        if (hoje < data.AddYears(anos)) anos--;

        int meses = hoje.Month - data.Month;
        if (hoje.Day < data.Day) meses--;
        if (meses < 0) meses += 12;

        idadeExtenso = $"{anos} anos e {meses} meses";
    }

    void OnCpfInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];

        responsavelCpf = Mask.FormatCpf(digits);

        sugestoesResponsaveis = responsaveis
            .Where(r => !string.IsNullOrEmpty(r.CPF) && r.CPF.Contains(digits))
            .Take(5)
            .ToList();

        responsavelSelecionado = null;
    }

    void SelecionarResponsavel(Responsavel r)
    {
        responsavelSelecionado = r;
        responsavelCpf = Mask.FormatCpf(r.CPF);
        responsavelNome = r.Nome;
        sugestoesResponsaveis.Clear();
    }

    private void HandleAlergiaKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAlergia))
        {
            Alergias.Add(addAlergia);
            addAlergia = "";
        }
    }

    private void HandleCondicoesKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addCondicao))
        {
            CondicoesEspeciais.Add(addCondicao);
            addCondicao = "";
        }
    }

    private async Task SalvarAluno()
    {
        if (alunoSelecionado == null) return;

        var cpfSemMascara = Mask.RemoveMask(responsavelCpf);

        if (string.IsNullOrWhiteSpace(Nome) || string.IsNullOrWhiteSpace(cpfSemMascara))
        {
            msgErro = "Nome e CPF do responsável são obrigatórios.";
            return;
        }

        try
        {
            var resp = responsavelSelecionado ?? ResponsavelController.Get("CPF", cpfSemMascara);

            if (resp == null)
            {
                msgErro = "Responsável não encontrado no sistema.";
                return;
            }

            alunoSelecionado.Nome = Nome;
            alunoSelecionado.DataNascimento = dataNascimento;
            alunoSelecionado.Religiao = Religiao;
            
            if (!string.IsNullOrEmpty(turmaId))
            {
                Turma newTurma = TurmaController.Get(turmaId, null);
                if (newTurma != null)
                {
                    // Assuming there's a method to move students between classes
                    if (alunoSelecionado.Turma != null && alunoSelecionado.Turma.Id != newTurma.Id)
                    {
                        alunoSelecionado.Turma.Alunos.Remove(alunoSelecionado);
                        newTurma.Alunos.Add(alunoSelecionado);
                    }
                    alunoSelecionado.Turma = newTurma;
                }
            }
            
            alunoSelecionado.NomePediatra = Pediatra;
            alunoSelecionado.OrientacoesEmergencia = Orientacoes;
            alunoSelecionado.Alergias = Alergias;
            alunoSelecionado.CondicoesEspeciais = CondicoesEspeciais;

            if (responsavelAluno != null)
            {
                var parentesco = responsavelAluno.GetParentescos()?.FirstOrDefault(p => p.Aluno.Id == alunoSelecionado.Id);
                if (parentesco != null)
                {
                    parentesco.Tipo = tipoParentesco;
                }
            }

            modoEdicao = false;
            LoadData();
            msgErro = "";
        }
        catch (Exception ex)
        {
            msgErro = "Erro: " + ex.Message;
        }
    }
}
