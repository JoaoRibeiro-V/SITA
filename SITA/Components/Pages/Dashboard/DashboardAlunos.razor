@page "/alunos/{AlunoId:guid?}"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Controller
@using SITA.src.Services
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
    <h1 style="color: #3650a1; font-weight: bold;">Alunos Matriculados</h1>
    <div style="display: flex; gap: 10px;">

        <button class="btn-cadastrar" @onclick='() => Navigation.NavigateTo("/cadastro-aluno")'
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Nova Matrícula
        </button>

        <button class="btn-cadastrar" @onclick='() => Navigation.NavigateTo("/cadastro-responsavel")'
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Novo Responsável
        </button>

        <input @bind="search" @bind:event="oninput" placeholder="Pesquisar aluno..." style="padding: 8px; border-radius: 5px; border: 1px solid #ccc;" />
    </div>
</div>
<section style="padding: 20px; width:100%">

    <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">

        <thead>
            <tr style="color: white;">
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-left-radius: 8px;">Nome</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">RA</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Idade</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Turma</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Responsável</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-right-radius: 8px;">Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var aluno in alunosFiltrados)
            {
                <tr @onclick="() => AbrirModal(aluno)"
                    style="cursor: pointer; background: transparent;">

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.Nome
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.RA
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.Idade anos
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(aluno.Turma?.Nome ?? "Sem Turma")
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @GetResponsavelNome(aluno)
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(aluno.Turma != null ? "Ativo" : "Pendências")
                    </td>

                </tr>
            }
        </tbody>

    </table>

</section>

@if ((mostrarModalAluno && alunoSelecionado != null))
{
    <div class="overlay-modal">
        <div class="modal-aluno  @(animarModal ? "modal-aberta" : "")">

            <div class="modal-topo">
                <h2>@alunoSelecionado.Nome</h2>

                <button class="btn-fechar" @onclick="FecharModal">
                    ×
                </button>
            </div>
            <br />

            <div class="abas-modal">
                <button class="@(abaAtiva == "ficha" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "ficha"'>
                    Ficha de Matrícula
                </button>

                <button class="@(abaAtiva == "financeiro" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "financeiro"'>
                    Financeiro
                </button>
            </div>

            <div class="conteudo-modal">

                @if (abaAtiva == "ficha")
                {
                    <div class="ficha-container">

                        <div class="ficha-titulo">
                            <h2>FICHA DE MATRÍCULA COMPLETA</h2>
                        </div>

                        <div class="linha">
                            <div class="campo campo-grande">
                                <label>Nome Completo do Aluno:</label>
                                <input @bind="Nome" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-medio">
                                <label>Data de Nascimento:</label>
                                <input type="date" @bind="dataNascimento" @bind:after="CalcularIdade" disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-medio">
                                <label class="label-cinza">Idade Calculada:</label>
                                <div class="caixa-idade">
                                    @idadeExtenso
                                </div>
                            </div>
                        </div>

                        <div class="linha">
                            <div class="campo campo-terco">
                                <label>RA:</label>
                                <input value="@RA" readonly />
                            </div>

                            <div class="campo campo-terco">
                                <label>Religião:</label>
                                <input @bind="Religiao" @bind:event="oninput" disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-terco">
                                <label>Turma:</label>
                                @if (modoEdicao)
                                {
                                    <select @bind="turmaId">
                                        <option value="">Selecione...</option>
                                        @foreach (var t in listaTurmas)
                                        {
                                            <option value="@t.Id">@t.Nome</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input value="@(alunoSelecionado.Turma?.Nome ?? "Sem Turma")" readonly />
                                }
                            </div>
                        </div>

                        <div class="bloco responsavel">
                            <h3>Dados do Responsável</h3>

                            <div class="linha">
                                <div class="campo metade position-relative">
                                    <label>CPF do Responsável:</label>
                                    @if (modoEdicao)
                                    {
                                        <input value="@responsavelCpf"
                                               @oninput="OnCpfInput"
                                               placeholder="000.000.000-00"
                                               maxlength="14" />

                                        @if (sugestoesResponsaveis.Any())
                                        {
                                            <div class="list-group position-absolute w-100" style="z-index: 1000; background: white; border: 1px solid #ccc;">
                                                @foreach (var r in sugestoesResponsaveis)
                                                {
                                                    <button type="button"
                                                            class="list-group-item list-group-item-action"
                                                            @onclick="() => SelecionarResponsavel(r)">
                                                        <strong>@r.Nome</strong><br />
                                                        <small>@Mask.FormatCpf(r.CPF)</small>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <input value="@responsavelCpf" readonly />

                                    }
                                    <small>@responsavelNome</small>
                                </div>

                                <div class="campo metade">
                                    <label>Grau de Parentesco:</label>
                                    @if (modoEdicao)
                                    {
                                        <select @bind="tipoParentesco">
                                            <option value="1">Pai / Mãe</option>
                                            <option value="2">Avô / Avó</option>
                                            <option value="4">Tio / Tia</option>
                                            <option value="6">Outro Responsável</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <input value="@(GetResponsavelGrau(alunoSelecionado))" readonly />
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Contatos de Emergência -->
                        <h5 style="color: #9a6500;">Contatos de Emergência</h5>
                        @if (modoEdicao)
                        {
                            <div style="background-color: #ffffff; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #f0a500;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 style="color: #9a6500; font-weight: bold; margin: 0;">Contatos de Emergência</h5>
                                    <button type="button" class="btn btn-sm fw-bold"
                                            style="background-color: #f0a500; color: white;"
                                            @onclick="AdicionarContatoEmergencia">
                                        + Adicionar Contato
                                    </button>
                                </div>

                                @if (!contatosEmergencia.Any())
                                {
                                    <p class="text-muted fst-italic">Nenhum contato de emergência adicionado.</p>
                                }

                                @for (int i = 0; i < contatosEmergencia.Count; i++)
                                {
                                    var idx = i;
                                    var contato = contatosEmergencia[idx];
                                    <div class="row mb-2 align-items-end p-2"
                                         style="background: white; border-radius: 6px; border: 1px solid #ffe0a0;">
                                        <div class="col-md-3">
                                            <label class="fw-bold" style="font-size: 0.85rem;">Nome:</label>
                                            <input class="form-control form-control-sm" @bind="contato.Nome" placeholder="Nome completo" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="fw-bold" style="font-size: 0.85rem;">CPF:</label>
                                            <input class="form-control form-control-sm"
                                                   value="@cpfsContatos[idx]"
                                                   @oninput="e => OnCpfContatoInput(e, idx)"
                                                   placeholder="000.000.000-00"
                                                   maxlength="14" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="fw-bold" style="font-size: 0.85rem;">Parentesco:</label>
                                            <select class="form-select form-select-sm" @bind="contato.GrauParentesco">
                                                <option value="Mãe">Mãe</option>
                                                <option value="Pai">Pai</option>
                                                <option value="Avó">Avó</option>
                                                <option value="Avô">Avô</option>
                                                <option value="Tia">Tia</option>
                                                <option value="Tio">Tio</option>
                                                <option value="Irmão(ã)">Irmão(ã)</option>
                                                <option value="Outro">Outro</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="fw-bold" style="font-size: 0.85rem;">Telefone:</label>
                                            <input class="form-control form-control-sm"
                                                   value="@telefonesContatos[idx]"
                                                   @oninput="e => OnTelefoneContatoInput(e, idx)"
                                                   placeholder="(00) 00000-0000"
                                                   maxlength="15" />
                                        </div>
                                        <div class="col-md-1 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100"
                                                    @onclick="() => RemoverContatoEmergencia(idx)">
                                                ✕
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @if (alunoSelecionado.ContatosEmergencia.Any())
                            {
                                <table class="table table-sm table-bordered mt-2">
                                    <thead style="background-color: #f0a500; color: white;">
                                        <tr>
                                            <th>Nome</th>
                                            <th>CPF</th>
                                            <th>Parentesco</th>
                                            <th>Telefone</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in alunoSelecionado.ContatosEmergencia)
                                        {
                                            <tr>
                                                <td>@c.Nome</td>
                                                <td>@Mask.FormatCpf(c.CPF)</td>
                                                <td>@c.GrauParentesco</td>
                                                <td>@Mask.FormatPhone(c.Telefone)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted fst-italic">Nenhum contato de emergência cadastrado.</p>
                            }
                        }
                        
                        

                        <hr />

                        <div class="bloco saude">
                            <h3>Saúde e Emergência</h3>

                            <div class="linha">
                                <div class="campo metade">
                                    <label>Pediatra do Aluno:</label>
                                    <input @bind="Pediatra" @bind:event="oninput" disabled="@(!modoEdicao)" />
                                </div>

                                <div class="campo metade">
                                    <label>Orientações de Emergência:</label>
                                    <textarea @bind="Orientacoes" @bind:event="oninput" disabled="@(!modoEdicao)">@Orientacoes</textarea>
                                </div>
                            </div>

                            <div class="linha">
                                <div class="campo metade">
                                    <label>Alergias @(modoEdicao ? "(Enter para adicionar)" : ""):</label>

                                    @if (modoEdicao)
                                    {
                                        <input @bind="addAlergia" @onkeyup="HandleAlergiaKeyUp" placeholder="Digite e pressione Enter" />
                                    }

                                    <div class="lista-tags">
                                        @if (Alergias != null && Alergias.Any())
                                        {
                                            @foreach (var alergia in Alergias)
                                            {
                                                <span class="tag alergia">@alergia</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma alergia informada.</span>
                                        }
                                    </div>
                                </div>

                                <div class="campo metade">
                                    <label>Condições Especiais @(modoEdicao ? "(Enter para adicionar)" : ""):</label>

                                    @if (modoEdicao)
                                    {
                                        <input @bind="addCondicao" @onkeyup="HandleCondicoesKeyUp" placeholder="Digite e pressione Enter" />
                                    }

                                    <div class="lista-tags">
                                        @if (CondicoesEspeciais != null && CondicoesEspeciais.Any())
                                        {
                                            @foreach (var condicao in CondicoesEspeciais)
                                            {
                                                <span class="tag condicao">@condicao</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma condição informada.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(msgErro))
                        {
                            <div class="alert alert-danger mt-3">@msgErro</div>
                        }

                        <div class="d-flex gap-3 mt-4">
                            @if (modoEdicao)
                            {
                                <button class="btn btn-outline-secondary w-25 p-3 fw-bold" @onclick="CancelarEdicao">CANCELAR</button>
                                <button class="btn w-75 p-3 fw-bold" style="background-color: #3650a1; color: white;" @onclick="SalvarAluno">
                                    SALVAR
                                </button>
                            }
                            else
                            {
                                <button class="btn w-100 p-3 fw-bold" style="background-color: #3650a1; color: white;" @onclick="HabilitarEdicao">
                                    EDITAR
                                </button>
                                <button class="btn w-100 p-3 fw-bold" style="background-color: #3650a1; color: white;" @onclick="GerarPdfFicha">
                                    GERAR PDF
                                </button>
                            }
                        </div>

                    </div>
                }

                @if (abaAtiva == "financeiro")
                {
                    <div class="aba-financeiro">
                        <h2>FINANCEIRO</h2>

                        @if (ReceitasAluno.Any())
                        {
                            <div class="row mb-3 g-2 align-items-end">

                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Pesquisar</label>
                                    <input class="form-control"
                                           placeholder="Tipo..."
                                           @bind="pesquisaFinanceiro"
                                           @bind:event="oninput" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Status</label>
                                    <select class="form-select" @bind="statusFinanceiro">
                                        <option value="">Todos</option>
                                        <option value="Pago">Pago</option>
                                        <option value="EmAndamento">Em Andamento</option>
                                        <option value="EmAtraso">Em Atraso</option>
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Data Inicial</label>
                                    <input type="date"
                                           class="form-control"
                                           @bind="dataInicioFinanceiro" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Data Final</label>
                                    <input type="date"
                                           class="form-control"
                                           @bind="dataFimFinanceiro" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Ordenar Valor</label>
                                    <select class="form-select" @bind="ordemValorFinanceiro">
                                        <option value="">Padrão</option>
                                        <option value="asc">Menor → Maior</option>
                                        <option value="desc">Maior → Menor</option>
                                    </select>
                                </div>

                            </div>
                            <table class="table table-sm table-bordered table-striped mt-3">
                                <thead style="background-color:#3650a1; color:white;">
                                    <tr>
                                        <th>Mês</th>
                                        <th>Tipo</th>
                                        <th>Vencimento</th>
                                        <th>Valor</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in ReceitasFinanceirasPaginadas)
                                    {
                                        <tr @onclick="() => GoReceita(r.Id)" style="cursor: pointer;">
                                            <td>@r.DataReferente.ToString("MM/yyyy")</td>
                                            <td>@r.GetTypeTexto()</td>
                                            <td>@r.DataVencimento.ToString("dd/MM/yyyy")</td>
                                            <td>R$ @r.GetValorTotal().ToString("N2")</td>
                                            <td>
                                                <span class="badge @GetStatusBadge(r.Status)">
                                                    @r.GetStatusTexto()
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="d-flex justify-content-center align-items-center mt-3 gap-1">
                                <button class="btn btn-link p-1"
                                        style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                                        disabled="@(paginaAtual == 1)"
                                        @onclick="() => MudarPagina(paginaAtual - 1)">
                                    ‹
                                </button>

                                @foreach (var p in GetPaginasVisiveis())
                                {
                                    if (p == null)
                                    {
                                        <span class="px-2" style="font-size: 0.8rem;">...</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm @(paginaAtual == p ? "btn-primary" : "btn-outline-primary") px-2 py-0"
                                                style="width:32px; height:28px; font-size:0.75rem; display:flex; align-items:center; justify-content:center;"
                                                @onclick="() => MudarPagina(p.Value)">
                                            @p
                                        </button>
                                    }
                                }

                                <button class="btn btn-link p-1"
                                        style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                                        disabled="@(paginaAtual == totalPaginas)"
                                        @onclick="() => MudarPagina(paginaAtual + 1)">
                                    ›
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">Nenhuma mensalidade encontrada.</div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? AlunoId { get; set; }

    List<Aluno> alunos = new();
    List<Responsavel> responsaveis = new();
    List<Turma> listaTurmas = new();
    List<Responsavel> sugestoesResponsaveis = new();

    private int paginaAtual = 1;
    private int itensPorPagina = 6;

    private string pesquisaFinanceiro = "";
    private string statusFinanceiro = "";
    private string ordemValorFinanceiro = "";

    private DateTime? dataInicioFinanceiro;
    private DateTime? dataFimFinanceiro;

    private int totalPaginas =>
    (int)Math.Ceiling(
        (double)ReceitasFinanceirasFiltradas.Count() / itensPorPagina);

    private List<Receita> ReceitasPaginadas =>
        ReceitasAluno
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();
    private IEnumerable<Receita> ReceitasFinanceirasFiltradas
    {
        get
        {
            var query = ReceitasAluno.AsEnumerable();

            // PESQUISA
            if (!string.IsNullOrWhiteSpace(pesquisaFinanceiro))
            {
                query = query.Where(r =>
                    r.GetTypeTexto()
                        .Contains(pesquisaFinanceiro,
                            StringComparison.OrdinalIgnoreCase));
            }

            // STATUS
            if (statusFinanceiro == "Pago")
            {
                query = query.Where(r => r.IsPago());
            }
            else if (statusFinanceiro == "EmAndamento")
            {
                query = query.Where(r =>
                    r.Status == Receita.FinanceStatus.EmAndamento);
            }
            else if (statusFinanceiro == "EmAtraso")
            {
                query = query.Where(r =>
                    r.Status == Receita.FinanceStatus.EmAtraso);
            }

            // DATA INICIAL
            if (dataInicioFinanceiro.HasValue)
            {
                query = query.Where(r =>
                    r.DataVencimento.Date >=
                    dataInicioFinanceiro.Value.Date);
            }

            // DATA FINAL
            if (dataFimFinanceiro.HasValue)
            {
                query = query.Where(r =>
                    r.DataVencimento.Date <=
                    dataFimFinanceiro.Value.Date);
            }

            // ORDENAÇÃO
            query = ordemValorFinanceiro switch
            {
                "asc" => query.OrderBy(r => r.GetValorTotal()),
                "desc" => query.OrderByDescending(r => r.GetValorTotal()),
                _ => query.OrderBy(r => r.DataVencimento)
            };

            return query;
        }
    }

    private List<Receita> ReceitasFinanceirasPaginadas =>
    ReceitasFinanceirasFiltradas
        .Skip((paginaAtual - 1) * itensPorPagina)
        .Take(itensPorPagina)
        .ToList();

    private List<Receita> ReceitasAluno = new();
    string search = "";

    IEnumerable<Aluno> alunosFiltrados =>
        alunos.Where(a => string.IsNullOrEmpty(search) ||
        (a.Nome?.ToLower().Contains(search.ToLower()) ?? false));

    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++)
                paginas.Add(i);

            return paginas;
        }

        paginas.Add(1);

        if (paginaAtual > 4)
            paginas.Add(null);

        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);

        for (int i = inicio; i <= fim; i++)
            paginas.Add(i);

        if (paginaAtual < totalPaginas - 3)
            paginas.Add(null);

        paginas.Add(totalPaginas);

        return paginas;
    }

    private void MudarPagina(int p)
    {
        if (p >= 1 && p <= totalPaginas)
            paginaAtual = p;
    }

    private void ConfirmarPagamentoReceita(Receita Receita)
    {
        if (Receita == null) return;

        Receita.Status = Receita.FinanceStatus.Pago;
        Receita.DataPagamento = DateTime.Now;

        CarregarReceitas();
    }

    private void CarregarReceitas()
    {
        if (alunoSelecionado == null) return;

        ReceitasAluno = ReceitaController
            .GetAll()
            .Where(r => r.Aluno != null && r.Aluno.Id == alunoSelecionado.Id)
            .OrderBy(r => r.DataVencimento)
            .ToList();

        paginaAtual = 1;
    }

    protected override void OnInitialized() => LoadData();

    void LoadData()
    {
        alunos = AlunoController.GetAll();
        responsaveis = ResponsavelController.GetAll();
        listaTurmas = TurmaController.GetAll();

        if (AlunoId != null)
        {
            alunoSelecionado = AlunoController.Get(AlunoId.ToString(), null);
            CarregarDadosAluno();
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AlunoId != null)
        {
            var aluno = AlunoController.Get(AlunoId.ToString(), null);

            if (aluno != null)
            {
                await AbrirModal(aluno);
            }
        }
    }

    string GetResponsavelCPF(Aluno aluno)
    {
        var resp = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.CPF ?? "-";
    }

    string GetResponsavelNome(Aluno aluno)
    {
        var resp = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.Nome ?? "-";
    }

    string GetResponsavelGrau(Aluno aluno)
    {
        var resp = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.GetAlunoParentesco(aluno).GetParentesco() ?? "-";
    }

    void GoAluno(Guid id) => Navigation.NavigateTo($"/aluno-details/{id}");

    private bool mostrarModalAluno = false;
    private string abaAtiva = "ficha";
    private Aluno? alunoSelecionado;
    private bool modoEdicao = false;

    private string Nome = "";
    private DateTime? dataNascimento;
    private string RA = "";
    private string Religiao = "";
    private string turmaId = "";
    private string responsavelCpf = "";
    private string responsavelNome = "";
    private int tipoParentesco = 6;
    private string Pediatra = "";
    private string Orientacoes = "";
    private List<string> Alergias = new();
    private List<string> CondicoesEspeciais = new();
    private string idadeExtenso = "";
    private string addAlergia = "";
    private string addCondicao = "";
    private string msgErro = "";
    private List<ContatoEmergencia> contatosEmergencia = new();
    private List<string> cpfsContatos = new();
    private List<string> telefonesContatos = new();

    private bool animarModal = false;

    private Responsavel? responsavelSelecionado;
    private Responsavel? responsavelAluno;

    private void CarregarDadosAluno()
    {
        if (alunoSelecionado == null) return;

        Nome = alunoSelecionado.Nome ?? "";
        dataNascimento = alunoSelecionado.DataNascimento;
        RA = alunoSelecionado.RA ?? "";
        Religiao = alunoSelecionado.Religiao ?? "";
        turmaId = alunoSelecionado.Turma?.Id.ToString() ?? "";
        Pediatra = alunoSelecionado.NomePediatra ?? "";
        Orientacoes = alunoSelecionado.OrientacoesEmergencia ?? "";
        Alergias = new List<string>(alunoSelecionado.Alergias ?? new List<string>());
        CondicoesEspeciais = new List<string>(alunoSelecionado.CondicoesEspeciais ?? new List<string>());

        responsavelAluno = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == alunoSelecionado.Id) == true);

        if (responsavelAluno != null)
        {
            responsavelCpf = Mask.FormatCpf(responsavelAluno.CPF ?? "");
            responsavelNome = responsavelAluno.Nome;
            var parentesco = responsavelAluno.GetParentescos()?.FirstOrDefault(p => p.Aluno.Id == alunoSelecionado.Id);
            tipoParentesco = parentesco?.Tipo ?? 6;
        }
        if (alunoSelecionado.ContatosEmergencia != null || alunoSelecionado.ContatosEmergencia.Any())
        {
            contatosEmergencia = new List<ContatoEmergencia>(alunoSelecionado.ContatosEmergencia ?? new List<ContatoEmergencia>());
            cpfsContatos = contatosEmergencia.Select(c => Mask.FormatCpf(c.CPF)).ToList();
            telefonesContatos = contatosEmergencia.Select(c => Mask.FormatPhone(c.Telefone)).ToList();
        }

        CarregarReceitas();
        CalcularIdade();
    }

    private void HabilitarEdicao()
    {
        modoEdicao = true;
    }

    private void CancelarEdicao()
    {
        modoEdicao = false;
        CarregarDadosAluno();
        msgErro = "";
    }

    private bool fechandoModal = false;

    private async Task AbrirModal(Aluno aluno)
    {
        alunoSelecionado = aluno;

        abaAtiva = "ficha";

        mostrarModalAluno = true;

        animarModal = false;

        CarregarDadosAluno();

        await InvokeAsync(StateHasChanged);

        await Task.Delay(50);

        animarModal = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharModal()
    {
        animarModal = false;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(200);

        mostrarModalAluno = false;

        alunoSelecionado = null;
    }

    private void CalcularIdade()
    {
        DateTime data = dataNascimento ?? DateTime.Today;
        DateTime hoje = DateTime.Today;
        int anos = hoje.Year - data.Year;
        if (hoje < data.AddYears(anos)) anos--;

        int meses = hoje.Month - data.Month;
        if (hoje.Day < data.Day) meses--;
        if (meses < 0) meses += 12;

        idadeExtenso = $"{anos} anos e {meses} meses";
    }
    void GoReceita(Guid id) => Navigation.NavigateTo($"/receitas/{id}");
    void OnCpfInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];

        responsavelCpf = Mask.FormatCpf(digits);

        sugestoesResponsaveis = responsaveis
            .Where(r => !string.IsNullOrEmpty(r.CPF) && r.CPF.Contains(digits))
            .Take(5)
            .ToList();

        responsavelSelecionado = null;
    }

    void SelecionarResponsavel(Responsavel r)
    {
        responsavelSelecionado = r;
        responsavelCpf = Mask.FormatCpf(r.CPF);
        responsavelNome = r.Nome;
        sugestoesResponsaveis.Clear();
    }

    private void HandleAlergiaKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAlergia))
        {
            Alergias.Add(addAlergia);
            addAlergia = "";
        }
    }

    private void HandleCondicoesKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addCondicao))
        {
            CondicoesEspeciais.Add(addCondicao);
            addCondicao = "";
        }
    }

    private async Task SalvarAluno()
    {
        if (alunoSelecionado == null) return;

        var cpfSemMascara = Mask.RemoveMask(responsavelCpf);

        if (string.IsNullOrWhiteSpace(Nome) || string.IsNullOrWhiteSpace(cpfSemMascara))
        {
            msgErro = "Nome e CPF do responsável são obrigatórios.";
            return;
        }

        try
        {
            var resp = responsavelSelecionado ?? ResponsavelController.Get("CPF", cpfSemMascara);

            if (resp == null)
            {
                msgErro = "Responsável não encontrado no sistema.";
                return;
            }

            alunoSelecionado.Nome = Nome;
            alunoSelecionado.DataNascimento = dataNascimento;
            alunoSelecionado.Religiao = Religiao;

            if (!string.IsNullOrEmpty(turmaId))
            {
                Turma newTurma = TurmaController.Get(turmaId, null);
                if (newTurma != null)
                {
                    // Assuming there's a method to move students between classes
                    if (alunoSelecionado.Turma != null && alunoSelecionado.Turma.Id != newTurma.Id)
                    {
                        alunoSelecionado.Turma.Alunos.Remove(alunoSelecionado);
                        newTurma.Alunos.Add(alunoSelecionado);
                    }
                    alunoSelecionado.Turma = newTurma;
                }
            }

            alunoSelecionado.NomePediatra = Pediatra;
            alunoSelecionado.OrientacoesEmergencia = Orientacoes;
            alunoSelecionado.Alergias = Alergias;
            alunoSelecionado.CondicoesEspeciais = CondicoesEspeciais;
            alunoSelecionado.ContatosEmergencia = contatosEmergencia;

            if (responsavelAluno != null)
            {
                var parentesco = responsavelAluno.GetParentescos()?.FirstOrDefault(p => p.Aluno.Id == alunoSelecionado.Id);
                if (parentesco != null)
                {
                    parentesco.Tipo = tipoParentesco;
                }
            }

            modoEdicao = false;
            LoadData();
            msgErro = "";
        }
        catch (Exception ex)
        {
            msgErro = "Erro: " + ex.Message;
        }
    }

    private string GetStatusBadge(Receita.FinanceStatus status) => status switch
    {
        Receita.FinanceStatus.Pago => "bg-success",
        Receita.FinanceStatus.EmAtraso => "bg-danger",
        Receita.FinanceStatus.EmAndamento => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private async Task GerarPdfFicha()
    {
        if (alunoSelecionado == null) return;

        try
        {
            byte[] pdf = PdfService.GerarFichaAluno(alunoSelecionado);
            string base64 = Convert.ToBase64String(pdf);
            string nomeArquivo = $"Ficha_{alunoSelecionado.Nome?.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd}.pdf";

            // Dispara download via JS
            await JS.InvokeVoidAsync("downloadPdf", base64, nomeArquivo);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(ex.Message);
            //msgFeedback = "Erro ao gerar PDF: " + ex.Message;
        }
    }

    void AdicionarContatoEmergencia()
    {
        contatosEmergencia.Add(new ContatoEmergencia());
        cpfsContatos.Add("");
        telefonesContatos.Add("");
    }

    void RemoverContatoEmergencia(int idx)
    {
        contatosEmergencia.RemoveAt(idx);
        cpfsContatos.RemoveAt(idx);
        telefonesContatos.RemoveAt(idx);
    }

    void OnCpfContatoInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        cpfsContatos[idx] = Mask.FormatCpf(digits);
        contatosEmergencia[idx].CPF = Mask.RemoveMask(cpfsContatos[idx]);
    }

    void OnTelefoneContatoInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        telefonesContatos[idx] = Mask.FormatPhone(digits);
        contatosEmergencia[idx].Telefone = Mask.RemoveMask(telefonesContatos[idx]);
    }
