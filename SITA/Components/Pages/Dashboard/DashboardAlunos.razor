@code {
    [Parameter] public Guid? AlunoId { get; set; }
    List<Aluno> alunos = new();
    List<Responsavel> todosResponsaveis = new();
    List<Turma> listaTurmas = new();
    string search = "";

    bool mostrarModalAluno = false;
    bool animarModal = false;
    string abaAtiva = "ficha";
    Aluno? alunoSelecionado;
    bool modoEdicao = false;

    string Nome = "", RA = "", Religiao = "", turmaId = "";
    string Pediatra = "", Orientacoes = "";
    string addAlergia = "", addCondicao = "", idadeExtenso = "", msgErro = "";
    DateTime? dataNascimento;
    List<string> Alergias = new();
    List<string> CondicoesEspeciais = new();

    private class ResponsavelCard
    {
        public string CpfFormatado { get; set; } = "";
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string CEP { get; set; } = "";
        public string TelefoneFormatado { get; set; } = "";
        public string Endereco { get; set; } = "";
        public DateTime DataNascimento { get; set; } = DateTime.Today;
        public int TipoParentesco { get; set; } = 6;
        public bool Expandido { get; set; } = true;
        public bool Confirmado { get; set; } = false;
        public bool EhExistente { get; set; } = false;
        public Responsavel? ResponsavelObj { get; set; } = null;
        public List<Responsavel> Sugestoes { get; set; } = new();
        public string ErroCampo { get; set; } = "";
        public string NomeExibicao => ResponsavelObj?.Nome ?? Nome;
    }
    List<ResponsavelCard> responsaveisEdicao = new();

    List<ResponsavelCard> responsaveisRascunho = new();

    private class ContatoCard
    {
        public string Nome { get; set; } = "";
        public string GrauParentesco { get; set; } = "";
        public string Telefone { get; set; } = "";
        public bool Expandido { get; set; } = true;
    }

    List<ContatoCard> contatosRascunho = new();
    List<string> telefonesRascunho = new();

    List<Receita> ReceitasAluno = new();
    int paginaAtual = 1, itensPorPagina = 6;
    string pesquisaFinanceiro = "", statusFinanceiro = "", ordemValorFinanceiro = "";
    DateTime? dataInicioFinanceiro, dataFimFinanceiro;
    int totalPaginas => (int)Math.Ceiling((double)ReceitasFinanceirasFiltradas.Count() / itensPorPagina);

    bool mostrarModalResponsavel = false;
    Responsavel? responsavelModal = null;
    int tipoParentescoModal = 6;

    protected override void OnInitialized() => LoadData();

    void LoadData()
    {
        alunos = AlunoController.GetAll();
        todosResponsaveis = ResponsavelController.GetAll();
        listaTurmas = TurmaController.GetAll();

        if (AlunoId != null)
        {
            alunoSelecionado = AlunoController.Get(AlunoId.ToString(), null);
            CarregarDadosAluno();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AlunoId != null)
        {
            var aluno = AlunoController.Get(AlunoId.ToString(), null);
            if (aluno != null) await AbrirModal(aluno);
        }
    }

    async Task AbrirModal(Aluno aluno)
    {
        alunoSelecionado = aluno;
        abaAtiva = "ficha";
        mostrarModalAluno = true;
        animarModal = false;
        CarregarDadosAluno();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        animarModal = true;
        await InvokeAsync(StateHasChanged);
    }

    async Task FecharModal()
    {
        animarModal = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        mostrarModalAluno = false;
        alunoSelecionado = null;
        modoEdicao = false;
    }

    // Constrói um ResponsavelCard a partir de um Responsavel + tipo de parentesco
    ResponsavelCard CardFromResponsavel(Responsavel r, int tipo) => new ResponsavelCard
    {
        ResponsavelObj = r,
        CpfFormatado = r.CPF ?? "",
        Nome = r.Nome ?? "",
        Email = r.Email ?? "",
        TelefoneFormatado = r.Telefone ?? "",
        Endereco = r.Endereco ?? "",
        CEP = r.CEP ?? "",
        DataNascimento = r.DataNascimento ?? DateTime.Today,
        TipoParentesco = tipo,
        EhExistente = true,
        Confirmado = true,
        Expandido = false
    };

    void CarregarDadosAluno()
    {
        if (alunoSelecionado == null) return;

        Nome = alunoSelecionado.Nome ?? "";
        dataNascimento = alunoSelecionado.DataNascimento;
        RA = alunoSelecionado.RA ?? "";
        Religiao = alunoSelecionado.Religiao ?? "";
        turmaId = alunoSelecionado.Turma?.Id.ToString() ?? "";
        Pediatra = alunoSelecionado.NomePediatra ?? "";
        Orientacoes = alunoSelecionado.OrientacoesEmergencia ?? "";
        Alergias = new List<string>(alunoSelecionado.Alergias ?? new());
        CondicoesEspeciais = new List<string>(alunoSelecionado.CondicoesEspeciais ?? new());

        // Monta a lista de visualização a partir dos responsáveis vinculados ao aluno
        var resps = alunoSelecionado.Responsaveis.Any()
            ? alunoSelecionado.Responsaveis
            : todosResponsaveis.Where(r => r.GetParentescos()?.Any(p => p.Aluno.Id == alunoSelecionado.Id) == true).ToList();

        responsaveisEdicao = resps.Select(r =>
        {
            var tipo = r.GetParentescos()?.FirstOrDefault(p => p.Aluno.Id == alunoSelecionado.Id)?.Tipo ?? 6;
            return CardFromResponsavel(r, tipo);
        }).ToList();

        CarregarReceitas();
        CalcularIdade();
    }

    void HabilitarEdicao()
    {
        // Cria o rascunho como cópia profunda da lista de visualização
        responsaveisRascunho = responsaveisEdicao
            .Select(rf => new ResponsavelCard
            {
                ResponsavelObj = rf.ResponsavelObj,
                CpfFormatado = rf.CpfFormatado,
                Nome = rf.Nome,
                Email = rf.Email,
                TelefoneFormatado = rf.TelefoneFormatado,
                Endereco = rf.Endereco,
                CEP = rf.CEP,
                DataNascimento = rf.DataNascimento,
                TipoParentesco = rf.TipoParentesco,
                EhExistente = rf.EhExistente,
                Confirmado = rf.Confirmado,
                Expandido = rf.Expandido
            })
            .ToList();

        // Cópia dos contatos
        contatosRascunho = (alunoSelecionado?.ContatosEmergencia ?? new())
            .Select(c => new ContatoCard { Nome = c.Nome ?? "", GrauParentesco = c.GrauParentesco ?? "", Telefone = c.Telefone ?? "", Expandido = false })
            .ToList();
        telefonesRascunho = contatosRascunho.Select(c => Mask.FormatPhone(c.Telefone)).ToList();

        modoEdicao = true;
    }

    void CancelarEdicao()
    {
        // Descarta o rascunho; a lista de visualização não foi tocada
        responsaveisRascunho.Clear();
        contatosRascunho.Clear();
        telefonesRascunho.Clear();
        modoEdicao = false;
        CarregarDadosAluno(); // restaura campos de texto também
        msgErro = "";
    }

    async Task SalvarAluno()
    {
        if (alunoSelecionado == null) return;
        msgErro = "";

        if (string.IsNullOrWhiteSpace(Nome))
        {
            msgErro = "Nome do aluno é obrigatório.";
            return;
        }

        var confirmados = responsaveisRascunho.Where(rf => rf.EhExistente || rf.Confirmado).ToList();
        if (!confirmados.Any())
        {
            msgErro = "O aluno precisa de ao menos um responsável.";
            return;
        }

        try
        {
            alunoSelecionado.Nome = Nome;
            alunoSelecionado.DataNascimento = dataNascimento;
            alunoSelecionado.Religiao = Religiao;
            alunoSelecionado.NomePediatra = Pediatra;
            alunoSelecionado.OrientacoesEmergencia = Orientacoes;
            alunoSelecionado.Alergias = Alergias;
            alunoSelecionado.CondicoesEspeciais = CondicoesEspeciais;

            // Aplica contatos do rascunho
            alunoSelecionado.ContatosEmergencia = contatosRascunho
                .Select(c => new ContatoEmergencia { Nome = c.Nome, GrauParentesco = c.GrauParentesco, Telefone = c.Telefone })
                .ToList();

            // Turma
            if (!string.IsNullOrEmpty(turmaId))
            {
                var newTurma = TurmaController.Get(turmaId, null);
                if (newTurma != null && (alunoSelecionado.Turma == null || alunoSelecionado.Turma.Id != newTurma.Id))
                {
                    alunoSelecionado.Turma?.Alunos.Remove(alunoSelecionado);
                    newTurma.Alunos.Add(alunoSelecionado);
                    alunoSelecionado.Turma = newTurma;
                }
            }

            // Determina responsáveis removidos (estavam no original, não estão no rascunho)
            var idsRascunho = responsaveisRascunho
                .Where(rf => rf.EhExistente && rf.ResponsavelObj != null)
                .Select(rf => rf.ResponsavelObj!.Id)
                .ToHashSet();

            foreach (var rf in responsaveisEdicao.Where(rf => rf.EhExistente && rf.ResponsavelObj != null))
            {
                if (!idsRascunho.Contains(rf.ResponsavelObj!.Id))
                {
                    // Remove o vínculo
                    var p = rf.ResponsavelObj.GetParentescos()?.FirstOrDefault(p => p.Aluno.Id == alunoSelecionado.Id);
                    if (p != null) rf.ResponsavelObj.GetParentescos()!.Remove(p);
                    alunoSelecionado.Responsaveis.Remove(rf.ResponsavelObj);
                }
            }

            // Atualiza parentesco dos existentes que permaneceram
            foreach (var rf in responsaveisRascunho.Where(rf => rf.EhExistente && rf.ResponsavelObj != null))
            {
                var p = rf.ResponsavelObj!.GetParentescos()?.FirstOrDefault(p => p.Aluno.Id == alunoSelecionado.Id);
                if (p != null) p.Tipo = rf.TipoParentesco;
            }

            // Cadastra e vincula novos responsáveis do rascunho
            foreach (var rf in responsaveisRascunho.Where(rf => !rf.EhExistente && rf.Confirmado))
            {
                var cpfLimpo = Mask.RemoveMask(rf.CpfFormatado);
                var resp = ResponsavelController.Get("CPF", cpfLimpo) ?? CriarNovoResponsavel(rf, cpfLimpo);
                ResponsavelController.AddParentesco(resp, alunoSelecionado, rf.TipoParentesco);
            }

            modoEdicao = false;
            responsaveisRascunho.Clear();
            contatosRascunho.Clear();
            telefonesRascunho.Clear();

            LoadData();
            alunoSelecionado = AlunoController.Get(alunoSelecionado.Id.ToString(), null);
            if (alunoSelecionado != null) CarregarDadosAluno();
            msgErro = "";
        }
        catch (Exception ex)
        {
            msgErro = "Erro: " + ex.Message;
        }
    }

    void AdicionarResponsavelRascunho() =>
        responsaveisRascunho.Add(new ResponsavelCard { Expandido = true, EhExistente = false });

    void RemoverResponsavelRascunho(int idx)
    {
        if (responsaveisRascunho.Count <= 1) return;
        // Remove só do rascunho; o objeto real não é tocado aqui
        responsaveisRascunho.RemoveAt(idx);
    }

    void OnCpfRascunhoInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        responsaveisRascunho[idx].CpfFormatado = Mask.FormatCpf(digits);
        responsaveisRascunho[idx].ResponsavelObj = null;
        responsaveisRascunho[idx].EhExistente = false;
        responsaveisRascunho[idx].Sugestoes = todosResponsaveis
            .Where(r => !string.IsNullOrEmpty(r.CPF) && r.CPF.Contains(digits))
            .Take(5).ToList();
    }

    void SelecionarResponsavelRascunho(int idx, Responsavel r)
    {
        var rf = responsaveisRascunho[idx];
        rf.ResponsavelObj = r;
        rf.EhExistente = true;
        rf.Confirmado = true;
        rf.CpfFormatado = r.CPF ?? "";
        rf.Nome = r.Nome ?? "";
        rf.Email = r.Email ?? "";
        rf.TelefoneFormatado = r.Telefone ?? "";
        rf.Endereco = r.Endereco ?? "";
        rf.CEP = r.CEP ?? "";
        rf.DataNascimento = r.DataNascimento ?? DateTime.Today;
        rf.Sugestoes.Clear();
        rf.ErroCampo = "";
    }

    void OnTelefoneRascunhoInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        responsaveisRascunho[idx].TelefoneFormatado = Mask.FormatPhone(digits);
    }

    void OnCEPRascunhoInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 8) digits = digits[..8];
        responsaveisRascunho[idx].CEP = Mask.FormatCEP(digits);
    }

    void ConfirmarResponsavelRascunho(int idx)
    {
        var rf = responsaveisRascunho[idx];
        rf.ErroCampo = "";
        var cpfLimpo = Mask.RemoveMask(rf.CpfFormatado);
        if (string.IsNullOrWhiteSpace(cpfLimpo) || cpfLimpo.Length != 11) { rf.ErroCampo = "CPF inválido."; return; }
        if (string.IsNullOrWhiteSpace(rf.Nome)) { rf.ErroCampo = "Nome é obrigatório."; return; }
        rf.Confirmado = true;
        rf.Expandido = false;
    }

    Responsavel CriarNovoResponsavel(ResponsavelCard rf, string cpfLimpo)
    {
        var user = new User { Nome = rf.Nome, CPF = cpfLimpo, Email = rf.Email, AccessType = new AccessType { Level = 0 } };
        user.Senha = PasswordHandler.HashPassword(rf.DataNascimento.ToString("yyyyMMdd"), user.Salt);
        UserController.Register(user);

        var resp = ResponsavelController.CreateByUser(user);
        resp.Telefone = Mask.RemoveMask(rf.TelefoneFormatado);
        resp.Endereco = rf.Endereco;
        resp.CEP = rf.CEP;
        resp.DataNascimento = rf.DataNascimento;
        ResponsavelController.Register(resp);
        return resp;
    }

    void AdicionarContatoRascunho()
    {
        contatosRascunho.Add(new ContatoCard());
        telefonesRascunho.Add("");
    }

    void RemoverContatoRascunho(int idx)
    {
        contatosRascunho.RemoveAt(idx);
        telefonesRascunho.RemoveAt(idx);
    }

    void OnTelefoneContatoRascunhoInput(ChangeEventArgs e, int idx)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        telefonesRascunho[idx] = Mask.FormatPhone(digits);
        contatosRascunho[idx].Telefone = Mask.RemoveMask(telefonesRascunho[idx]);
    }

    void AbrirModalResponsavel(Responsavel r, int tipo) { responsavelModal = r; tipoParentescoModal = tipo; mostrarModalResponsavel = true; }
    void FecharModalResponsavel() { mostrarModalResponsavel = false; responsavelModal = null; }

    string GetResponsavelNome(Aluno aluno)
    {
        if (aluno.Responsaveis.Any()) return aluno.Responsaveis[0].Nome ?? "-";
        var resp = todosResponsaveis.FirstOrDefault(r => r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.Nome ?? "-";
    }

    void CalcularIdade()
    {
        DateTime data = dataNascimento ?? DateTime.Today;
        DateTime hoje = DateTime.Today;
        int anos = hoje.Year - data.Year;
        if (hoje < data.AddYears(anos)) anos--;
        int meses = hoje.Month - data.Month;
        if (hoje.Day < data.Day) meses--;
        if (meses < 0) meses += 12;
        idadeExtenso = $"{anos} anos e {meses} meses";
    }

    void HandleAlergiaKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAlergia)) { Alergias.Add(addAlergia.Trim()); addAlergia = ""; }
    }

    void HandleCondicoesKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addCondicao)) { CondicoesEspeciais.Add(addCondicao.Trim()); addCondicao = ""; }
    }

    void GoReceita(Guid id) => Navigation.NavigateTo($"/dashboard-financeiro/receita/{id}");

    async Task GerarPdfFicha()
    {
        if (alunoSelecionado == null) return;
        try
        {
            byte[] pdf = PdfService.GerarFichaAluno(alunoSelecionado);
            string base64 = Convert.ToBase64String(pdf);
            string nome = $"Ficha_{alunoSelecionado.Nome?.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("downloadPdf", base64, nome);
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine(ex.Message); }
    }

    IEnumerable<Aluno> alunosFiltrados =>
        alunos.Where(a => string.IsNullOrEmpty(search) || (a.Nome?.ToLower().Contains(search.ToLower()) ?? false));

    void CarregarReceitas()
    {
        if (alunoSelecionado == null) return;
        ReceitasAluno = ReceitaController.GetAll()
            .Where(r => r.Aluno != null && r.Aluno.Id == alunoSelecionado.Id)
            .OrderBy(r => r.DataReferente).ToList();
        paginaAtual = 1;
    }

    IEnumerable<Receita> ReceitasFinanceirasFiltradas
    {
        get
        {
            var q = ReceitasAluno.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(pesquisaFinanceiro))
                q = q.Where(r => r.GetTypeTexto().Contains(pesquisaFinanceiro, StringComparison.OrdinalIgnoreCase));
            if (statusFinanceiro == "Pago") q = q.Where(r => r.IsPago());
            else if (statusFinanceiro == "EmAndamento") q = q.Where(r => r.Status == Receita.FinanceStatus.EmAndamento);
            else if (statusFinanceiro == "EmAtraso") q = q.Where(r => r.Status == Receita.FinanceStatus.EmAtraso);
            if (dataInicioFinanceiro.HasValue) q = q.Where(r => r.DataVencimento.Date >= dataInicioFinanceiro.Value.Date);
            if (dataFimFinanceiro.HasValue) q = q.Where(r => r.DataVencimento.Date <= dataFimFinanceiro.Value.Date);
            q = ordemValorFinanceiro switch
            {
                "asc" => q.OrderBy(r => r.GetValorTotal()),
                "desc" => q.OrderByDescending(r => r.GetValorTotal()),
                _ => q.OrderBy(r => r.DataReferente)
            };
            return q;
        }
    }

    List<Receita> ReceitasFinanceirasPaginadas =>
        ReceitasFinanceirasFiltradas.Skip((paginaAtual - 1) * itensPorPagina).Take(itensPorPagina).ToList();

    void MudarPagina(int p) { if (p >= 1 && p <= totalPaginas) paginaAtual = p; }

    List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();
        if (totalPaginas <= 7) { for (int i = 1; i <= totalPaginas; i++) paginas.Add(i); return paginas; }
        paginas.Add(1);
        if (paginaAtual > 4) paginas.Add(null);
        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);
        for (int i = inicio; i <= fim; i++) paginas.Add(i);
        if (paginaAtual < totalPaginas - 3) paginas.Add(null);
        paginas.Add(totalPaginas);
        return paginas;
    }

    string GetStatusBadge(Receita.FinanceStatus s) => s switch
    {
        Receita.FinanceStatus.Pago => "bg-success",
        Receita.FinanceStatus.EmAtraso => "bg-danger",
        Receita.FinanceStatus.EmAndamento => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
