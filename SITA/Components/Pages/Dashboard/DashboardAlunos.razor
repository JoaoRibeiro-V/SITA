@page "/alunos"
@using SITA.src.Model
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
    <h1 style="color: #3650a1; font-weight: bold;">Alunos Matriculados</h1>
    <div style="display: flex; gap: 10px;">
       
        <button class="btn-cadastrar" @onclick='() => Navigation.NavigateTo("/cadastro-aluno")'
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Nova Matrícula
        </button>

        <button class="btn-cadastrar" @onclick='() => Navigation.NavigateTo("/cadastro-responsavel")'
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Novo Responsável
        </button>

        <input @bind="search" @bind:event="oninput" placeholder="Pesquisar aluno..." style="padding: 8px; border-radius: 5px; border: 1px solid #ccc;" />
    </div>
</div>
<section style="padding: 20px; width:100%" >

    <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">

        <!-- Cabeçalho -->
        <thead>
            <tr style="color: white;">
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-left-radius: 8px;">Nome</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">RA</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Idade</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Turma</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Responsável</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-right-radius: 8px;">Status</th>
            </tr>
        </thead>

        <!-- Dados -->
        <tbody>
            @foreach (var aluno in alunosFiltrados)
            {
                <tr @onclick="() => AbrirModalAluno(aluno)"
                    style="cursor: pointer; background: transparent;">

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.Nome
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.RA
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @aluno.Idade anos
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(aluno.Turma?.Nome ?? "Sem Turma")
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @GetResponsavelNome(aluno)
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(aluno.Turma != null ? "Ativo" : "Pendências")
                    </td>

                </tr>
            }
        </tbody>

    </table>

</section>

<!--modal-->
@if (mostrarModalAluno && alunoSelecionado != null)
{
    <div class="overlay-modal">
        <div class="modal-aluno">

            <div class="modal-topo">
                <h2>@alunoSelecionado.Nome</h2>

                <button class="btn-fechar" @onclick="FecharModal">
                    ×
                </button>
            </div>

            <div class="abas-modal">
                <button class="@(abaAtiva == "ficha" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "ficha"'>
                    Ficha de Matrícula
                </button>

                <button class="@(abaAtiva == "financeiro" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "financeiro"'>
                    Financeiro
                </button>
            </div>

            <div class="conteudo-modal">

                @if (abaAtiva == "ficha")
                {
                    <div class="ficha-container">

                        <div class="ficha-titulo">
                            <h2>FICHA DE MATRÍCULA COMPLETA</h2>
                        </div>

                        <div class="linha">
                            <div class="campo campo-grande">
                                <label>Nome Completo do Aluno:</label>
                                <input value="@alunoSelecionado.Nome" readonly />
                            </div>

                            <div class="campo campo-medio">
                                <label>Data de Nascimento:</label>
                                <input value="@alunoSelecionado.DataNascimento?.ToString("dd/MM/yyyy")" readonly />
                            </div>

                            <div class="campo campo-medio">
                                <label class="label-cinza">Idade Calculada:</label>
                                <div class="caixa-idade">
                                    @alunoSelecionado.Idade anos
                                </div>
                            </div>
                        </div>

                        <div class="linha">
                            <div class="campo campo-terco">
                                <label>RA:</label>
                                <input value="@alunoSelecionado.RA" readonly />
                            </div>

                            <div class="campo campo-terco">
                                <label>Religião:</label>
                                <input value="@alunoSelecionado.Religiao" readonly />
                            </div>

                            <div class="campo campo-terco">
                                <label>Turma:</label>
                                <input value="@(alunoSelecionado.Turma?.Nome ?? "Sem Turma")" readonly />
                            </div>
                        </div>

                        <div class="bloco responsavel">
                            <h3>Dados do Responsável</h3>

                            <div class="linha">
                                <div class="campo metade">
                                    <label>Responsável:</label>
                                    <input value="@GetResponsavelNome(alunoSelecionado)" readonly />
                                </div>

                                <div class="campo metade">
                                    <label>Status:</label>
                                    <input value="@(alunoSelecionado.Turma != null ? "Ativo" : "Pendências")" readonly />
                                </div>
                            </div>
                        </div>

                        <div class="bloco saude">
                            <h3>Saúde e Emergência</h3>

                            <div class="linha">
                                <div class="campo metade">
                                    <label>Pediatra do Aluno:</label>
                                    <input value="@alunoSelecionado.NomePediatra" readonly />
                                </div>

                                <div class="campo metade">
                                    <label>Orientações de Emergência:</label>
                                    <textarea readonly>@alunoSelecionado.OrientacoesEmergencia</textarea>
                                </div>
                            </div>

                            <div class="linha">
                                <div class="campo metade">
                                    <label>Alergias:</label>

                                    <div class="lista-tags">
                                        @if (alunoSelecionado.Alergias != null && alunoSelecionado.Alergias.Any())
                                        {
                                            @foreach (var alergia in alunoSelecionado.Alergias)
                                            {
                                                <span class="tag alergia">@alergia</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma alergia informada.</span>
                                        }
                                    </div>
                                </div>

                                <div class="campo metade">
                                    <label>Condições Especiais:</label>

                                    <div class="lista-tags">
                                        @if (alunoSelecionado.CondicoesEspeciais != null && alunoSelecionado.CondicoesEspeciais.Any())
                                        {
                                            @foreach (var condicao in alunoSelecionado.CondicoesEspeciais)
                                            {
                                                <span class="tag condicao">@condicao</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="sem-info">Nenhuma condição informada.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }

                @if (abaAtiva == "financeiro")
                {
                    <div class="aba-financeiro">
                        <h2>FINANCEIRO</h2>

                        <p>Aqui entra a tabela de mensalidades e receitas do aluno.</p>
                    </div>
                }

            </div>
        </div>
    </div>
}
@code {
    List<Aluno> alunos = new();
    List<Responsavel> responsaveis = new();
    string search = "";

    IEnumerable<Aluno> alunosFiltrados =>
        alunos.Where(a => string.IsNullOrEmpty(search) ||
        (a.Nome?.ToLower().Contains(search.ToLower()) ?? false));

    protected override void OnInitialized() => LoadData();

    void LoadData()
    {
        alunos = AlunoController.GetAll();
        responsaveis = ResponsavelController.GetAll();
    }

    string GetResponsavelNome(Aluno aluno)
    {
        var resp = responsaveis.FirstOrDefault(r =>
            r.GetParentescos()?.Any(p => p.Aluno.Id == aluno.Id) == true);
        return resp?.Nome ?? "-";
    }

    void GoAluno(Guid id) => Navigation.NavigateTo($"/aluno-details/{id}");
    private bool mostrarModalAluno = false;
    private string abaAtiva = "ficha";
    private Aluno? alunoSelecionado;

    private void AbrirModalAluno(Aluno aluno)
    {
        alunoSelecionado = aluno;
        abaAtiva = "ficha";
        mostrarModalAluno = true;
    }

    private void FecharModal()
    {
        mostrarModalAluno = false;
        alunoSelecionado = null;
    }
}