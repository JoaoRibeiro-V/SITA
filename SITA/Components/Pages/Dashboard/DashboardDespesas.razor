@page "/despesas/{DespesaId:guid?}"

@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Storage
@using SITA.src.Services
@using SITA.src.Util
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager Navigation
@inject FileService FileService

<div class="header-despesas">

    <h1>Gestão de Despesas</h1>

    <button @onclick="AbrirModalNovaDespesa">
        + Cadastrar Nova Despesa
    </button>

</div>

<div class="conteiner">

    <div class="area-financeira">

        <!-- FILTROS -->
        <aside class="filtros">

            <div class="filtro">

                <label>Pesquisar</label>

                <input placeholder="Nome, fornecedor ou item..."
                       @bind="pesquisa"
                       @bind:event="oninput" />

            </div>

            <div class="filtro">

                <label>Categoria</label>

                <select @bind="categoriaFiltro">

                    <option value="">
                        Todas
                    </option>

                    @foreach (var categoria in categoriasDisponiveis)
                    {
                        <option value="@categoria">
                            @categoria
                        </option>
                    }

                </select>

            </div>

            <div class="filtro">

                <label>Status</label>

                <select @bind="statusFiltro">

                    <option value="">
                        Todos
                    </option>

                    <option value=@Financeiro.FinanceStatus.Pago>
                        Pago
                    </option>

                    <option value=@Financeiro.FinanceStatus.Pendente>
                        Pendente
                    </option>

                    <option value=@Financeiro.FinanceStatus.EmAndamento>
                        Em Andamento
                    </option>

                    <option value=@Financeiro.FinanceStatus.EmAtraso>
                        Em Atraso
                    </option>

                </select>

            </div>

            <div class="filtro">

                <label>Data Inicial</label>

                <input type="date"
                       @bind="dataInicial" />

            </div>

            <div class="filtro">

                <label>Data Final</label>

                <input type="date"
                       @bind="dataFinal" />

            </div>

            <div class="filtro">

                <label>Ordenar Valor</label>

                <select @bind="ordemValor">

                    <option value="">
                        Padrão
                    </option>

                    <option value="asc">
                        Menor → Maior
                    </option>

                    <option value="desc">
                        Maior → Menor
                    </option>

                </select>

            </div>

        </aside>

        <!-- TABELA -->
        <div class="conteudo-financeiro">

            <div class="tabela-container">

                <table class="tabla">

                    <thead class="Theader">

                        <tr>

                            <th>Data</th>
                            <th>Tipo</th>
                            <th>Descrição</th>
                            <th>Valor</th>
                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (listaDespesas == null || !listaDespesas.Any())
                        {
                            <tr>

                                <td colspan="5"
                                    class="sem-registro">

                                    Nenhuma despesa registrada.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var despesa in DespesasFiltradas)
                            {
                                <tr class="linha-clicavel"
                                    @onclick="() => AbrirModal(despesa)">

                                    <td>
                                        @despesa.DataVencimento.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @despesa.Categoria
                                    </td>

                                    <td class="descricao">
                                        @despesa.Descricao
                                    </td>

                                    <td class="valor-despesa">
                                        R$ @despesa.GetValorTotal().ToString("N2")
                                    </td>

                                    <td>
                                        @(despesa.GetStatusTexto())
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- MODAL -->
<div class="overlay-modal @(mostrarModalDespesa ? "overlay-aberto" : "overlay-fechado")">

    <div class="modal-receita @(animarModal ? "modal-aberta" : "")">

        @if (despesaSelecionada != null)
        {
            <div class="modal-topo">

                <h2>@despesaSelecionada.Categoria</h2>

                <button class="btn-fechar"
                        @onclick="FecharModal">
                    ×
                </button>

            </div>

            <br />

            <div class="abas-modal">

                <button class="@(abaAtiva == "detalhes" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "detalhes"'>

                    Detalhes

                </button>

                <button class="@(abaAtiva == "gestao" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "gestao"'>

                    Gestão

                </button>

            </div>

            <div class="conteudo-modal">

                @if (abaAtiva == "detalhes")
                {
                    switch (Mask.RemoveAccents(despesaSelecionada.Categoria))
                    {
                        case "Salario":
                            {
                                Salario despesaSelecionadaSalario = (Salario)despesaSelecionada;

                                <div style="
                                                        background-color:#f0f0f0;
                                                        padding:20px;
                                                        border-radius:8px;
                                                        margin-bottom:25px;
                                                        border-left:5px solid #dc2626;
                                                        ">

                                    <div class="row mt-3">

                                        <div class="col-md-6">
                                            <p>
                                                <strong>Funcionário:</strong>
                                                @despesaSelecionadaSalario.Funcionario.Nome
                                            </p>
                                            <p>
                                                <strong>Descrição:</strong>
                                                @despesaSelecionada.Descricao
                                            </p>

                                            <p>
                                                <strong>Categoria:</strong>
                                                @despesaSelecionada.Categoria
                                            </p>
                                            @if (despesaSelecionada.IsPago())
                                            {
                                                <p>
                                                    <strong>Quem Pagou:</strong>
                                                    @despesaSelecionada.QuemPagou
                                                </p>
                                            }
                                        </div>

                                        <div class="col-md-6">

                                            <p>
                                                <strong>Vencimento:</strong>
                                                @despesaSelecionada.DataVencimento.ToString("dd/MM/yyyy")
                                            </p>

                                            <p>
                                                <strong>Valor:</strong>

                                                <span class="text-danger fw-bold">
                                                    R$ @despesaSelecionada.GetValorTotal().ToString("N2")
                                                </span>

                                            </p>

                                            <p>
                                                <strong>Status:</strong>

                                                <span class="badge @(despesaSelecionada.IsPago() ? "bg-success" : "bg-warning text-dark")">

                                                    @(despesaSelecionada.GetStatusTexto())

                                                </span>

                                            </p>
                                            <p>
                                                <strong>Chave Pix:</strong>
                                                @despesaSelecionadaSalario.Funcionario.ChavePix
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="mt-2">
                                    <small><strong>Descontos</strong></small><br />

                                    @if (despesaSelecionada.Descontos.Count == 0)
                                    {
                                        <small class="text-muted">
                                            Nenhum desconto encontrado
                                        </small>
                                    }

                                    @foreach (Financeiro.Desconto desconto in DescontosPaginados)
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom"
                                             style="font-size: 0.85rem;">

                                            <span class="text-truncate"
                                                  style="max-width: 75%;">
                                                @desconto.Descricao
                                            </span>

                                            <span class="text-danger fw-bold">
                                                - @(desconto.Tipo == Financeiro.Desconto.TipoValor.Percentual ? $"{desconto.Valor:N0}%" : $"R$ {desconto.Valor:N2}")
                                            </span>

                                        </div>
                                    }

                                </div>
                                @if (despesaSelecionada.Descontos.Count > itensPorPaginaDetalhes)
                                {
                                    <div class="d-flex justify-content-end gap-1 mt-2">

                                        <button class="btn btn-sm btn-light px-2 py-0"
                                                disabled="@(paginaDescontos == 1)"
                                                @onclick="() => paginaDescontos--">
                                            ‹
                                        </button>

                                        <small class="align-self-center">
                                            @paginaDescontos
                                        </small>

                                        <button class="btn btn-sm btn-light px-2 py-0"
                                                disabled="@(paginaDescontos >= Math.Ceiling((double)despesaSelecionada.Descontos.Count / itensPorPaginaDetalhes))"
                                                @onclick="() => paginaDescontos++">
                                            ›
                                        </button>

                                    </div>
                                }

                                <div class="mt-2">
                                    <small><strong>Extras</strong></small><br />
                                    @if (despesaSelecionada.Bonus.Count == 0)
                                    {
                                        <small class="text-muted">
                                            Nenhum extra encontrado
                                        </small>
                                    }

                                    @foreach (Financeiro.Extras extra in ExtrasPaginados)
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom"
                                             style="font-size: 0.85rem;">

                                            <span class="text-truncate"
                                                  style="max-width: 75%;">
                                                @extra.Descricao
                                            </span>

                                            <span class="text-success fw-bold">
                                                + @(extra.Tipo == Financeiro.Extras.TipoValor.Percentual ? $"{extra.Valor:N0}%" : $"R$ {extra.Valor:N2}")
                                            </span>

                                        </div>
                                    }

                                </div>
                                @if (despesaSelecionada.Bonus.Count > itensPorPaginaDetalhes)
                                {
                                    <div class="d-flex justify-content-end gap-1 mt-2">

                                        <button class="btn btn-sm btn-light px-2 py-0"
                                                disabled="@(paginaExtras == 1)"
                                                @onclick="() => paginaExtras--">
                                            ‹
                                        </button>

                                        <small class="align-self-center">
                                            @paginaExtras
                                        </small>

                                        <button class="btn btn-sm btn-light px-2 py-0"
                                                disabled="@(paginaExtras >= Math.Ceiling((double)despesaSelecionada.Bonus.Count / itensPorPaginaDetalhes))"
                                                @onclick="() => paginaExtras++">
                                            ›
                                        </button>

                                    </div>
                                }
                            }
                            break;
                        default:
                            <div style="
                                                background-color:#f0f0f0;
                                                padding:20px;
                                                border-radius:8px;
                                                margin-bottom:25px;
                                                border-left:5px solid #dc2626;
                                                ">

                                <div class="row mt-3">

                                    <div class="col-md-6">

                                        <p>
                                            <strong>Descrição:</strong>
                                            @despesaSelecionada.Descricao
                                        </p>

                                        <p>
                                            <strong>Fornecedor:</strong>
                                            @despesaSelecionada.Fornecedor
                                        </p>

                                        <p>
                                            <strong>Categoria:</strong>
                                            @despesaSelecionada.Categoria
                                        </p>

                                        @if (despesaSelecionada.IsPago())
                                        {
                                            <p>
                                                <strong>Quem Pagou:</strong>
                                                @despesaSelecionada.QuemPagou
                                            </p>
                                        }

                                        <p>
                                            <strong>CNPJ Escola:</strong>
                                            @despesaSelecionada.CnpjEscola
                                        </p>

                                    </div>

                                    <div class="col-md-6">

                                        <p>
                                            <strong>Vencimento:</strong>
                                            @despesaSelecionada.DataVencimento.ToString("dd/MM/yyyy")
                                        </p>

                                        <p>
                                            <strong>CNPJ Fornecedor:</strong>
                                            @despesaSelecionada.CnpjFornecedor
                                        </p>

                                        <p>
                                            <strong>Nº Nota Fiscal:</strong>
                                            @despesaSelecionada.NumeroNotaFiscal
                                        </p>

                                        <p>
                                            <strong>Chave NF:</strong>
                                            @despesaSelecionada.ChaveAcessoNF
                                        </p>

                                        <p>
                                            <strong>Valor:</strong>

                                            <span class="text-danger fw-bold">
                                                R$ @despesaSelecionada.GetValorTotal().ToString("N2")
                                            </span>

                                        </p>

                                        <p>
                                            <strong>Status:</strong>

                                            <span class="badge @(despesaSelecionada.IsPago() ? "bg-success" : "bg-warning text-dark")">

                                                @(despesaSelecionada.GetStatusTexto())

                                            </span>

                                        </p>

                                    </div>

                                </div>

                            </div>


                            break;
                    }

                    <hr />

                    <h5 class="fw-bold mb-3">
                        Comprovante
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => mostrarComprovante = true">

                            Ver Comprovante

                        </button>
                    }
                    else
                    {
                        <small class="text-muted">
                            Nenhum comprovante enviado.
                        </small>
                    }
                }
                else if (abaAtiva == "gestao")
                {
                    @if (despesaSelecionada is Salario)
                    {
                        <!-- DESCONTOS -->
                        <div class="card border-0 shadow-sm p-3 mb-4"
                             style="border-radius: 12px;">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold m-0">
                                    Descontos
                                </h6>

                                <button class="btn btn-success btn-sm"
                                        style="
                                                width: 28px;
                                                height: 28px;
                                                padding: 0;
                                                border-radius: 8px;
                                                font-size: 1rem;
                                                line-height: 1;
                                                display:flex;
                                                align-items:center;
                                                justify-content:center;
                                                "
                                        @onclick="AdicionarDesconto">
                                    +
                                </button>
                            </div>

                            @if (despesaSelecionada.Descontos.Count == 0)
                            {
                                <small class="text-muted">
                                    Nenhum desconto cadastrado.
                                </small>
                            }

                            @foreach (var desconto in despesaSelecionada.Descontos)
                            {
                                <div class="d-flex gap-2 align-items-center mb-2">

                                    <input class="form-control form-control-sm"
                                           placeholder="Descrição"
                                           style="font-size: 0.82rem;"
                                           @bind="desconto.Descricao" />

                                    <select class="form-select form-select-sm"
                                            style="width: 70px;"
                                            @bind="desconto.Tipo">

                                        <option value="@Financeiro.Desconto.TipoValor.Fixo">
                                            R$
                                        </option>

                                        <option value="@Financeiro.Desconto.TipoValor.Percentual">
                                            %
                                        </option>

                                    </select>

                                    <input class="form-control form-control-sm"
                                           type="number"
                                           step="0.01"
                                           style="width: 90px;"
                                           @bind="desconto.Valor" />

                                    <button class="btn btn-danger btn-sm"
                                            style="
                                                        width: 28px;
                                                        height: 28px;
                                                        padding: 0;
                                                        border-radius: 8px;
                                                        font-size: 0.9rem;
                                                        line-height: 1;
                                                        display:flex;
                                                        align-items:center;
                                                        justify-content:center;
                                                        flex-shrink: 0;
                                                        "
                                            @onclick="() => RemoverDesconto(desconto)">
                                        ×
                                    </button>

                                </div>
                            }
                        </div>

                        <!-- EXTRAS -->
                        <div class="card border-0 shadow-sm p-3 mb-4"
                             style="border-radius: 12px;">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold m-0">
                                    Extras
                                </h6>

                                <button class="btn btn-success btn-sm"
                                        style="
                                                width: 28px;
                                                height: 28px;
                                                padding: 0;
                                                border-radius: 8px;
                                                font-size: 1rem;
                                                line-height: 1;
                                                display:flex;
                                                align-items:center;
                                                justify-content:center;
                                                "
                                        @onclick="AdicionarExtra">
                                    +
                                </button>
                            </div>

                            @if (despesaSelecionada.Bonus.Count == 0)
                            {
                                <small class="text-muted">
                                    Nenhum extra cadastrado.
                                </small>
                            }

                            @foreach (var extra in despesaSelecionada.Bonus)
                            {
                                <div class="d-flex gap-2 align-items-center mb-2">

                                    <input class="form-control form-control-sm"
                                           placeholder="Descrição"
                                           style="font-size: 0.82rem;"
                                           @bind="extra.Descricao" />

                                    <select class="form-select form-select-sm"
                                            style="width: 70px;"
                                            @bind="extra.Tipo">

                                        <option value="@Financeiro.Extras.TipoValor.Fixo">
                                            R$
                                        </option>

                                        <option value="@Financeiro.Extras.TipoValor.Percentual">
                                            %
                                        </option>

                                    </select>

                                    <input class="form-control form-control-sm"
                                           type="number"
                                           step="0.01"
                                           style="width: 90px;"
                                           @bind="extra.Valor" />

                                    <button class="btn btn-danger btn-sm"
                                            style="
                                                        width: 28px;
                                                        height: 28px;
                                                        padding: 0;
                                                        border-radius: 8px;
                                                        font-size: 0.9rem;
                                                        line-height: 1;
                                                        display:flex;
                                                        align-items:center;
                                                        justify-content:center;
                                                        flex-shrink: 0;
                                                        "
                                            @onclick="() => RemoverExtra(extra)">
                                        ×
                                    </button>

                                </div>
                            }
                        </div>

                        <!-- RESUMO -->
                        <div class="card border-0 shadow-sm p-4 mb-4"
                             style="border-radius: 12px; background: #f8f9fa;">

                            <div class="d-flex justify-content-between mb-2">
                                <span>Valor Base:</span>
                                <strong>
                                    R$ @despesaSelecionada.Valor.ToString("N2")
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between mb-2 text-danger">
                                <span>Total Descontos:</span>
                                <strong>
                                    - R$ @despesaSelecionada.Descontos.Sum(d => d.GetValorFinal(@despesaSelecionada.Valor)).ToString("N2")
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Total Extras:</span>
                                <strong>
                                    + R$ @despesaSelecionada.Bonus.Sum(b => b.GetValorFinal(@despesaSelecionada.Valor)).ToString("N2")
                                </strong>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">Valor Final:</span>

                                <strong class="text-primary">
                                    R$ @despesaSelecionada.GetValorTotal().ToString("N2")
                                </strong>
                            </div>
                        </div>
                    }
                    @if (despesaSelecionada.Status != Receita.FinanceStatus.Pago)
                    {
                        <button class="btn btn-success w-100 p-3 fw-bold"
                                @onclick="() => IrParaFinanceiro(despesaSelecionada)">
                            CONFIRMAR PAGAMENTO
                        </button>
                    }
                    else
                    {

                        @if (despesaSelecionada.Status == Receita.FinanceStatus.Pago)
                        {
                            <div class="card border-0 shadow-sm p-3 mt-4"
                                 style="border-radius: 12px;">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div>
                                        <h6 class="fw-bold m-0">
                                            Comprovante
                                        </h6>

                                        @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                                        {
                                            <small class="text-success">
                                                Comprovante enviado
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-warning">
                                                Nenhum comprovante enviado
                                            </small>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                                    {
                                        <button class="btn-ver-comprovante"
                                                @onclick="() => mostrarComprovante = true">

                                            👁

                                        </button>
                                    }

                                </div>

                                <!-- NOVO ARQUIVO -->
                                <InputFile OnChange="SelecionarComprovanteGestao"
                                           class="form-control form-control-sm mb-3" />

                                @if (comprovanteGestao != null)
                                {
                                    <small class="text-success d-block mb-3">
                                        Novo arquivo:
                                        @comprovanteGestao.Name
                                    </small>
                                }

                            <div class="d-flex gap-2">

                                <!-- SALVAR -->
                                <button class="btn btn-success btn-sm fw-bold"
                                        disabled="@(comprovanteGestao == null)"
                                        @onclick="SalvarComprovanteGestao">

                                    @(string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho)
                                                            ? "SALVAR COMPROVANTE"
                                                            : "ALTERAR COMPROVANTE")

                    </button>

                                    <!-- REMOVER -->
                    @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                                    {
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="RemoverComprovante">

                                            Remover

                                        </button>
                                    }

                                </div>

                            </div>
                        }
                    }

                }

            </div>
        }

    </div>

</div>

<style>

    .linha-clicavel {
        cursor: pointer;
    }

        .linha-clicavel:hover {
            background: #f6f8ff;
        }

    .overlay-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        transition: 0.2s;
    }

    .overlay-fechado {
        opacity: 0;
        pointer-events: none;
    }

    .overlay-aberto {
        opacity: 1;
    }

    .modal-receita {
        width: 95%;
        max-width: 850px;
        max-height: 92vh;
        overflow-y: auto;
        background: white;
        border-radius: 16px;
        padding: 24px;
        transform: scale(0.96);
        transition: 0.2s;
    }

    .modal-aberta {
        transform: scale(1);
    }

    .modal-topo {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-fechar {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 8px;
        background: #ef4444;
        color: white;
        font-size: 22px;
        cursor: pointer;
    }

    .abas-modal {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

        .abas-modal button {
            border: none;
            background: #e5e7eb;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
        }

    .aba-ativa {
        background: #3650a1 !important;
        color: white;
    }

</style>

<style>
    .header-despesas {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 18px 40px 18px;
    }

        .header-despesas h1 {
            margin: 0;
            color: #3650a1;
            font-size: 40px;
            font-weight: bold;
        }

        .header-despesas button {
            width: 250px;
            height: 44px;
            border: none;
            border-radius: 5px;
            background-color: #3650a1;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

            .header-despesas button:hover {
                background-color: #2d4388;
            }

