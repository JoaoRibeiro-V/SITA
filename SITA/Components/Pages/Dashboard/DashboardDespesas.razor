            @if (extensao == ".pdf")
            {
                <iframe src="@despesaSelecionada.AnexoCaminho"
                        width="100%"
                        height="700px"
                        style="
                            border:none;
                            border-radius:12px;
                            background:white;
                            ">
                </iframe>
            }
            else
            {
                <!-- IMAGEM -->
                <div class="text-center">

                    <img src="@despesaSelecionada.AnexoCaminho"
                         style="
                            max-width:100%;
                            max-height:75vh;
                            border-radius:12px;
                            object-fit:contain;
                            " />

                </div>
            }

        </div>

    </div>
}
@code {

    [Parameter]
    public Guid? DespesaId { get; set; }

    private List<Despesa> listaDespesas = new();

    private string pesquisa = "";
    private string categoriaFiltro = "";
    private Financeiro.FinanceStatus? statusFiltro = null;
    private string ordemValor = "";

    private DateTime? dataInicial;
    private DateTime? dataFinal;

    private int paginaDescontos = 1;
    private int paginaExtras = 1;

    private const int itensPorPaginaDetalhes = 5;

    private bool mostrarModalDespesa = false;
    private bool animarModal = false;

    private string abaAtiva = "detalhes";

    private bool mostrarComprovante = false;

    private Despesa? despesaSelecionada;

    private IBrowserFile? comprovanteGestao;

    private IEnumerable<Financeiro.Desconto> DescontosPaginados =>
    despesaSelecionada?.Descontos
        .Skip((paginaDescontos - 1) * itensPorPaginaDetalhes)
        .Take(itensPorPaginaDetalhes);
    private IEnumerable<Financeiro.Extras> ExtrasPaginados =>
    despesaSelecionada?.Bonus
        .Skip((paginaExtras - 1) * itensPorPaginaDetalhes)
        .Take(itensPorPaginaDetalhes);

    private List<string> categoriasDisponiveis =>
        listaDespesas
            .Select(d => d.Categoria)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct()
            .OrderBy(c => c)
            .ToList();

    private IEnumerable<Despesa> DespesasFiltradas
    {
        get
        {
            var query = listaDespesas.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(pesquisa))
            {
                query = query.Where(d =>
                    (d.Descricao?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (d.Fornecedor?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (d.Categoria?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }

            if (!string.IsNullOrWhiteSpace(categoriaFiltro))
            {
                query = query.Where(d =>
                    d.Categoria == categoriaFiltro);
            }

            if (statusFiltro != null)
            {
                query = query.Where(d => d.Status == statusFiltro);
            }

            if (dataInicial.HasValue)
            {
                query = query.Where(d =>
                    d.DataVencimento.Date >= dataInicial.Value.Date);
            }

            if (dataFinal.HasValue)
            {
                query = query.Where(d =>
                    d.DataVencimento.Date <= dataFinal.Value.Date);
            }

            query = ordemValor switch
            {
                "asc" => query.OrderBy(d => d.GetValorTotal()),
                "desc" => query.OrderByDescending(d => d.GetValorTotal()),
                _ => query.OrderBy(d => d.DataVencimento)
            };

            return query;
        }
    }

    protected override void OnInitialized()
    {
        CarregarDespesas();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && DespesaId != null)
        {
            despesaSelecionada = DespesaController.Get(DespesaId.ToString(), null);

            if (despesaSelecionada != null)
            {
                await AbrirModal(despesaSelecionada);
            }
        }
    }

    private void CarregarDespesas()
    {
        listaDespesas =
            DespesaController.GetAll()
                .OrderBy(d => d.DataVencimento)
                .ToList();
    }

    private async Task AbrirModal(Despesa despesa)
    {
        despesaSelecionada = despesa;

        abaAtiva = "detalhes";

        mostrarModalDespesa = true;

        animarModal = false;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(50);

        animarModal = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharModal()
    {
        animarModal = false;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(200);

        mostrarModalDespesa = false;

        despesaSelecionada = null;
    }

    private void AdicionarDesconto()
    {
        despesaSelecionada?.Descontos.Add(new Financeiro.Desconto());
    }

    private void RemoverDesconto(Financeiro.Desconto desconto)
    {
        despesaSelecionada?.Descontos.Remove(desconto);
    }

    private void AdicionarExtra()
    {
        despesaSelecionada?.Bonus.Add(new Financeiro.Extras());
    }

    private void RemoverExtra(Financeiro.Extras extra)
    {
        despesaSelecionada?.Bonus.Remove(extra);
    }

    private void SelecionarComprovanteGestao(
        InputFileChangeEventArgs e)
    {
        comprovanteGestao = e.File;
    }

    private async Task SalvarComprovanteGestao()
    {
        if (despesaSelecionada == null ||
            comprovanteGestao == null)
            return;

        var caminho =
            await FileService
                .SalvarComprovante(comprovanteGestao);

        despesaSelecionada.AnexoCaminho = caminho;

        comprovanteGestao = null;

        StateHasChanged();
    }

    private void AbrirModalNovaDespesa()
    {
        Navigation.NavigateTo("/nova-despesa");
    }

    private void IrParaFinanceiro(Despesa despesa)
    {
        Navigation.NavigateTo($"/financeiro/pagamento/{despesa.Id}");
    }
    private void RemoverComprovante()
    {
        if (despesaSelecionada == null)
            return;

        FileService.RemoverArquivo(
            despesaSelecionada.AnexoCaminho);

        despesaSelecionada.AnexoCaminho = null;

        StateHasChanged();
    }

}