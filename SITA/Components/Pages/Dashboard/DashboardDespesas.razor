@page "/despesas"
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Storage
@inject NavigationManager Navigation



<div class="header-despesas">
    <h1>Gestão de Despesas</h1>

    <button @onclick="AbrirModalNovaDespesa">
        + Cadastrar Nova Despesa
    </button>
</div>

   <div class="conteiner">
    <div class="area-financeira">

        <!-- FILTROS LATERAIS -->
        <aside class="filtros">
            <div class="filtro">
                <label>Pesquisar</label>

                <input placeholder="Nome, fornecedor ou item..." @bind="pesquisa" @bind:event="oninput" />
            </div>

            <div class="filtro">
                <label>Categoria</label>

                <select @bind="categoriaFiltro">
                    <option value="">Todas</option>

                    @foreach (var categoria in categoriasDisponiveis)
                    {
                        <option value="@categoria">@categoria</option>
                    }
                </select>
            </div>

            <div class="filtro">
                <label>Status</label>

                <select @bind="statusFiltro">
                    <option value="">Todos</option>
                    <option value="Pago">Pago</option>
                    <option value="Pendente">Pendente</option>
                </select>
            </div>

            <div class="filtro">
                <label>Data Inicial</label>

                <input type="date" @bind="dataInicial" />
            </div>

            <div class="filtro">
                <label>Data Final</label>

                <input type="date" @bind="dataFinal" />
            </div>

            <div class="filtro">
                <label>Ordenar Valor</label>

                <select @bind="ordemValor">
                    <option value="">Padrão</option>
                    <option value="asc">Menor → Maior</option>
                    <option value="desc">Maior → Menor</option>
                </select>
            </div>
        </aside>

        <!-- CONTEÚDO DO LADO DIREITO -->
        <div class="conteudo-financeiro">
            <div class="tabela-container">
                <table class="tabla">
                    <thead class="Theader">
                        <tr>
                            <th>Data</th>
                            <th>Tipo</th>
                            <th>Discrição</th>
                            <th>Valor</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (listaDespesas == null || !listaDespesas.Any())
                        {
                            <tr>
                                <td colspan="5" class="sem-registro">
                                    Nenhuma despesa registrada.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var despesa in DespesasFiltradas)
                            {
                                <tr>
                                    <td>@despesa.DataVencimento.ToString("dd/MM/yyyy")</td>
                                    <td>@despesa.Categoria</td>
                                    <td class="descricao">@despesa.Descricao</td>
                                    <td class="valor-despesa">R$ @despesa.GetValorTotal().ToString("N2")</td>
                                    <td>@(despesa.IsPago() ? "Pago" : "Pendente")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>
</div>
  
<style>
    .header-despesas {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 18px 40px 18px;
    }

    .header-despesas h1 {
        margin: 0;
        color: #3650a1;
        font-size: 40px;
        font-weight: bold;
    }

    .header-despesas button {
        width: 250px;
        height: 44px;
        border: none;
        border-radius: 5px;
        background-color: #3650a1;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

    .header-despesas button:hover {
        background-color: #2d4388;
    }

    .conteiner {
        width: 95%;
        max-width: 1450px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
    }

    .area-financeira {
        width: 100%;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 25px;
    }

    .filtros {
        width: 280px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 22px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .filtro {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filtro label {
        font-weight: bold;
        color: #333;
    }

    .filtro input,
    .filtro select {
        width: 100%;
        height: 42px;
        padding: 0 12px;
        font-size: 15px;
        border: 1px solid #ccc;
        border-radius: 8px;
        outline: none;
        background-color: white;
    }

    .filtro input:focus,
    .filtro select:focus {
        border-color: #3650a1;
    }

    .conteudo-financeiro {
        flex: 1;
        min-width: 0;
        background-color: #ffffff;
        border-radius: 10px;
        padding: 15px;
    }

    .tabla {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .Theader {
        color: white;
        background-color: #3650a1;
    }

    .Theader th {
        height: 48px;
        padding: 0 10px;
        text-align: center;
        font-size: 20px;
        font-weight: bold;
    }

    .tabla td {
        height: 48px;
        padding: 0 10px;
        text-align: center;
        font-size: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

    .tabla tbody tr:hover {
        background-color: #f4f7f6;
    }

    .tabla td:nth-child(3) {
        word-break: break-word;
        white-space: normal;
    }

    .tabla td:nth-child(4) {
        font-weight: bold;
  
    }

    .header {
        padding: 13px 30px;
        width: 100%;
        display: flex;
        justify-content: space-between;
    }

    .quadrados {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: center;
        flex-wrap: wrap;
        gap: 30px;
        padding: 40px 20px;
        margin: 0 auto;
    }

    .lancamento {
        width: 100%;
        min-height: 320px;
        height: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
    }

    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 20px;
        color: white;
        font-size: 15px;
        border-radius: 10px;
        background: linear-gradient(90deg, #2b7fc3, #1e3c72);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .GetValorTotal() {
        font-weight: bold;
    }


</style>
  

@code {
    private List<Despesa> listaDespesas = new();

    private string pesquisa = "";
    private string categoriaFiltro = "";
    private string statusFiltro = "";
    private string ordemValor = "";

    private DateTime? dataInicial;
    private DateTime? dataFinal;

    private List<string> categoriasDisponiveis => listaDespesas.Select(d => d.Categoria)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    private IEnumerable<Despesa> DespesasFiltradas
    {
        get
        {
            var query = listaDespesas.AsEnumerable();

            // PESQUISA
            if (!string.IsNullOrWhiteSpace(pesquisa))
            {
                query = query.Where(d =>
                    (d.Descricao?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (d.Fornecedor?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (d.Categoria?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }

            // CATEGORIA
            if (!string.IsNullOrWhiteSpace(categoriaFiltro))
            {
                query = query.Where(d => d.Categoria == categoriaFiltro);
            }

            // STATUS
            if (statusFiltro == "Pago")
            {
                query = query.Where(d => d.IsPago());
            }
            else if (statusFiltro == "Pendente")
            {
                query = query.Where(d => !d.IsPago());
            }

            // DATA INICIAL
            if (dataInicial.HasValue)
            {
                query = query.Where(d =>
                    d.DataVencimento.Date >= dataInicial.Value.Date);
            }

            // DATA FINAL
            if (dataFinal.HasValue)
            {
                query = query.Where(d =>
                    d.DataVencimento.Date <= dataFinal.Value.Date);
            }

            // ORDENAÇÃO VALOR
            query = ordemValor switch
            {
                "asc" => query.OrderBy(d => d.GetValorTotal()),
                "desc" => query.OrderByDescending(d => d.GetValorTotal()),
                _ => query.OrderBy(d => d.DataVencimento)
            };

            return query;
        }
    }
        

    protected override void OnInitialized() => CarregarDespesas();

    private void CarregarDespesas()
    {
        try
        {
            listaDespesas = DespesaController.GetAll()
                 .OrderBy(d => d.DataVencimento)
                 .ToList();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Erro SITA: {ex.Message}");
        }
    }

    private void AbrirModalNovaDespesa() => Navigation.NavigateTo("/nova-despesa");

    private void IrParaFinanceiro(Despesa despesa)
    {
        Navigation.NavigateTo($"/folha-pagamento/despesas/{despesa.Id}#despesa-section");
    }
}