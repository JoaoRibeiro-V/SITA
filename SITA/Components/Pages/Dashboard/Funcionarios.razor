@page "/funcionarios/{FuncionarioId:guid?}"
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Storage
@using SITA.src.Util
@inject NavigationManager Navigation

<div class="header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
    <h1 style="color: #3650a1; font-weight: bold;">Colaboradores Cadastrados</h1>

    <div style="display: flex; gap: 10px;">

        <button class="btn-cadastrar"
                @onclick='() => Navigation.NavigateTo("/cadastro-funcionario")'
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Novo Colaborador
        </button>

        <input @bind="search"
               @bind:event="oninput"
               placeholder="Pesquisar colaborador..."
               style="padding: 8px; border-radius: 5px; border: 1px solid #ccc;" />
    </div>
</div>

<section style="padding: 20px; width:100%">

    <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">

        <thead>
            <tr style="color: white;">
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-left-radius: 8px;">Nome</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">CPF</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Cargo</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">Telefone</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1;">E-mail</th>
                <th style="padding: 15px 12px; text-align: left; background: #3650a1; border-top-right-radius: 8px;">Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var funcionario in funcionariosFiltrados)
            {
                <tr @onclick="() => AbrirModalFuncionario(funcionario)"
                    style="cursor: pointer; background: transparent;">

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @funcionario.Nome
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @FormatarCpf(funcionario.CPF)
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @funcionario.Cargo
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @funcionario.Telefone
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @funcionario.Email
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 2px solid #3650a1;">
                        @(funcionario.Ativo ? "Ativo" : "Inativo")
                    </td>

                </tr>
            }
        </tbody>

    </table>

</section>

@if (mostrarModalFuncionario && funcionarioSelecionado != null)
{
    <div class="overlay-modal">
        <div class="modal-aluno @(animarModal ? "modal-aberta" : "")">

            <div class="modal-topo">
                <h2>@funcionarioSelecionado.Nome</h2>

                <button class="btn-fechar" @onclick="FecharModalFuncionario">
                    ×
                </button>
            </div>

            <br />

            <div class="abas-modal">
                <button class="@(abaAtiva == "ficha" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "ficha"'>
                    Ficha do Colaborador
                </button>

                <button class="@(abaAtiva == "pagamento" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "pagamento"'>
                    Pagamento
                </button>
            </div>

            <div class="conteudo-modal">

                @if (abaAtiva == "ficha")
                {
                    <div class="ficha-container">

                        <div class="ficha-titulo">
                            <h2>FICHA DO COLABORADOR</h2>
                        </div>

                        <div class="linha">
                            <div class="campo campo-grande">
                                <label>Nome Completo:</label>
                                <input @bind="Nome"
                                       @bind:event="oninput"
                                       disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-medio">
                                <label>CPF:</label>
                                <input @bind="CPF"
                                       @bind:event="oninput"
                                       disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-medio">
                                <label>Cargo:</label>
                                <input @bind="Cargo"
                                       @bind:event="oninput"
                                       disabled="@(!modoEdicao)" />
                            </div>
                        </div>

                        <div class="linha">
                            <div class="campo campo-terco">
                                <label>Telefone:</label>
                                <input @bind="Telefone"
                                       @bind:event="oninput"
                                       disabled="@(!modoEdicao)" />
                            </div>

                            <div class="campo campo-terco">
                                <label>E-mail:</label>
                                <input @bind="Email"
                                       @bind:event="oninput"
                                       disabled="@(!modoEdicao)" />
                            </div>
                            <div class="campo campo-terco">
                                <label>Status:</label>

                                @if (modoEdicao)
                                {
                                    <select value="@Ativo.ToString().ToLower()"
                                            @onchange="AlterarStatusFuncionario">
                                        <option value="true">Ativo</option>
                                        <option value="false">Inativo</option>
                                    </select>
                                }
                                else
                                {
                                    <input value="@(Ativo ? "Ativo" : "Inativo")" readonly />
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(msgErro))
                        {
                            <div class="alert alert-danger mt-3">
                                @msgErro
                            </div>
                        }

                        <div class="d-flex gap-3 mt-4">
                            @if (modoEdicao)
                            {
                                <button class="btn btn-outline-secondary w-25 p-3 fw-bold"
                                        @onclick="CancelarEdicaoFuncionario">
                                    CANCELAR
                                </button>

                                <button class="btn w-75 p-3 fw-bold"
                                        style="background-color: #3650a1; color: white;"
                                        @onclick="SalvarFuncionario">
                                    SALVAR
                                </button>
                            }
                            else
                            {
                                <button class="btn w-100 p-3 fw-bold"
                                        style="background-color: #3650a1; color: white;"
                                        @onclick="HabilitarEdicaoFuncionario">
                                    EDITAR
                                </button>
                            }
                        </div>

                    </div>
                }

                @if (abaAtiva == "pagamento")
                {
                    <div class="ficha-container">

                        <div class="ficha-titulo">
                            <h2>LANÇAMENTO DE PAGAMENTO</h2>
                        </div>

                        <div class="p-3 mt-2"
                             style="background-color: #f8f9fa; border-radius: 8px; border: 1px dashed #3650a1;">

                            <h5><b>Resumo do Lançamento:</b></h5>

                            <p>
                                Colaborador:
                                <b>@funcionarioSelecionado.Nome</b>
                            </p>

                            <p>
                                Cargo:
                                <b>@funcionarioSelecionado.Cargo</b>
                            </p>

                            <p>
                                Salário Base:
                                <span class="text-success">
                                    R$ @funcionarioSelecionado.SalarioBase.ToString("N2")
                                </span>
                            </p>

                            <div class="row">
                                <div class="col-md-4">
                                    <label><b>Mês de Referência:</b></label>
                                    <input type="month"
                                           class="form-control"
                                           @bind="mesReferencia" />
                                </div>

                                <div class="col-md-4">
                                    <label>Bônus/Extras:</label>
                                    <input type="number"
                                           class="form-control"
                                           @bind="bonus" />
                                </div>

                                <div class="col-md-4">
                                    <label>Descontos:</label>
                                    <input type="number"
                                           class="form-control"
                                           @bind="descontos" />
                                </div>
                            </div>

                            <h4 class="mt-3">
                                Total:
                                <b>R$ @CalcularTotal().ToString("N2")</b>
                            </h4>

                            <button class="btn btn-success w-100 mt-3"
                                    @onclick="GerarPagamento">
                                CONFIRMAR PAGAMENTO
                            </button>

                        </div>

                        @if (!string.IsNullOrEmpty(feedbackMsg))
                        {
                            <div class="alert alert-info mt-3">
                                @feedbackMsg
                            </div>
                        }

                    </div>
                }

            </div>
        </div>
    </div>
}


<style>
