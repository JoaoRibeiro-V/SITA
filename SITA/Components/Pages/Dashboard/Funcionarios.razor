@code {
    [Parameter] public Guid? FuncionarioId { get; set; }

    private List<Funcionario> funcionarios = new();

    private string search = "";

    private IEnumerable<Funcionario> funcionariosFiltrados =>
        funcionarios.Where(f =>
            string.IsNullOrWhiteSpace(search) ||
            (f.Nome?.ToLower().Contains(search.ToLower()) ?? false) ||
            (f.CPF?.Contains(search) ?? false) ||
            (f.Cargo?.ToLower().Contains(search.ToLower()) ?? false));

    private bool mostrarModalFuncionario = false;
    private bool animarModal = false;
    private bool modoEdicao = false;

    private string abaAtiva = "ficha";

    private Funcionario? funcionarioSelecionado;

    private string Nome = "";
    private string CPF = "";
    private string Cargo = "";
    private string Telefone = "";
    private string Email = "";
    private bool Ativo = true;

    private DateTime mesReferencia = DateTime.Now;
    private decimal bonus = 0;
    private decimal descontos = 0;

    private string msgErro = "";
    private string feedbackMsg = "";

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        funcionarios = FuncionarioController.GetAll()
            .OrderBy(f => f.Nome)
            .ToList();

        if (FuncionarioId != null)
        {
            funcionarioSelecionado = funcionarios
                .FirstOrDefault(f => f.Id == FuncionarioId.Value);

            if (funcionarioSelecionado != null)
            {
                CarregarDadosFuncionario();
                mostrarModalFuncionario = true;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && FuncionarioId != null)
        {
            var funcionario = funcionarios
                .FirstOrDefault(f => f.Id == FuncionarioId.Value);

            if (funcionario != null)
            {
                await AbrirModalFuncionario(funcionario);
            }
        }
    }

    private async Task AbrirModalFuncionario(Funcionario funcionario)
    {
        funcionarioSelecionado = funcionario;

        mostrarModalFuncionario = true;
        animarModal = false;
        modoEdicao = false;
        abaAtiva = "ficha";

        bonus = 0;
        descontos = 0;
        feedbackMsg = "";
        msgErro = "";

        CarregarDadosFuncionario();

        await InvokeAsync(StateHasChanged);

        await Task.Delay(50);

        animarModal = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharModalFuncionario()
    {
        animarModal = false;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(200);

        mostrarModalFuncionario = false;
        funcionarioSelecionado = null;
        modoEdicao = false;
        feedbackMsg = "";
        msgErro = "";
    }

    private void CarregarDadosFuncionario()
    {
        if (funcionarioSelecionado == null) return;

        Nome = funcionarioSelecionado.Nome ?? "";
        CPF = FormatarCpf(funcionarioSelecionado.CPF ?? "");
        Cargo = funcionarioSelecionado.Cargo ?? "";
        Telefone = funcionarioSelecionado.Telefone ?? "";
        Email = funcionarioSelecionado.Email ?? "";
        Ativo = funcionarioSelecionado.Ativo;
    }

    private void HabilitarEdicaoFuncionario()
    {
        modoEdicao = true;
    }

    private void CancelarEdicaoFuncionario()
    {
        modoEdicao = false;
        msgErro = "";
        CarregarDadosFuncionario();
    }

    private void SalvarFuncionario()
    {
        if (funcionarioSelecionado == null) return;

        if (string.IsNullOrWhiteSpace(Nome))
        {
            msgErro = "Nome do funcionário é obrigatório.";
            return;
        }

        if (string.IsNullOrWhiteSpace(CPF))
        {
            msgErro = "CPF do funcionário é obrigatório.";
            return;
        }

        try
        {
            funcionarioSelecionado.Nome = Nome;
            funcionarioSelecionado.CPF = CPF;
            funcionarioSelecionado.Cargo = Cargo;
            funcionarioSelecionado.Telefone = Telefone;
            funcionarioSelecionado.Email = Email;
            funcionarioSelecionado.Ativo = Ativo;

            modoEdicao = false;
            msgErro = "";

            LoadData();
        }
        catch (Exception ex)
        {
            msgErro = "Erro ao salvar funcionário: " + ex.Message;
        }
    }

    private decimal CalcularTotal()
    {
        if (funcionarioSelecionado == null) return 0;

        return funcionarioSelecionado.SalarioBase + bonus - descontos;
    }

    private void GerarPagamento()
    {
        if (funcionarioSelecionado == null) return;

        var salario = new Salario
        {
            Funcionario = funcionarioSelecionado,
            DataReferente = mesReferencia,
            Valor = (float)CalcularTotal(),
            DataEmissao = DateTime.Now
        };

        SalarioController.Register(salario);

        feedbackMsg = "Pagamento registrado com sucesso!";
    }
    private string FormatarCpf(string cpf)
    {
        var numeros = new string((cpf ?? "")
            .Where(char.IsDigit)
            .ToArray());

        if (numeros.Length > 11)
        {
            numeros = numeros[..11];
        }

        if (numeros.Length <= 3)
        {
            return numeros;
        }

        if (numeros.Length <= 6)
        {
            return $"{numeros[..3]}.{numeros[3..]}";
        }

        if (numeros.Length <= 9)
        {
            return $"{numeros[..3]}.{numeros[3..6]}.{numeros[6..]}";
        }

        return $"{numeros[..3]}.{numeros[3..6]}.{numeros[6..9]}-{numeros[9..]}";
    }

    private string ApenasNumeros(string valor)
    {
        return new string((valor ?? "")
            .Where(char.IsDigit)
            .ToArray());
    }

    private void AlterarStatusFuncionario(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();

        Ativo = valor == "true";
    }
}