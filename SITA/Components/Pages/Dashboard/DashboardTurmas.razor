@page "/turmas"
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.Components.Pages.GUI
@inject NavigationManager Navigation

@* Cabeçalho padronizado com a tela de Alunos *@
<div class="header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
    <h1 style="color: #3650a1; font-weight: bold;">Gestão de Turmas</h1>
    <div style="display: flex; gap: 10px;">
        <input @bind="search" @bind:event="oninput" placeholder="Buscar turma..." style="padding: 8px; border-radius: 5px; border: 1px solid #ccc;" />
        <button class="btn-cadastrar" @onclick="AbrirModal"
                style="background-color: #3650a1; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold;">
            + Nova Turma
        </button>
    </div>
</div>

@* Grid de Cards padronizado *@
<section class="container-card" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; padding: 20px;">
    @foreach (var turma in TurmasFiltradas)
    {
        <div class="card" @onclick="() => GoToTurma(turma.Id)"
             style=" height:auto; color:black; background: white; border-radius: 10px; padding: 15px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); border-top: 4px solid #3650a1; cursor: pointer; transition: 0.3s;">
            
            <h4 style="color: #3650a1; font-weight: bold; margin-bottom: 10px;">@turma.Nome</h4>
            
            <p style="margin-bottom: 5px;"><strong>Turno:</strong> @turma.Turno</p>
            <p style="margin-bottom: 5px;"><strong>Professor:</strong> @(turma.Professor?.Nome ?? "A definir")</p>
            <p style="margin-bottom: 5px;"><strong>Alunos:</strong> @turma.Alunos.Count matriculados</p>
            
            <div style="text-align: center; margin-top: 15px; border-top: 1px solid #eee; pt-2">
                <small class="text-muted">Clique para gerenciar</small>
            </div>
        </div>
    }
</section>

@* Modal de Cadastro *@
<Modal IsOpen="showModal" OnClose="FecharModal">
    <div style="padding: 20px;">
        <h3 style="color: #3650a1; font-weight: bold; margin-bottom: 20px;">Nova Turma</h3>
        
        <div class="mb-3">
            <label class="fw-bold" style="color: #3650a1;">Nome da Turma:</label>
            <input class="form-control" @bind="nome" placeholder="Ex: Maternal A" style="border: 1px solid #3650a1;" />
        </div>

        <div class="mb-4">
            <label class="fw-bold" style="color: #3650a1;">Período / Turno:</label>
            <select class="form-select" @bind="turno" style="border: 1px solid #3650a1;">
                @foreach (var t in Turma.Turnos)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-success w-100 fw-bold" @onclick="Cadastrar">SALVAR</button>
            <button class="btn btn-outline-secondary w-100" @onclick="FecharModal">CANCELAR</button>
        </div>
    </div>
</Modal>

@code {
    private List<Turma> turmas = new();
    private string search = "";
    private bool showModal = false;
    private string nome = "";
    private string turno = Turma.Turnos[0];

    protected override void OnInitialized()
    {
        turmas = TurmaController.GetAll(); 
    }

    IEnumerable<Turma> TurmasFiltradas =>
        turmas.Where(t =>
            string.IsNullOrWhiteSpace(search) ||
            t.Nome.Contains(search, StringComparison.OrdinalIgnoreCase));

    void AbrirModal() { nome = ""; turno = Turma.Turnos[0]; showModal = true; }
    void FecharModal() => showModal = false;

    void Cadastrar()
    {
        if (string.IsNullOrWhiteSpace(nome)) return;

        var novaTurma = new Turma { Nome = nome, Turno = turno };
        TurmaController.Register(novaTurma); 
        turmas = TurmaController.GetAll();
        showModal = false;
    }

    void GoToTurma(Guid id) => Navigation.NavigateTo($"/turma/{id}");

}