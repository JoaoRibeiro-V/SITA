@page "/receitas/{ReceitaId:guid?}"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Storage
@using SITA.src.Controller
@using SITA.src.Services
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@inject FileService FileService

<div class="pagina-financeiro">
    <div class="header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
        <h1 style="color: #3650a1; font-weight: bold;">Gestão de Turmas</h1>
        <div style="display: flex; gap: 10px;">
        </div>
    </div>

    @if (Session.GetInstanceAccess().Level >= 4)
    {
        <section class="cards-financeiro">

            <div class="card-resumo saldo">
                <h2>Saldo em Caixa</h2>
                <h3>R$ @saldoCaixa.ToString("N2")</h3>
            </div>

            <div class="card-resumo previsao">
                <h2>Previsão</h2>
                <h3>R$ @previsaoReceita.ToString("N2")</h3>
            </div>

            <div class="card-resumo atraso">
                <h2>Inadimplência</h2>
                <h3>R$ @valorAtraso.ToString("N2")</h3>
            </div>

        </section>
    }

    <h1 class="titulo-Receitas">Gestão de Receitas</h1>

    <section class="area-Receitas">

        <!-- FILTROS LATERAIS -->
        <aside class="filtros">

            <div class="filtro">
                <label>Pesquisar</label>
                <input placeholder="Aluno, responsável, origem ou descrição..."
                       @bind="pesquisa"
                       @bind:event="oninput" />
            </div>

            <div class="filtro">
                <label>Tipo</label>
                <select @bind="tipoFiltro">
                    <option value="">Todos</option>

                    @foreach (var tipo in tiposDisponiveis)
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </select>
            </div>

            <div class="filtro">
                <label>Status</label>
                <select @bind="statusFiltro">
                    <option value="">Todos</option>
                    <option value="Pago">Pago</option>
                    <option value="EmAndamento">Em Andamento</option>
                    <option value="EmAtraso">Em Atraso</option>
                </select>
            </div>

            <div class="filtro">
                <label>Data Inicial</label>
                <input type="date" @bind="dataInicio" />
            </div>

            <div class="filtro">
                <label>Data Final</label>
                <input type="date" @bind="dataFim" />
            </div>

            <div class="filtro">
                <label>Ordenar Valor</label>
                <select @bind="ordemValor">
                    <option value="">Padrão</option>
                    <option value="asc">Menor → Maior</option>
                    <option value="desc">Maior → Menor</option>
                </select>
            </div>

        </aside>

        <!-- TABELA -->
        <div class="conteudo-tabela">

            <table class="tabela-Receitas">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!ReceitasPaginadas.Any())
                    {
                        <tr>
                            <td colspan="5" class="sem-registro">
                                Nenhuma Receita encontrada.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in ReceitasPaginadas)
                        {
                            <tr class="linha-clicavel"
                                @onclick="() => AbrirModal(item)">
                                <td>
                                    @item.DataReferente.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="badge @GetTipoBadge(item.Type)">
                                        @item.GetTypeTexto()
                                    </span>
                                </td>

                                <td class="descricao">
                                    <strong>@item.Descricao</strong>

                                    <small>
                                        @(item.Aluno?.Nome
                                            ?? item.Responsavel?.Nome
                                            ?? item.Origem)
                                    </small>
                                </td>

                                <td class="valor">
                                    @if (Session.GetInstanceAccess().Level >= 4)
                                    {
                                        <span>R$ @item.GetValorTotal().ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span>R$ XX.XX</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @GetStatusBadge(item.Status)">
                                        @item.GetStatusTexto()
                                    </span>
                                </td>

                               
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- PAGINAÇÃO -->
            <div class="paginacao">

                <button class="btn-pagina-seta"
                        disabled="@(paginaAtual == 1)"
                        @onclick="() => MudarPagina(paginaAtual - 1)">
                    ‹
                </button>

                @foreach (var p in GetPaginasVisiveis())
                {
                    if (p == null)
                    {
                        <span class="reticencias">...</span>
                    }
                    else
                    {
                        <button class="btn-pagina @(paginaAtual == p ? "pagina-ativa" : "")"
                                @onclick="() => MudarPagina(p.Value)">
                            @p
                        </button>
                    }
                }

                <button class="btn-pagina-seta"
                        disabled="@(paginaAtual == totalPaginas)"
                        @onclick="() => MudarPagina(paginaAtual + 1)">
                    ›
                </button>

            </div>

        </div>

    </section>

</div>

<div class="overlay-modal @(mostrarModalReceita ? "overlay-aberto" : "overlay-fechado")">
    <div class="modal-receita @(animarModal ? "modal-aberta" : "")">
        @if (receitaSelecionada != null)
        {
            <div class="modal-topo">
                <h2>@receitaSelecionada.GetTypeTexto()</h2>

                <button class="btn-fechar" @onclick="FecharModal">
                    ×
                </button>
            </div>
            <br />
            <div class="abas-modal">
                <button class="@(abaAtiva == "detalhes" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "detalhes"'>
                    Detalhes
                </button>

                <button class="@(abaAtiva == "gestao" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "gestao"'>
                    Gestão
                </button>
            </div>

            <div class="conteudo-modal">
                @if (abaAtiva == "detalhes")
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h5 style="font-weight: bold; margin: 0;">
                            Detalhes da Receita
                        </h5>

                    </div>
                    <div style="background-color: #f0f0f0; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #28a745;">

                    

                        <div class="row mt-3">

                            <div class="col-md-6">

                                <p><strong>Descrição:</strong> @receitaSelecionada.Descricao</p>

                                <p><strong>Tipo:</strong> @receitaSelecionada.GetTypeTexto()</p>

                                <p><strong>Aluno:</strong> @receitaSelecionada.Aluno?.Nome</p>
                                <p>
                                    <strong>Responsável:</strong>
                                    @receitaSelecionada.Responsavel?.Nome
                                </p>

                            </div>

                            <div class="col-md-6">
                                <p>
                                    <strong>Data Referente:</strong>
                                    @receitaSelecionada.DataReferente.ToString("dd/MM/yyyy")
                                </p>
                                @if (receitaSelecionada.IsPago())
                                {
                                    <p>
                                        <strong>Data Pagamento:</strong>
                                        @receitaSelecionada.DataPagamento?.ToString("dd/MM/yyyy")
                                    </p>
                                }
                                <p>
                                    <strong>Vencimento:</strong>
                                    @receitaSelecionada.DataVencimento.ToString("dd/MM/yyyy")
                                </p>

                                <p>
                                    <strong>Valor:</strong>

                                    <span class="text-success fw-bold">
                                        R$ @receitaSelecionada.GetValorTotal().ToString("N2")
                                    </span>
                                </p>

                                <p>
                                    <strong>Status:</strong>

                                    <span class="badge @GetStatusBadge(receitaSelecionada.Status)">
                                        @receitaSelecionada.GetStatusTexto()
                                    </span>
                                </p>

                            </div>

                        </div>

                    

                    </div>

                    <div class="mt-2">
                        <small><strong>Descontos</strong></small><br />

                        @if (receitaSelecionada.Descontos.Count == 0)
                        {
                            <small class="text-muted">
                                Nenhum desconto encontrado
                            </small>
                        }

                        @foreach (Financeiro.Desconto desconto in DescontosPaginados)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom"
                                 style="font-size: 0.85rem;">

                                <span class="text-truncate"
                                      style="max-width: 75%;">
                                    @desconto.Descricao
                                </span>

                                <span class="text-danger fw-bold">
                                    - @(desconto.Tipo == Financeiro.Desconto.TipoValor.Percentual
                                                                                            ? $"{desconto.Valor:N0}%"
                                                                                            : $"R$ {desconto.Valor:N2}")
                                </span>

                            </div>
                        }

                    </div>
                    @if (receitaSelecionada.Descontos.Count > itensPorPaginaDetalhes)
                    {
                        <div class="d-flex justify-content-end gap-1 mt-2">

                            <button class="btn btn-sm btn-light px-2 py-0"
                                    disabled="@(paginaDescontos == 1)"
                                    @onclick="() => paginaDescontos--">
                                ‹
                            </button>

                            <small class="align-self-center">
                                @paginaDescontos
                            </small>

                            <button class="btn btn-sm btn-light px-2 py-0"
                                    disabled="@(paginaDescontos >= Math.Ceiling((double)receitaSelecionada.Descontos.Count / itensPorPaginaDetalhes))"
                                    @onclick="() => paginaDescontos++">
                                ›
                            </button>

                        </div>
                    }

                    <div class="mt-2">
                        <small><strong>Extras</strong></small><br />
                        @if (receitaSelecionada.Bonus.Count == 0)
                        {
                            <small class="text-muted">
                                Nenhum extra encontrado
                            </small>
                        }

                        @foreach (Financeiro.Extras extra in ExtrasPaginados)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom"
                                 style="font-size: 0.85rem;">

                                <span class="text-truncate"
                                      style="max-width: 75%;">
                                    @extra.Descricao
                                </span>

                                <span class="text-success fw-bold">
                                    + @(extra.Tipo == Financeiro.Extras.TipoValor.Percentual
                                                                                            ? $"{extra.Valor:N0}%"
                                                                                            : $"R$ {extra.Valor:N2}")
                                </span>

                            </div>
                        }

                    </div>
                    @if (receitaSelecionada.Bonus.Count > itensPorPaginaDetalhes)
                    {
                        <div class="d-flex justify-content-end gap-1 mt-2">

                            <button class="btn btn-sm btn-light px-2 py-0"
                                    disabled="@(paginaExtras == 1)"
                                    @onclick="() => paginaExtras--">
                                ‹
                            </button>

                            <small class="align-self-center">
                                @paginaExtras
                            </small>

                            <button class="btn btn-sm btn-light px-2 py-0"
                                    disabled="@(paginaExtras >= Math.Ceiling((double)receitaSelecionada.Bonus.Count / itensPorPaginaDetalhes))"
                                    @onclick="() => paginaExtras++">
                                ›
                            </button>

                        </div>
                    }
                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h5 style="font-weight: bold; margin: 0;">
                            Comprovante
                        </h5>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => mostrarComprovante = true">

                            Ver Comprovante

                        </button>
                    }
                    else
                    {
                        <small class="text-muted">
                            Nenhum comprovante enviado.
                        </small>
                    }

                }
                else if (abaAtiva == "gestao")
                {
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 style="font-weight: bold; margin: 0;">
                            Gestão da Receita
                        </h5>
                    </div>

                    <!-- DESCONTOS -->
                    <div class="card border-0 shadow-sm p-3 mb-4"
                         style="border-radius: 12px;">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold m-0">
                                Descontos
                            </h6>

                            <button class="btn btn-success btn-sm"
                                    style="
                                width: 28px;
                                height: 28px;
                                padding: 0;
                                border-radius: 8px;
                                font-size: 1rem;
                                line-height: 1;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                "
                                    @onclick="AdicionarDesconto">
                                +
                            </button>
                        </div>

                        @if (receitaSelecionada.Descontos.Count == 0)
                        {
                            <small class="text-muted">
                                Nenhum desconto cadastrado.
                            </small>
                        }

                        @foreach (var desconto in receitaSelecionada.Descontos)
                        {
                            <div class="d-flex gap-2 align-items-center mb-2">

                                <input class="form-control form-control-sm"
                                       placeholder="Descrição"
                                       style="font-size: 0.82rem;"
                                       @bind="desconto.Descricao" />

                                <select class="form-select form-select-sm"
                                        style="width: 70px;"
                                        @bind="desconto.Tipo">

                                    <option value="@Financeiro.Desconto.TipoValor.Fixo">
                                        R$
                                    </option>

                                    <option value="@Financeiro.Desconto.TipoValor.Percentual">
                                        %
                                    </option>

                                </select>

                                <input class="form-control form-control-sm"
                                       type="number"
                                       step="0.01"
                                       style="width: 90px;"
                                       @bind="desconto.Valor" />

                                <button class="btn btn-danger btn-sm"
                                        style="
                                    width: 28px;
                                    height: 28px;
                                    padding: 0;
                                    border-radius: 8px;
                                    font-size: 0.9rem;
                                    line-height: 1;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    flex-shrink: 0;
                                    "
                                        @onclick="() => RemoverDesconto(desconto)">
                                    ×
                                </button>

                            </div>
                        }
                    </div>

                    <!-- EXTRAS -->
                    <div class="card border-0 shadow-sm p-3 mb-4"
                         style="border-radius: 12px;">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold m-0">
                                Extras
                            </h6>

                            <button class="btn btn-success btn-sm"
                                    style="
                                width: 28px;
                                height: 28px;
                                padding: 0;
                                border-radius: 8px;
                                font-size: 1rem;
                                line-height: 1;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                "
                                    @onclick="AdicionarExtra">
                                +
                            </button>
                        </div>

                        @if (receitaSelecionada.Bonus.Count == 0)
                        {
                            <small class="text-muted">
                                Nenhum extra cadastrado.
                            </small>
                        }

                        @foreach (var extra in receitaSelecionada.Bonus)
                        {
                            <div class="d-flex gap-2 align-items-center mb-2">

                                <input class="form-control form-control-sm"
                                       placeholder="Descrição"
                                       style="font-size: 0.82rem;"
                                       @bind="extra.Descricao" />

                                <select class="form-select form-select-sm"
                                        style="width: 70px;"
                                        @bind="extra.Tipo">

                                    <option value="@Financeiro.Extras.TipoValor.Fixo">
                                        R$
                                    </option>

                                    <option value="@Financeiro.Extras.TipoValor.Percentual">
                                        %
                                    </option>

                                </select>

                                <input class="form-control form-control-sm"
                                       type="number"
                                       step="0.01"
                                       style="width: 90px;"
                                       @bind="extra.Valor" />

                                <button class="btn btn-danger btn-sm"
                                        style="
                                    width: 28px;
                                    height: 28px;
                                    padding: 0;
                                    border-radius: 8px;
                                    font-size: 0.9rem;
                                    line-height: 1;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    flex-shrink: 0;
                                    "
                                        @onclick="() => RemoverExtra(extra)">
                                    ×
                                </button>

                            </div>
                        }
                    </div>

                    <!-- RESUMO -->
                    <div class="card border-0 shadow-sm p-4 mb-4"
                         style="border-radius: 12px; background: #f8f9fa;">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Valor Base:</span>
                            <strong>
                                R$ @receitaSelecionada.Valor.ToString("N2")
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Total Descontos:</span>
                            <strong>
                                - R$ @receitaSelecionada.Descontos.Sum(d => d.GetValorFinal(@receitaSelecionada.Valor)).ToString("N2")
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Total Extras:</span>
                            <strong>
                                + R$ @receitaSelecionada.Bonus.Sum(b => b.GetValorFinal(@receitaSelecionada.Valor)).ToString("N2")
                            </strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <span class="fw-bold">Valor Final:</span>

                            <strong class="text-primary">
                                R$ @receitaSelecionada.GetValorTotal().ToString("N2")
                            </strong>
                        </div>
                    </div>

                    <!-- BOTÃO PAGAMENTO -->
                    @if (receitaSelecionada.Status != Receita.FinanceStatus.Pago)
                    {
                        <button class="btn btn-success w-100 p-3 fw-bold"
                                @onclick="() => GoFinanceiro(receitaSelecionada.Id)">
                            CONFIRMAR PAGAMENTO
                        </button>
                    }
                    else
                    {

                        @if (receitaSelecionada.Status == Receita.FinanceStatus.Pago)
                        {
                            <div class="card border-0 shadow-sm p-3 mt-4"
                                 style="border-radius: 12px;">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div>
                                        <h6 class="fw-bold m-0">
                                            Comprovante
                                        </h6>

                                        @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                                        {
                                            <small class="text-success">
                                                Comprovante enviado
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-warning">
                                                Nenhum comprovante enviado
                                            </small>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                                    {
                                        <button class="btn-ver-comprovante"
                                @onclick="() => mostrarComprovante = true">

                            👁

                        </button>
                                    }

                                </div>

                                <!-- NOVO ARQUIVO -->
                                <InputFile OnChange="SelecionarComprovanteGestao"
                                           class="form-control form-control-sm mb-3" />

                                @if (comprovanteGestao != null)
                                {
                                    <small class="text-success d-block mb-3">
                                        Novo arquivo:
                                        @comprovanteGestao.Name
                                    </small>
                                }

                                <div class="d-flex gap-2">

                                    <!-- SALVAR -->
                                    <button class="btn btn-success btn-sm fw-bold"
                                            disabled="@(comprovanteGestao == null)"
                                            @onclick="SalvarComprovanteGestao">

                                        @(string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho)
                                            ? "SALVAR COMPROVANTE"
                                            : "ALTERAR COMPROVANTE")

                                    </button>

                                    <!-- REMOVER -->
                                    @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                                    {
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="RemoverComprovante">

                                            Remover

                                        </button>
                                    }

                                </div>

                            </div>
                        }
                    }
                }
                else
                {
                    <p>Conteúdo da aba de gestão ainda não implementado.</p>
                }

            </div>

        }

        
    </div>
</div>
@if (mostrarComprovante &&
    !string.IsNullOrWhiteSpace(receitaSelecionada?.AnexoCaminho))
{
    var extensao =
        Path.GetExtension(receitaSelecionada.AnexoCaminho)
            .ToLower();

    <div class="overlay-modal"
         @onclick="() => mostrarComprovante = false">

        <div class="modal-comprovante"
             @onclick:stopPropagation="true">

            <!-- TOPO -->
            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold m-0">
                    Comprovante
                </h5>

                <button class="btn-fechar-comprovante"
                        @onclick="() => mostrarComprovante = false">
                    ×
                </button>

            </div>

            <!-- PDF -->
            @if (extensao == ".pdf")
            {
                <iframe src="@receitaSelecionada.AnexoCaminho"
                        width="100%"
                        height="700px"
                        style="
                    border:none;
                    border-radius:12px;
                    background:white;
                    ">
                </iframe>
            }
            else
            {
                <!-- IMAGEM -->
                <div class="text-center">

                    <img src="@receitaSelecionada.AnexoCaminho"
                         style="
                    max-width:100%;
                    max-height:75vh;
                    border-radius:12px;
                    object-fit:contain;
                    " />

                </div>
            }

        </div>

    </div>
}

<style>
    .linha-clicavel {
        cursor: pointer;
    }

        .linha-clicavel:hover {
            background: #f6f8ff;
        }

    .pagina-financeiro {
        width: 100%;
        padding: 8px 16px 30px 16px;
        box-sizing: border-box;
    }

    .titulo-principal {
        margin: 0 0 42px 8px;
        color: #000;
        font-size: 34px;
        font-weight: bold;
    }

    .cards-financeiro {
        width: 100%;
        display: flex;
        gap: 22px;
        margin-bottom: 40px;
    }

    .card-resumo {
        flex: 1;
        min-height: 115px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 18px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        box-sizing: border-box;
    }

        .card-resumo h2 {
            margin: 0;
            color: #808080;
            font-size: 28px;
            font-weight: bold;
        }

        .card-resumo h3 {
            margin: 2px 0 0 0;
            font-size: 22px;
            font-weight: bold;
        }

    .saldo {
        border-left: 2px solid #16a34a;
    }

        .saldo h3 {
            color: #16a34a;
        }

    .previsao {
        border-left: 2px solid #000080;
    }

        .previsao h3 {
            color: #000080;
        }

    .atraso {
