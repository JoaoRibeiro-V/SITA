@code {
    [Parameter] public Guid? ReceitaId { get; set; }

    private float saldoCaixa = 0;
    private float previsaoReceita = 0;
    private float valorAtraso = 0;
    private bool mostrarModalReceita = false;
    private bool animarModal = false;
    private Receita? receitaSelecionada;

    private int paginaDescontos = 1;
    private int paginaExtras = 1;

    private const int itensPorPaginaDetalhes = 5;

    private IBrowserFile? comprovanteGestao;

    private void SelecionarComprovanteGestao(
    InputFileChangeEventArgs e)
    {
        comprovanteGestao = e.File;
    }

    private async Task SalvarComprovanteGestao()
    {
        if (receitaSelecionada == null ||
            comprovanteGestao == null)
            return;

        var caminho =
            await FileService
                .SalvarComprovante(
                    comprovanteGestao);

        if (string.IsNullOrWhiteSpace(caminho))
            return;

        receitaSelecionada.AnexoCaminho =
            caminho;

        comprovanteGestao = null;

        StateHasChanged();
    }

    private void RemoverComprovante()
    {
        if (receitaSelecionada == null)
            return;

        FileService.RemoverArquivo(
            receitaSelecionada.AnexoCaminho);

        receitaSelecionada.AnexoCaminho = null;

        StateHasChanged();
    }

    private IEnumerable<Financeiro.Desconto> DescontosPaginados =>
    receitaSelecionada.Descontos
        .Skip((paginaDescontos - 1) * itensPorPaginaDetalhes)
        .Take(itensPorPaginaDetalhes);
    private IEnumerable<Financeiro.Extras> ExtrasPaginados =>
    receitaSelecionada.Bonus
        .Skip((paginaExtras - 1) * itensPorPaginaDetalhes)
        .Take(itensPorPaginaDetalhes);

    private string abaAtiva = "detalhes";

    private bool fechandoModal = false;

    private bool mostrarComprovante = false;

    private async Task AbrirModal(Receita receita)
    {
        receitaSelecionada = receita;

        abaAtiva = "detalhes";

        mostrarModalReceita = true;

        animarModal = false;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(50);

        animarModal = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharModal()
    {
        animarModal = false;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(200);

        mostrarModalReceita = false;

        receitaSelecionada = null;
    }

    private List<Receita> todasReceitas = new();

    private string pesquisa = "";
    private string tipoFiltro = "";
    private string statusFiltro = "";
    private string ordemValor = "";

    private DateTime? dataInicio;
    private DateTime? dataFim;

    private int paginaAtual = 1;
    private int itensPorPagina = 8;

    private List<string> tiposDisponiveis =>
        todasReceitas
            .Select(r => r.GetTypeTexto())
            .Distinct()
            .OrderBy(t => t)
            .ToList();

    private IEnumerable<Receita> ReceitasFiltradas
    {
        get
        {
            var query = todasReceitas.AsEnumerable();

            // PESQUISA
            if (!string.IsNullOrWhiteSpace(pesquisa))
            {
                query = query.Where(r =>
                    (r.Descricao?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Origem?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Aluno?.Nome?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Responsavel?.Nome?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }

            // TIPO
            if (!string.IsNullOrWhiteSpace(tipoFiltro))
            {
                query = query.Where(r =>
                    r.GetTypeTexto() == tipoFiltro);
            }

            // STATUS
            if (statusFiltro == "Pago")
            {
                query = query.Where(r =>
                    r.IsPago());
            }
            else if (statusFiltro == "EmAndamento")
            {
                query = query.Where(r =>
                    r.Status == Receita.FinanceStatus.EmAndamento);
            }
            else if (statusFiltro == "EmAtraso")
            {
                query = query.Where(r =>
                    r.Status == Receita.FinanceStatus.EmAtraso);
            }

            // DATA INICIAL
            if (dataInicio.HasValue)
            {
                query = query.Where(r =>
                    r.DataReferente.Date >= dataInicio.Value.Date);
            }

            // DATA FINAL
            if (dataFim.HasValue)
            {
                query = query.Where(r =>
                    r.DataReferente.Date <= dataFim.Value.Date);
            }

            // ORDENAÇÃO
            query = ordemValor switch
            {
                "asc" => query.OrderBy(r => r.GetValorTotal()),
                "desc" => query.OrderByDescending(r => r.GetValorTotal()),
                _ => query.OrderBy(r => r.DataReferente)
            };

            return query;
        }
    }

    private int totalPaginas =>
        (int)Math.Ceiling(
            (double)ReceitasFiltradas.Count() / itensPorPagina);

    private List<Receita> ReceitasPaginadas =>
        ReceitasFiltradas
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    protected override void OnInitialized()
    {
        CarregarDados();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ReceitaId != null)
        {
            receitaSelecionada = ReceitaController.Get(ReceitaId.ToString(), null);

            if (receitaSelecionada != null)
            {
                await AbrirModal(receitaSelecionada);
            }
        }
    }

    private void CarregarDados()
    {
        todasReceitas = ReceitaController.GetAll();

        var todasDespesas = DespesaController.GetAll();

        float ReceitasPagas = todasReceitas
            .Where(r => r.IsPago())
            .Sum(r => (float)r.GetValorTotal());

        float despesasPagas = todasDespesas
            .Where(d => d.IsPago())
            .Sum(d => (float)d.GetValorTotal());

        saldoCaixa = ReceitasPagas - despesasPagas;

        previsaoReceita = todasReceitas
            .Where(r => r.Status == Receita.FinanceStatus.EmAndamento)
            .Sum(r => (float)r.GetValorTotal());

        valorAtraso = todasReceitas
            .Where(r => r.Status == Receita.FinanceStatus.EmAtraso)
            .Sum(r => (float)r.GetValorTotal());
    }

    private void ConfirmarPagamentoReceita(Receita Receita)
    {
        if (Receita == null) return;

        Receita.Status = Receita.FinanceStatus.Pago;
        Receita.DataPagamento = DateTime.Now;
    }

    private void MudarPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= totalPaginas)
        {
            paginaAtual = pagina;
        }
    }

    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++)
                paginas.Add(i);

            return paginas;
        }

        paginas.Add(1);

        if (paginaAtual > 4)
            paginas.Add(null);

        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);

        for (int i = inicio; i <= fim; i++)
            paginas.Add(i);

        if (paginaAtual < totalPaginas - 3)
            paginas.Add(null);

        paginas.Add(totalPaginas);

        return paginas;
    }

    private void IrParaRelatorioReceita(Receita Receita)
    {
        Navigation.NavigateTo($"/folha-pagamento/Receita/{Receita.Id}#Receita-section");
    }

    private void AdicionarDesconto()
    {
        receitaSelecionada?.Descontos.Add(new Financeiro.Desconto());
    }

    private void RemoverDesconto(Financeiro.Desconto desconto)
    {
        receitaSelecionada?.Descontos.Remove(desconto);
    }

    private void AdicionarExtra()
    {
        receitaSelecionada?.Bonus.Add(new Financeiro.Extras());
    }

    private void RemoverExtra(Financeiro.Extras extra)
    {
        receitaSelecionada?.Bonus.Remove(extra);
    }

    private string GetTipoBadge(Receita.ReceitaTipo tipo) => tipo switch
    {
        Receita.ReceitaTipo.Mensalidade => "bg-primary",
        Receita.ReceitaTipo.Aquisicao => "bg-info",
        Receita.ReceitaTipo.Outros => "bg-secondary",
        _ => "bg-dark"
    };

    private string GetStatusBadge(Receita.FinanceStatus status) => status switch
    {
        Receita.FinanceStatus.Pago => "bg-success",
        Receita.FinanceStatus.EmAtraso => "bg-danger",
        Receita.FinanceStatus.EmAndamento => "bg-warning text-dark",
        _ => "bg-secondary"
    };
    void GoFinanceiro(Guid id)
    {
        Navigation.NavigateTo($"/financeiro/pagamento/{id}");
    }
}