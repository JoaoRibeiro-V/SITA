@code {
    [Parameter] public Guid? ReceitaId { get; set; }
    [Parameter] public Guid? DespesaId { get; set; }

    private enum Modo { Receitas, Despesas }
    private Modo modoAtivo = Modo.Receitas;

    private float saldoCaixa, previsaoReceita, valorAtraso;

    private List<Receita> todasReceitas = new();
    private List<Despesa> todasDespesas = new();

    private string abaAtiva = "detalhes";
    private bool mostrarComprovante = false;
    private IBrowserFile? comprovanteGestao;
    private int paginaDescontos = 1;
    private int paginaExtras = 1;
    private const int itensPorPaginaDetalhes = 5;

    private Receita? receitaSelecionada;
    private bool mostrarModalReceita = false;
    private bool animarModalReceita = false;

    private Despesa? despesaSelecionada;
    private bool mostrarModalDespesa = false;
    private bool animarModalDespesa = false;

    // Receita filters
    private string r_pesquisa = "";
    private string r_tipoFiltro = "";
    private string r_statusFiltro = "";
    private string r_ordemValor = "";
    private DateTime? r_dataInicio;
    private DateTime? r_dataFim;
    private int r_paginaAtual = 1;
    private const int itensPorPagina = 8;

    // Despesa filters
    private string d_pesquisa = "";
    private string d_categoriaFiltro = "";
    private string d_statusFiltroStr = "";
    private string d_ordemValor = "";
    private DateTime? d_dataInicio;
    private DateTime? d_dataFim;
    private int d_paginaAtual = 1;


    private List<string> tiposDisponiveisReceita =>
        todasReceitas.Select(r => r.GetTypeTexto()).Distinct().OrderBy(t => t).ToList();

    private IEnumerable<Receita> ReceitasFiltradas
    {
        get
        {
            var q = todasReceitas.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(r_pesquisa))
                q = q.Where(r =>
                    (r.Descricao?.Contains(r_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Origem?.Contains(r_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Aluno?.Nome?.Contains(r_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Responsavel?.Nome?.Contains(r_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false));

            if (!string.IsNullOrWhiteSpace(r_tipoFiltro))
                q = q.Where(r => r.GetTypeTexto() == r_tipoFiltro);

            if (r_statusFiltro == "Pago") q = q.Where(r => r.IsPago());
            else if (r_statusFiltro == "EmAndamento") q = q.Where(r => r.Status == Receita.FinanceStatus.EmAndamento);
            else if (r_statusFiltro == "EmAtraso") q = q.Where(r => r.Status == Receita.FinanceStatus.EmAtraso);

            if (r_dataInicio.HasValue) q = q.Where(r => r.DataReferente.Date >= r_dataInicio.Value.Date);
            if (r_dataFim.HasValue) q = q.Where(r => r.DataReferente.Date <= r_dataFim.Value.Date);

            q = r_ordemValor switch
            {
                "asc" => q.OrderBy(r => r.GetValorTotal()),
                "desc" => q.OrderByDescending(r => r.GetValorTotal()),
                _ => q.OrderBy(r => r.DataReferente)
            };

            return q;
        }
    }

    private int r_totalPaginas =>
        Math.Max(1, (int)Math.Ceiling((double)ReceitasFiltradas.Count() / itensPorPagina));

    private List<Receita> ReceitasPaginadas =>
        ReceitasFiltradas
            .Skip((r_paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    private IEnumerable<Financeiro.Desconto> ReceitaDescontosPaginados =>
        receitaSelecionada?.Descontos
            .Skip((paginaDescontos - 1) * itensPorPaginaDetalhes)
            .Take(itensPorPaginaDetalhes)
        ?? Enumerable.Empty<Financeiro.Desconto>();

    private IEnumerable<Financeiro.Extras> ReceitaExtrasPaginados =>
        receitaSelecionada?.Bonus
            .Skip((paginaExtras - 1) * itensPorPaginaDetalhes)
            .Take(itensPorPaginaDetalhes)
        ?? Enumerable.Empty<Financeiro.Extras>();


    private List<string> categoriasDisponiveis =>
        todasDespesas
            .Select(d => d.Categoria)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct()
            .OrderBy(c => c)
            .ToList();

    private IEnumerable<Despesa> DespesasFiltradas
    {
        get
        {
            var q = todasDespesas.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(d_pesquisa))
                q = q.Where(d =>
                    (d.Descricao?.Contains(d_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (d.Fornecedor?.Contains(d_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (d.Categoria?.Contains(d_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false));

            if (!string.IsNullOrWhiteSpace(d_categoriaFiltro))
                q = q.Where(d => d.Categoria == d_categoriaFiltro);

            if (!string.IsNullOrWhiteSpace(d_statusFiltroStr) &&
                Enum.TryParse<Financeiro.FinanceStatus>(d_statusFiltroStr, out var parsedStatus))
                q = q.Where(d => d.Status == parsedStatus);

            if (d_dataInicio.HasValue) q = q.Where(d => d.DataVencimento.Date >= d_dataInicio.Value.Date);
            if (d_dataFim.HasValue) q = q.Where(d => d.DataVencimento.Date <= d_dataFim.Value.Date);

            q = d_ordemValor switch
            {
                "asc" => q.OrderBy(d => d.GetValorTotal()),
                "desc" => q.OrderByDescending(d => d.GetValorTotal()),
                _ => q.OrderBy(d => d.DataVencimento)
            };

            return q;
        }
    }

    private int d_totalPaginas =>
        Math.Max(1, (int)Math.Ceiling((double)DespesasFiltradas.Count() / itensPorPagina));

    private List<Despesa> DespesasPaginadas =>
        DespesasFiltradas
            .Skip((d_paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    private IEnumerable<Financeiro.Desconto> DespesaDescontosPaginados =>
        despesaSelecionada?.Descontos
            .Skip((paginaDescontos - 1) * itensPorPaginaDetalhes)
            .Take(itensPorPaginaDetalhes)
        ?? Enumerable.Empty<Financeiro.Desconto>();

    private IEnumerable<Financeiro.Extras> DespesaExtrasPaginados =>
        despesaSelecionada?.Bonus
            .Skip((paginaExtras - 1) * itensPorPaginaDetalhes)
            .Take(itensPorPaginaDetalhes)
        ?? Enumerable.Empty<Financeiro.Extras>();


    protected override void OnInitialized()
    {
        if (DespesaId != null) modoAtivo = Modo.Despesas;
        CarregarDados();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (ReceitaId != null)
        {
            modoAtivo = Modo.Receitas;
            var r = ReceitaController.Get(ReceitaId.Value.ToString(), null);
            if (r != null) await AbrirModalReceita(r);
        }
        else if (DespesaId != null)
        {
            modoAtivo = Modo.Despesas;
            var d = DespesaController.Get(DespesaId.Value.ToString(), null);
            if (d != null) await AbrirModalDespesa(d);
        }
    }

    private void AlterarModo(Modo modo)
    {
        if (modoAtivo == modo) return;
        modoAtivo = modo;
        r_paginaAtual = 1;
        d_paginaAtual = 1;
    }

    private void CarregarDados()
    {
        todasReceitas = ReceitaController.GetAll();
        todasDespesas = DespesaController.GetAll().OrderBy(d => d.DataVencimento).ToList();

        float receitasPagas = todasReceitas.Where(r => r.IsPago()).Sum(r => (float)r.GetValorTotal());
        float despesasPagas = todasDespesas.Where(d => d.IsPago()).Sum(d => (float)d.GetValorTotal());

        saldoCaixa = receitasPagas - despesasPagas;
        previsaoReceita = todasReceitas.Where(r => r.Status == Receita.FinanceStatus.EmAndamento).Sum(r => (float)r.GetValorTotal());
        valorAtraso = todasReceitas.Where(r => r.Status == Receita.FinanceStatus.EmAtraso).Sum(r => (float)r.GetValorTotal());
    }

    // Receita modal

    private async Task AbrirModalReceita(Receita receita)
    {
        receitaSelecionada = receita;
        abaAtiva = "detalhes";
        paginaDescontos = 1;
        paginaExtras = 1;
        comprovanteGestao = null;
        mostrarModalReceita = true;
        animarModalReceita = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        animarModalReceita = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharModalReceita()
    {
        animarModalReceita = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        mostrarModalReceita = false;
        receitaSelecionada = null;
        mostrarComprovante = false;
    }

    // Despesa modal

    private async Task AbrirModalDespesa(Despesa despesa)
    {
        despesaSelecionada = despesa;
        abaAtiva = "detalhes";
        paginaDescontos = 1;
        paginaExtras = 1;
        comprovanteGestao = null;
        mostrarModalDespesa = true;
        animarModalDespesa = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        animarModalDespesa = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharModalDespesa()
    {
        animarModalDespesa = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        mostrarModalDespesa = false;
        despesaSelecionada = null;
        mostrarComprovante = false;
    }

    // Receita gestão actions

    private void AdicionarDescontoReceita() => receitaSelecionada?.Descontos.Add(new Financeiro.Desconto());
    private void RemoverDescontoReceita(Financeiro.Desconto d) => receitaSelecionada?.Descontos.Remove(d);
    private void AdicionarExtraReceita() => receitaSelecionada?.Bonus.Add(new Financeiro.Extras());
    private void RemoverExtraReceita(Financeiro.Extras e) => receitaSelecionada?.Bonus.Remove(e);
    private void GoFinanceiro(Guid id) => Navigation.NavigateTo($"/financeiro/pagamento/{id}");

    // Despesa gestão actions

    private void AdicionarDescontoDespesa() => despesaSelecionada?.Descontos.Add(new Financeiro.Desconto());
    private void RemoverDescontoDespesa(Financeiro.Desconto d) => despesaSelecionada?.Descontos.Remove(d);
    private void AdicionarExtraDespesa() => despesaSelecionada?.Bonus.Add(new Financeiro.Extras());
    private void RemoverExtraDespesa(Financeiro.Extras e) => despesaSelecionada?.Bonus.Remove(e);
    private void IrParaFinanceiroDespesa(Despesa d) => Navigation.NavigateTo($"/financeiro/pagamento/{d.Id}");

    // Comprovante

    private void SelecionarComprovanteGestao(InputFileChangeEventArgs e) =>
        comprovanteGestao = e.File;

    private async Task SalvarComprovanteGestao()
    {
        if (comprovanteGestao == null) return;

        var caminho = await FileService.SalvarComprovante(comprovanteGestao);
        if (string.IsNullOrWhiteSpace(caminho)) return;

        if (modoAtivo == Modo.Receitas && receitaSelecionada != null)
            receitaSelecionada.AnexoCaminho = caminho;
        else if (modoAtivo == Modo.Despesas && despesaSelecionada != null)
            despesaSelecionada.AnexoCaminho = caminho;

        comprovanteGestao = null;
        StateHasChanged();
    }

    private void RemoverComprovante()
    {
        if (modoAtivo == Modo.Receitas && receitaSelecionada != null)
        {
            FileService.RemoverArquivo(receitaSelecionada.AnexoCaminho);
            receitaSelecionada.AnexoCaminho = null;
        }
        else if (modoAtivo == Modo.Despesas && despesaSelecionada != null)
        {
            FileService.RemoverArquivo(despesaSelecionada.AnexoCaminho);
            despesaSelecionada.AnexoCaminho = null;
        }
        StateHasChanged();
    }

    // Pagination

    private void MudarPagina(int pagina)
    {
        if (modoAtivo == Modo.Receitas)
        {
            if (pagina >= 1 && pagina <= r_totalPaginas) r_paginaAtual = pagina;
        }
        else
        {
            if (pagina >= 1 && pagina <= d_totalPaginas) d_paginaAtual = pagina;
        }
    }

    private List<int?> GetPaginasVisiveis(int paginaAtual, int totalPaginas)
    {
        var paginas = new List<int?>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++) paginas.Add(i);
            return paginas;
        }

        paginas.Add(1);
        if (paginaAtual > 4) paginas.Add(null);

        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);

        for (int i = inicio; i <= fim; i++) paginas.Add(i);

        if (paginaAtual < totalPaginas - 3) paginas.Add(null);

        paginas.Add(totalPaginas);
        return paginas;
    }

    // Badge CSS

    private string GetTipoBadgeReceita(Receita.ReceitaTipo tipo) => tipo switch
    {
        Receita.ReceitaTipo.Mensalidade => "bg-primary",
        Receita.ReceitaTipo.Aquisicao => "bg-info",
        Receita.ReceitaTipo.Outros => "bg-secondary",
        _ => "bg-dark"
    };

    private string GetStatusBadgeReceita(Receita.FinanceStatus status) => status switch
    {
        Receita.FinanceStatus.Pago => "bg-success",
        Receita.FinanceStatus.EmAtraso => "bg-danger",
        Receita.FinanceStatus.EmAndamento => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeDespesa(Financeiro.FinanceStatus status) => status switch
    {
        Financeiro.FinanceStatus.Pago => "bg-success",
        Financeiro.FinanceStatus.EmAtraso => "bg-danger",
        Financeiro.FinanceStatus.EmAndamento => "bg-warning text-dark",
        Financeiro.FinanceStatus.Pendente => "bg-secondary",
        _ => "bg-secondary"
    };

    // PDF

    private string msgFeedback = "";
    private DateTime dataRelatorioInicio =>
        modoAtivo == Modo.Receitas
            ? (r_dataInicio ?? DateTime.Now.AddMonths(-1))
            : (d_dataInicio ?? DateTime.Now.AddMonths(-1));

    private DateTime dataRelatorioFim =>
        modoAtivo == Modo.Receitas
            ? (r_dataFim ?? DateTime.Now)
            : (d_dataFim ?? DateTime.Now);

    private async Task GerarPdfReceita(Receita receita)
    {
        try
        {
            byte[] pdf = PdfService.GerarRelatorioReceita(receita);
            await DownloadPdf(pdf, $"Receita_{receita.Id.ToString()[..8]}.pdf");
        }
        catch (Exception ex) { msgFeedback = "Erro: " + ex.Message; }
    }

    private async Task GerarPdfDespesa(Despesa despesa)
    {
        try
        {
            byte[] pdf = PdfService.GerarRelatorioDespesa(despesa);
            await DownloadPdf(pdf, $"Despesa_{despesa.Id.ToString()[..8]}.pdf");
        }
        catch (Exception ex) { msgFeedback = "Erro: " + ex.Message; }
    }

    private async Task GerarRelatorioGeral()
    {
        try
        {
            byte[] pdf = PdfService.GerarRelatorioGeral(
                todasReceitas, todasDespesas,
                dataInicio: dataRelatorioInicio,
                dataFim: dataRelatorioFim);
            await DownloadPdf(pdf, $"RelatorioGeral_{DateTime.Now:yyyyMMdd}.pdf");
        }
        catch (Exception ex) { msgFeedback = "Erro: " + ex.Message; }
    }

    private async Task DownloadPdf(byte[] pdf, string nomeArquivo)
    {
        string base64 = Convert.ToBase64String(pdf);
        await JS.InvokeVoidAsync("downloadPdf", base64, nomeArquivo);
    }
}
