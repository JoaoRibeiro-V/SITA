@page "/dashboard-financeiro"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Storage
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="container-fluid" style="background-color: #f4f7f6; min-height: 100vh; padding: 20px;">
    <h2 class="text-center fw-bold mb-4" style="color:#000080;">
        Dashboard Financeiro
    </h2>

    @if(Session.GetInstanceAccess().Level >= 4)
    {
        <!-- CARDS -->
        <div class="row text-center">
            <div class="col-md-4">
                <div class="card shadow-sm border-0" style="border-left: 5px solid #28a745;">
                    <div class="card-body">
                        <h5 class="text-muted">Saldo em Caixa</h5>
                        <h2 class="text-success">R$ @saldoCaixa.ToString("N2")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0" style="border-left: 5px solid #007bff;">
                    <div class="card-body">
                        <h5 class="text-muted">Previsão</h5>
                        <h2 class="text-primary">R$ @previsaoReceita.ToString("N2")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0" style="border-left: 5px solid #dc3545;">
                    <div class="card-body">
                        <h5 class="text-muted">Inadimplência</h5>
                        <h2 class="text-danger">R$ @valorAtraso.ToString("N2")</h2>
                    </div>
                </div>
            </div>
        </div>
    }
    

    <!-- FILTROS -->
    <div class="mt-5">
        <h4 style="color:#000080;">Últimas Movimentações</h4>

        <div class="mb-3">
            <div class="btn-group" role="group">
                <button class="btn @(filtroTipo == null ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetFiltro(null)">
                    Todos
                </button>

                <button class="btn @(filtroTipo == Receita.ReceitaTipo.Mensalidade ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetFiltro(Receita.ReceitaTipo.Mensalidade)">
                    Mensalidade
                </button>

                <button class="btn @(filtroTipo == Receita.ReceitaTipo.Aquisicao ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetFiltro(Receita.ReceitaTipo.Aquisicao)">
                    Aquisição
                </button>

                <button class="btn @(filtroTipo == Receita.ReceitaTipo.Outros ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetFiltro(Receita.ReceitaTipo.Outros)">
                    Outros
                </button>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label>Data Início</label>
                <input type="date"
                       class="form-control"
                       value="@dataInicio?.ToString("yyyy-MM-dd")"
                       @onchange="e => OnDataChanged(e, true)" />
            </div>

            <div class="col-md-3">
                <label>Data Fim</label>
                <input type="date"
                       class="form-control"
                       value="@dataFim?.ToString("yyyy-MM-dd")"
                       @onchange="e => OnDataChanged(e, false)" />
            </div>
        </div>

        <!-- TABELA -->
        <table class="table table-hover bg-white shadow-sm mt-3">
            <thead style="background-color:#000080; color:white;">
                <tr>
                    <th>Tipo</th>
                    <th>Valor</th>
                    <th>Vencimento</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in receitasRecentes)
                {
                    <tr style="cursor:pointer"
                        class="@(receitaSelecionada == item ? "table-primary" : "")"
                        @onclick="() => SelecionarReceita(item)">

                        <td>
                            <span class="badge @GetTipoBadge(item.Type)">
                                @item.GetTypeTexto()
                            </span>
                        </td>

                        <td>@if (Session.GetInstanceAccess().Level >= 4) {
                            <span>R$ @item.Valor.ToString("N2")</span>
                        } else { <span>
                                    R$ XX.XX
                        </span>}
                    </td>

                        <td>@item.DataVencimento.ToShortDateString()</td>

                        <td>
                            <span class="badge @GetStatusBadge(item.Status)">
                                @item.GetStatusTexto()
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="d-flex justify-content-center align-items-center mt-3 gap-1">

            <!-- Left -->
            <button class="btn btn-link p-1"
            style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                    disabled="@(paginaAtual == 1)"
                    @onclick="() => MudarPagina(paginaAtual - 1)">
                ‹
            </button>

            <!-- Pages -->
            @foreach (var p in GetPaginasVisiveis())
            {
                if (p == null)
                {
                    <span class="px-2" style="font-size: 0.8rem;">...</span>
                }
                else
                {
                    <button class="btn btn-sm @(paginaAtual == p ? "btn-primary" : "btn-outline-primary") px-2 py-0"
                    style="width:32px; height:28px; font-size:0.75rem; display:flex; align-items:center; justify-content:center;"
                            @onclick="() => MudarPagina(p.Value)">
                        @p
                    </button>
                }
            }

            <!-- Right -->
            <button class="btn btn-link p-1"
                    style="width: 24px; height: 24px; line-height: 1; text-decoration: none;"
                    disabled="@(paginaAtual == totalPaginas)"
                    @onclick="() => MudarPagina(paginaAtual + 1)">
                ›
            </button>

        </div>
    </div>

    <!-- DETALHES -->
    @if (receitaSelecionada != null)
    {
        <div class="card mt-4 shadow-sm">
            <div class="card-body">
                <h5 class="text-primary">Detalhes da Receita</h5>

                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Tipo:</strong> @receitaSelecionada.GetTypeTexto()</p>
                        <p><strong>Valor:</strong> @if (Session.GetInstanceAccess().Level >= 4) {
                                                        <span> R$ @receitaSelecionada.Valor.ToString("N2")</span>
                            }
                            else
                            {
                                <span> R$ XX.XX</span>
                            }</p>
                            <p><strong>Status:</strong> @receitaSelecionada.GetStatusTexto()</p>
                        <p><strong>Vencimento:</strong> @receitaSelecionada.DataVencimento.ToShortDateString()</p>
                    </div>

                    <div class="col-md-6">
                        <p><strong>Descrição:</strong> @receitaSelecionada.Descricao</p>
                        <p><strong>Origem:</strong> @receitaSelecionada.Origem</p>
                        <p><strong>Aluno:</strong> @receitaSelecionada.Aluno?.Nome</p>
                        <p><strong>Responsável:</strong> @receitaSelecionada.Responsavel?.Nome</p>
                    </div>
                </div>

                <button class="btn btn-sm btn-secondary mt-3" @onclick="FecharDetalhes">
                    Fechar
                </button>
            </div>
        </div>
    }
</div>

@code {
    private int paginaAtual = 1;
    private int itensPorPagina = 8;
    private int totalPaginas = 1;

    private DateTime? dataInicio = null;
    private DateTime? dataFim = null;

    private float saldoCaixa = 0;
    private float previsaoReceita = 0;
    private float valorAtraso = 0;

    private List<Receita> todasReceitas = new();
    private List<Receita> receitasRecentes = new();

    private Receita.ReceitaTipo? filtroTipo = null;
    private Receita? receitaSelecionada = null;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private float totalDespesasValor = 0;

    private void CarregarDados()
    {
        todasReceitas = ReceitaController.GetAll();
        var todasDespesas = DespesaController.GetAll();

        // 1. Receitas Pagas 
        float receitasPagas = todasReceitas
            .Where(r => r.Status == Receita.ReceitaStatus.Pago)
            .Sum(r => (float)r.Valor);

        // 2. Despesas Pagas 
        float despesasPagas = todasDespesas
            .Where(d => d.Status == true)
            .Sum(d => (float)d.Valor);

        // Dentro do método CarregarDados do Dashboard:
        var storageDespesas = GeneralStorage.GetStorage<Despesa>();
        if (storageDespesas != null)
        {
            totalDespesasValor = storageDespesas.Values.Sum(d => (float)d.Valor);

            // O Saldo deve ser (Receitas Pagas) - (Despesas Pagas)
            despesasPagas = storageDespesas.Values.Where(d => d.Status).Sum(d => (float)d.Valor);
            saldoCaixa = receitasPagas - despesasPagas;
        }

        // 5. Previsões e Atrasos
        previsaoReceita = todasReceitas.Where(r => r.Status == Receita.ReceitaStatus.EmAndamento).Sum(r => (float)r.Valor);
        valorAtraso = todasReceitas.Where(r => r.Status == Receita.ReceitaStatus.EmAtraso).Sum(r => (float)r.Valor);

        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        IEnumerable<Receita> query = todasReceitas;

        // filtro por tipo
        if (filtroTipo != null)
            query = query.Where(r => r.Type == filtroTipo);

        // filtro por data
        if (dataInicio != null)
            query = query.Where(r => r.DataVencimento.Date >= dataInicio.Value.Date);

        if (dataFim != null)
            query = query.Where(r => r.DataVencimento.Date <= dataFim.Value.Date);

        // ordenação
        query = query.OrderBy(r => r.DataVencimento);

        // cálculo de páginas
        int totalItens = query.Count();
        totalPaginas = (int)Math.Ceiling(totalItens / (double)itensPorPagina);

        // garantir página válida
        if (paginaAtual > totalPaginas)
            paginaAtual = totalPaginas == 0 ? 1 : totalPaginas;

        // paginação
        receitasRecentes = query
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();
    }

    private void SetFiltro(Receita.ReceitaTipo? tipo)
    {
        filtroTipo = tipo;
        paginaAtual = 1;
        receitaSelecionada = null;
        AplicarFiltro();
    }

    private void OnDataChanged(ChangeEventArgs e, bool isInicio)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            if (isInicio)
                dataInicio = date;
            else
                dataFim = date;

            paginaAtual = 1;
            AplicarFiltro();
        }
    }

    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();

        if (totalPaginas <= 7)
        {
            for (int i = 1; i <= totalPaginas; i++)
                paginas.Add(i);

            return paginas;
        }

        paginas.Add(1);

        if (paginaAtual > 4)
            paginas.Add(null); // "..."

        int inicio = Math.Max(2, paginaAtual - 2);
        int fim = Math.Min(totalPaginas - 1, paginaAtual + 2);

        for (int i = inicio; i <= fim; i++)
            paginas.Add(i);

        if (paginaAtual < totalPaginas - 3)
            paginas.Add(null); // "..."

        paginas.Add(totalPaginas);

        return paginas;
    }

    private void SelecionarReceita(Receita r)
    {
        receitaSelecionada = r;
    }

    private void FecharDetalhes()
    {
        receitaSelecionada = null;
    }

    private void MudarPagina(int pagina)
    {
        paginaAtual = pagina;
        AplicarFiltro();
    }

    private string GetTipoBadge(Receita.ReceitaTipo tipo) => tipo switch
    {
        Receita.ReceitaTipo.Mensalidade => "bg-primary",
        Receita.ReceitaTipo.Aquisicao => "bg-info",
        Receita.ReceitaTipo.Outros => "bg-secondary",
        _ => "bg-dark"
    };

    private string GetStatusBadge(Receita.ReceitaStatus status) => status switch
    {
        Receita.ReceitaStatus.Pago => "bg-success",
        Receita.ReceitaStatus.EmAtraso => "bg-danger",
        Receita.ReceitaStatus.EmAndamento => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}