@page "/dashboard-financeiro"
@page "/dashboard-financeiro/receita/{ReceitaId:guid}"
@page "/dashboard-financeiro/despesa/{DespesaId:guid}"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Storage
@using SITA.src.Controller
@using SITA.src.Services
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject FileService FileService
@inject IJSRuntime JS

<div class="pagina-financeiro">

    <!-- HEADER -->
    <div class="fin-header">
        <h1>Dashboard Financeiro</h1>
        <div style="display:flex; gap:10px; align-items:center;">
            <button class="btn fw-bold" style="background:#3650a1; color:white; border:none; border-radius:8px; padding:10px 16px; cursor:pointer;"
                    @onclick="GerarRelatorioGeral">
                @if (modoAtivo == Modo.Receitas && r_dataInicio.HasValue && r_dataFim.HasValue)
                {
                    <span>📄 Relatório (PDF) | @r_dataInicio?.ToString("dd/MM/yy") – @r_dataFim?.ToString("dd/MM/yy")</span>
                }
                else if (modoAtivo == Modo.Despesas && d_dataInicio.HasValue && d_dataFim.HasValue)
                {
                    <span>📄 Relatório (PDF) | @d_dataInicio?.ToString("dd/MM/yy") – @d_dataFim?.ToString("dd/MM/yy")</span>
                }
                else
                {
                    <span>📄 Relatório Geral (PDF)</span>
                }
            </button>
            @if (modoAtivo == Modo.Despesas)
            {
                <button class="btn-nova-despesa" @onclick='() => Navigation.NavigateTo("/nova-despesa")'>
                    + Cadastrar Nova Despesa
                </button>
            }
        </div>
    </div>

    <!-- SUMMARY CARDS (level 4+) -->
    @if (Session.GetInstanceAccess().Level >= 4)
    {
        <section class="cards-financeiro">
            <div class="card-resumo saldo">
                <h2>Saldo em Caixa</h2>
                <h3>R$ @saldoCaixa.ToString("N2")</h3>
            </div>
            <div class="card-resumo previsao">
                <h2>Previsão</h2>
                <h3>R$ @previsaoReceita.ToString("N2")</h3>
            </div>
            <div class="card-resumo atraso">
                <h2>Inadimplência</h2>
                <h3>R$ @valorAtraso.ToString("N2")</h3>
            </div>
        </section>
    }

    <!-- MODE TABS -->
    <div class="abas-modo">
        <button class="aba-modo @(modoAtivo == Modo.Receitas ? "aba-modo-ativa" : "")"
                @onclick='() => AlterarModo(Modo.Receitas)'>
            Receitas
        </button>
        <button class="aba-modo @(modoAtivo == Modo.Despesas ? "aba-modo-ativa" : "")"
                @onclick='() => AlterarModo(Modo.Despesas)'>
            Despesas
        </button>
    </div>

    <h1 class="titulo-Receitas">
        @(modoAtivo == Modo.Receitas ? "Gestão de Receitas" : "Gestão de Despesas")
    </h1>

    <!-- FILTERS + TABLE -->
    <section class="area-Receitas">

        <!-- SIDEBAR FILTERS -->
        <aside class="filtros">

            @if (modoAtivo == Modo.Receitas)
            {
                <div class="filtro">
                    <label>Pesquisar</label>
                    <input placeholder="Aluno, responsável, origem ou descrição..."
                           @bind="r_pesquisa" @bind:event="oninput" />
                </div>
                <div class="filtro">
                    <label>Tipo</label>
                    <select @bind="r_tipoFiltro">
                        <option value="">Todos</option>
                        @foreach (var tipo in tiposDisponiveisReceita)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>
                <div class="filtro">
                    <label>Status</label>
                    <select @bind="r_statusFiltro">
                        <option value="">Todos</option>
                        <option value="Pago">Pago</option>
                        <option value="EmAndamento">Em Andamento</option>
                        <option value="EmAtraso">Em Atraso</option>
                    </select>
                </div>
                <div class="filtro">
                    <label>Data Inicial</label>
                    <input type="date" @bind="r_dataInicio" />
                </div>
                <div class="filtro">
                    <label>Data Final</label>
                    <input type="date" @bind="r_dataFim" />
                </div>
                <div class="filtro">
                    <label>Ordenar Valor</label>
                    <select @bind="r_ordemValor">
                        <option value="">Padrão</option>
                        <option value="asc">Menor → Maior</option>
                        <option value="desc">Maior → Menor</option>
                    </select>
                </div>
            }
            else
            {
                <div class="filtro">
                    <label>Pesquisar</label>
                    <input placeholder="Nome, fornecedor ou item..."
                           @bind="d_pesquisa" @bind:event="oninput" />
                </div>
                <div class="filtro">
                    <label>Categoria</label>
                    <select @bind="d_categoriaFiltro">
                        <option value="">Todas</option>
                        @foreach (var cat in categoriasDisponiveis)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="filtro">
                    <label>Status</label>
                    <select @bind="d_statusFiltroStr">
                        <option value="">Todos</option>
                        <option value="Pago">Pago</option>
                        <option value="Pendente">Pendente</option>
                        <option value="EmAndamento">Em Andamento</option>
                        <option value="EmAtraso">Em Atraso</option>
                    </select>
                </div>
                <div class="filtro">
                    <label>Data Inicial</label>
                    <input type="date" @bind="d_dataInicio" />
                </div>
                <div class="filtro">
                    <label>Data Final</label>
                    <input type="date" @bind="d_dataFim" />
                </div>
                <div class="filtro">
                    <label>Ordenar Valor</label>
                    <select @bind="d_ordemValor">
                        <option value="">Padrão</option>
                        <option value="asc">Menor → Maior</option>
                        <option value="desc">Maior → Menor</option>
                    </select>
                </div>
            }

        </aside>

        <!-- TABLE + PAGINATION -->
        <div class="conteudo-tabela">

            @if (modoAtivo == Modo.Receitas)
            {
                <table class="tabela-Receitas">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Tipo</th>
                            <th>Descrição</th>
                            <th>Valor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!ReceitasPaginadas.Any())
                        {
                            <tr>
                                <td colspan="5" class="sem-registro">Nenhuma receita encontrada.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in ReceitasPaginadas)
                            {
                                <tr class="linha-clicavel" @onclick="() => AbrirModalReceita(item)">
                                    <td>@item.DataReferente.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @GetTipoBadgeReceita(item.Type)">
                                            @item.GetTypeTexto()
                                        </span>
                                    </td>
                                    <td class="descricao">
                                        <strong>
                                            @item.Descricao
                                            @if (string.IsNullOrWhiteSpace(item.AnexoCaminho))
                                            {
                                                <span class="badge-alerta">!</span>
                                            }
                                        </strong>
                                        <small>@(item.Aluno?.Nome ?? item.Responsavel?.Nome ?? item.Origem)</small>
                                    </td>
                                    <td class="valor">
                                        @if (Session.GetInstanceAccess().Level >= 4)
                                        {
                                            <span>R$ @item.GetValorTotal().ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>R$ XX.XX</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeReceita(item.Status)">
                                            @item.GetStatusTexto()
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="tabela-Receitas">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Categoria</th>
                            <th>Descrição</th>
                            <th>Valor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!DespesasPaginadas.Any())
                        {
                            <tr>
                                <td colspan="5" class="sem-registro">Nenhuma despesa encontrada.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in DespesasPaginadas)
                            {
                                <tr class="linha-clicavel" @onclick="() => AbrirModalDespesa(item)">
                                    <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Categoria</span>
                                    </td>
                                    <td class="descricao">
                                        <strong>
                                            @item.Descricao
                                            @if (string.IsNullOrWhiteSpace(item.AnexoCaminho))
                                            {
                                                <span class="badge-alerta">!</span>
                                            }
                                        </strong>
                                        <small>@item.Fornecedor</small>
                                    </td>
                                    <td class="valor">
                                        <span class="valor-despesa">R$ @item.GetValorTotal().ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeDespesa(item.Status)">
                                            @item.GetStatusTexto()
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- PAGINATION (shared, adapts to active mode) -->
            @{
                var paginaAtiva = modoAtivo == Modo.Receitas ? r_paginaAtual : d_paginaAtual;
                var totalPags = modoAtivo == Modo.Receitas ? r_totalPaginas : d_totalPaginas;
            }
            <div class="paginacao">
                <button class="btn-pagina-seta"
                        disabled="@(paginaAtiva == 1)"
                        @onclick="() => MudarPagina(paginaAtiva - 1)">
                    ‹
                </button>
                @foreach (var p in GetPaginasVisiveis(paginaAtiva, totalPags))
                {
                    if (p == null)
                    {
                        <span class="reticencias">...</span>
                    }
                    else
                    {
                        <button class="btn-pagina @(paginaAtiva == p ? "pagina-ativa" : "")"
                                @onclick="() => MudarPagina(p.Value)">
                            @p
                        </button>
                    }
                }
                <button class="btn-pagina-seta"
                        disabled="@(paginaAtiva >= totalPags)"
                        @onclick="() => MudarPagina(paginaAtiva + 1)">
                    ›
                </button>
            </div>

        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(msgFeedback))
    {
        <div class="alert alert-danger mt-3 mx-3">@msgFeedback</div>
    }

</div>

<!-- ═══════════════════════════════════════════════════
     MODAL — RECEITA
════════════════════════════════════════════════════ -->
<div class="overlay-modal @(mostrarModalReceita ? "overlay-aberto" : "overlay-fechado")">
    <div class="modal-receita @(animarModalReceita ? "modal-aberta" : "")">

        @if (receitaSelecionada != null)
        {
            <div class="modal-topo">
                <h2>@receitaSelecionada.GetTypeTexto()</h2>
                <button class="btn-fechar" @onclick="FecharModalReceita">×</button>
            </div>

            <br />

            <div class="abas-modal">
                <button class="@(abaAtiva == "detalhes" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "detalhes"'>
                    Detalhes
                </button>
                <button class="@(abaAtiva == "gestao" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "gestao"'>
                    Gestão
                </button>
            </div>

            <div class="conteudo-modal">

                @if (abaAtiva == "detalhes")
                {
                    <h5 style="font-weight:bold; margin:0 0 12px 0;">Detalhes da Receita</h5>

                    <div style="background-color:#f0f0f0; padding:20px; border-radius:8px; margin-bottom:25px; border-left:5px solid #28a745;">
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <p><strong>Descrição:</strong> @receitaSelecionada.Descricao</p>
                                <p><strong>Tipo:</strong> @receitaSelecionada.GetTypeTexto()</p>
                                <p><strong>Aluno:</strong> @receitaSelecionada.Aluno?.Nome</p>
                                <p><strong>Responsável:</strong> @receitaSelecionada.Responsavel?.Nome</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Data Referente:</strong> @receitaSelecionada.DataReferente.ToString("dd/MM/yyyy")</p>
                                @if (receitaSelecionada.IsPago())
                                {
                                    <p><strong>Data Pagamento:</strong> @receitaSelecionada.DataPagamento?.ToString("dd/MM/yyyy")</p>
                                }
                                <p><strong>Vencimento:</strong> @receitaSelecionada.DataVencimento.ToString("dd/MM/yyyy")</p>
                                <p>
                                    <strong>Valor:</strong>
                                    <span class="text-success fw-bold">R$ @receitaSelecionada.GetValorTotal().ToString("N2")</span>
                                </p>
                                <p>
                                    <strong>Status:</strong>
                                    <span class="badge @GetStatusBadgeReceita(receitaSelecionada.Status)">
                                        @receitaSelecionada.GetStatusTexto()
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Descontos -->
                    <div class="mt-2">
                        <small><strong>Descontos</strong></small><br />
                        @if (!ReceitaDescontosPaginados.Any())
                        {
                            <small class="text-muted">Nenhum desconto encontrado</small>
                        }
                        @foreach (var desconto in ReceitaDescontosPaginados)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom" style="font-size:0.85rem;">
                                <span class="text-truncate" style="max-width:75%;">@desconto.Descricao</span>
                                <span class="text-danger fw-bold">
                                    - @(desconto.Tipo == Financeiro.Desconto.TipoValor.Percentual ? $"{desconto.Valor:N0}%" : $"R$ {desconto.Valor:N2}")
                                </span>
                            </div>
                        }
                    </div>
                    @if (receitaSelecionada.Descontos.Count > itensPorPaginaDetalhes)
                    {
                        <div class="d-flex justify-content-end gap-1 mt-2">
                            <button class="btn btn-sm btn-light px-2 py-0" disabled="@(paginaDescontos == 1)" @onclick="() => paginaDescontos--">‹</button>
                            <small class="align-self-center">@paginaDescontos</small>
                            <button class="btn btn-sm btn-light px-2 py-0"
                                    disabled="@(paginaDescontos >= Math.Ceiling((double)receitaSelecionada.Descontos.Count / itensPorPaginaDetalhes))"
                                    @onclick="() => paginaDescontos++">
                                ›
                            </button>
                        </div>
                    }

                    <!-- Extras -->
                    <div class="mt-2">
                        <small><strong>Extras</strong></small><br />
                        @if (!ReceitaExtrasPaginados.Any())
                        {
                            <small class="text-muted">Nenhum extra encontrado</small>
                        }
                        @foreach (var extra in ReceitaExtrasPaginados)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom" style="font-size:0.85rem;">
                                <span class="text-truncate" style="max-width:75%;">@extra.Descricao</span>
                                <span class="text-success fw-bold">
                                    + @(extra.Tipo == Financeiro.Extras.TipoValor.Percentual ? $"{extra.Valor:N0}%" : $"R$ {extra.Valor:N2}")
                                </span>
                            </div>
                        }
                    </div>
                    @if (receitaSelecionada.Bonus.Count > itensPorPaginaDetalhes)
                    {
                        <div class="d-flex justify-content-end gap-1 mt-2">
                            <button class="btn btn-sm btn-light px-2 py-0" disabled="@(paginaExtras == 1)" @onclick="() => paginaExtras--">‹</button>
                            <small class="align-self-center">@paginaExtras</small>
                            <button class="btn btn-sm btn-light px-2 py-0"
                                    disabled="@(paginaExtras >= Math.Ceiling((double)receitaSelecionada.Bonus.Count / itensPorPaginaDetalhes))"
                                    @onclick="() => paginaExtras++">
                                ›
                            </button>
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 style="font-weight:bold; margin:0;">Comprovante</h5>
                        <button class="btn btn-sm btn-outline-secondary" style="max-width: 280px"
                                @onclick="() => GerarPdfReceita(receitaSelecionada)">
                            📄 Gerar PDF
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => mostrarComprovante = true">Ver Comprovante</button>
                    }
                    else
                    {
                        <small class="text-muted">Nenhum comprovante enviado.</small>
                    }
                }
                else if (abaAtiva == "gestao")
                {
                    <!-- Descontos gestão -->
                    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius:12px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold m-0">Descontos</h6>
                            <button class="btn btn-success btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:1rem;line-height:1;display:flex;align-items:center;justify-content:center;"
                                    @onclick="AdicionarDescontoReceita">
                                +
                            </button>
                        </div>
                        @if (receitaSelecionada.Descontos.Count == 0)
                        {
                            <small class="text-muted">Nenhum desconto cadastrado.</small>
                        }
                        @foreach (var desconto in receitaSelecionada.Descontos)
                        {
                            <div class="d-flex gap-2 align-items-center mb-2">
                                <input class="form-control form-control-sm" placeholder="Descrição" style="font-size:0.82rem;" @bind="desconto.Descricao" />
                                <select class="form-select form-select-sm" style="width:70px;" @bind="desconto.Tipo">
                                    <option value="@Financeiro.Desconto.TipoValor.Fixo">R$</option>
                                    <option value="@Financeiro.Desconto.TipoValor.Percentual">%</option>
                                </select>
                                <input class="form-control form-control-sm" type="number" step="0.01" style="width:90px;" @bind="desconto.Valor" />
                                <button class="btn btn-danger btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:0.9rem;line-height:1;display:flex;align-items:center;justify-content:center;flex-shrink:0;"
                                        @onclick="() => RemoverDescontoReceita(desconto)">
                                    ×
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Extras gestão -->
                    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius:12px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold m-0">Extras</h6>
                            <button class="btn btn-success btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:1rem;line-height:1;display:flex;align-items:center;justify-content:center;"
                                    @onclick="AdicionarExtraReceita">
                                +
                            </button>
                        </div>
                        @if (receitaSelecionada.Bonus.Count == 0)
                        {
                            <small class="text-muted">Nenhum extra cadastrado.</small>
                        }
                        @foreach (var extra in receitaSelecionada.Bonus)
                        {
                            <div class="d-flex gap-2 align-items-center mb-2">
                                <input class="form-control form-control-sm" placeholder="Descrição" style="font-size:0.82rem;" @bind="extra.Descricao" />
                                <select class="form-select form-select-sm" style="width:70px;" @bind="extra.Tipo">
                                    <option value="@Financeiro.Extras.TipoValor.Fixo">R$</option>
                                    <option value="@Financeiro.Extras.TipoValor.Percentual">%</option>
                                </select>
                                <input class="form-control form-control-sm" type="number" step="0.01" style="width:90px;" @bind="extra.Valor" />
                                <button class="btn btn-danger btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:0.9rem;line-height:1;display:flex;align-items:center;justify-content:center;flex-shrink:0;"
                                        @onclick="() => RemoverExtraReceita(extra)">
                                    ×
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Resumo -->
                    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius:12px; background:#f8f9fa;">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Valor Base:</span>
                            <strong>R$ @receitaSelecionada.Valor.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Total Descontos:</span>
                            <strong>- R$ @receitaSelecionada.Descontos.Sum(d => d.GetValorFinal(receitaSelecionada.Valor)).ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Total Extras:</span>
                            <strong>+ R$ @receitaSelecionada.Bonus.Sum(b => b.GetValorFinal(receitaSelecionada.Valor)).ToString("N2")</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold">Valor Final:</span>
                            <strong class="text-primary">R$ @receitaSelecionada.GetValorTotal().ToString("N2")</strong>
                        </div>
                    </div>

                    @if (receitaSelecionada.Status != Receita.FinanceStatus.Pago)
                    {
                        <button class="btn btn-success w-100 p-3 fw-bold"
                                @onclick="() => GoFinanceiro(receitaSelecionada.Id)">
                            CONFIRMAR PAGAMENTO
                        </button>
                    }
                    else
                    {
                        <!-- Comprovante upload (pago) -->
                        <div class="card border-0 shadow-sm p-3 mt-4" style="border-radius:12px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="fw-bold m-0">Comprovante</h6>
                                    @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                                    {
                                        <small class="text-success">Comprovante enviado</small>
                                    }
                                    else
                                    {
                                        <small class="text-warning">Nenhum comprovante enviado</small>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                                {
                                    <button class="btn-ver-comprovante" @onclick="() => mostrarComprovante = true">👁</button>
                                }
                            </div>
                            <InputFile OnChange="SelecionarComprovanteGestao" class="form-control form-control-sm mb-3" />
                            @if (comprovanteGestao != null)
                            {
                                <small class="text-success d-block mb-3">Novo arquivo: @comprovanteGestao.Name</small>
                            }
                            <div class="d-flex gap-2">
                                <button class="btn btn-success btn-sm fw-bold"
                                        disabled="@(comprovanteGestao == null)"
                                        @onclick="SalvarComprovanteGestao">
                                    @(string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho) ? "SALVAR COMPROVANTE" : "ALTERAR COMPROVANTE")
                                </button>
                                @if (!string.IsNullOrWhiteSpace(receitaSelecionada.AnexoCaminho))
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="RemoverComprovante">Remover</button>
                                }
                            </div>
                        </div>
                    }
                }

            </div>
        }

    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     MODAL — DESPESA
════════════════════════════════════════════════════ -->
<div class="overlay-modal @(mostrarModalDespesa ? "overlay-aberto" : "overlay-fechado")">
    <div class="modal-receita @(animarModalDespesa ? "modal-aberta" : "")">

        @if (despesaSelecionada != null)
        {
            <div class="modal-topo">
                <h2>@despesaSelecionada.Categoria</h2>
                <button class="btn-fechar" @onclick="FecharModalDespesa">×</button>
            </div>

            <br />

            <div class="abas-modal">
                <button class="@(abaAtiva == "detalhes" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "detalhes"'>
                    Detalhes
                </button>
                <button class="@(abaAtiva == "gestao" ? "aba-ativa" : "")"
                        @onclick='() => abaAtiva = "gestao"'>
                    Gestão
                </button>
            </div>

            <div class="conteudo-modal">

                @if (abaAtiva == "detalhes")
                {
                    @switch (Mask.RemoveAccents(despesaSelecionada.Categoria))
                    {
                        case "Salario":
                            {
                                Salario despesaSelecionadaSalario = (Salario)despesaSelecionada;

                                <div style="background-color:#f0f0f0; padding:20px; border-radius:8px; margin-bottom:25px; border-left:5px solid #dc2626;">
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <p><strong>Funcionário:</strong> @despesaSelecionadaSalario.Funcionario.Nome</p>
                                            <p><strong>Descrição:</strong> @despesaSelecionada.Descricao</p>
                                            <p><strong>Categoria:</strong> @despesaSelecionada.Categoria</p>
                                            @if (despesaSelecionada.IsPago())
                                            {
                                                <p><strong>Quem Pagou:</strong> @despesaSelecionada.QuemPagou</p>
                                            }
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Vencimento:</strong> @despesaSelecionada.DataVencimento.ToString("dd/MM/yyyy")</p>
                                            <p>
                                                <strong>Valor:</strong>
                                                <span class="text-danger fw-bold">R$ @despesaSelecionada.GetValorTotal().ToString("N2")</span>
                                            </p>
                                            <p>
                                                <strong>Status:</strong>
                                                <span class="badge @(despesaSelecionada.IsPago() ? "bg-success" : "bg-warning text-dark")">
                                                    @despesaSelecionada.GetStatusTexto()
                                                </span>
                                            </p>
                                            <p><strong>Chave Pix:</strong> @despesaSelecionadaSalario.Funcionario.ChavePix</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Descontos salário -->
                                <div class="mt-2">
                                    <small><strong>Descontos</strong></small><br />
                                    @if (!DespesaDescontosPaginados.Any())
                                    {
                                        <small class="text-muted">Nenhum desconto encontrado</small>
                                    }
                                    @foreach (var desconto in DespesaDescontosPaginados)
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom" style="font-size:0.85rem;">
                                            <span class="text-truncate" style="max-width:75%;">@desconto.Descricao</span>
                                            <span class="text-danger fw-bold">
                                                - @(desconto.Tipo == Financeiro.Desconto.TipoValor.Percentual ? $"{desconto.Valor:N0}%" : $"R$ {desconto.Valor:N2}")
                                            </span>
                                        </div>
                                    }
                                </div>
                                @if (despesaSelecionada.Descontos.Count > itensPorPaginaDetalhes)
                                {
                                    <div class="d-flex justify-content-end gap-1 mt-2">
                                        <button class="btn btn-sm btn-light px-2 py-0" disabled="@(paginaDescontos == 1)" @onclick="() => paginaDescontos--">‹</button>
                                        <small class="align-self-center">@paginaDescontos</small>
                                        <button class="btn btn-sm btn-light px-2 py-0"
                                                disabled="@(paginaDescontos >= Math.Ceiling((double)despesaSelecionada.Descontos.Count / itensPorPaginaDetalhes))"
                                                @onclick="() => paginaDescontos++">
                                            ›
                                        </button>
                                    </div>
                                }

                                <!-- Extras salário -->
                                <div class="mt-2">
                                    <small><strong>Extras</strong></small><br />
                                    @if (!DespesaExtrasPaginados.Any())
                                    {
                                        <small class="text-muted">Nenhum extra encontrado</small>
                                    }
                                    @foreach (var extra in DespesaExtrasPaginados)
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-1 px-2 border-bottom" style="font-size:0.85rem;">
                                            <span class="text-truncate" style="max-width:75%;">@extra.Descricao</span>
                                            <span class="text-success fw-bold">
                                                + @(extra.Tipo == Financeiro.Extras.TipoValor.Percentual ? $"{extra.Valor:N0}%" : $"R$ {extra.Valor:N2}")
                                            </span>
                                        </div>
                                    }
                                </div>
                                @if (despesaSelecionada.Bonus.Count > itensPorPaginaDetalhes)
                                {
                                    <div class="d-flex justify-content-end gap-1 mt-2">
                                        <button class="btn btn-sm btn-light px-2 py-0" disabled="@(paginaExtras == 1)" @onclick="() => paginaExtras--">‹</button>
                                        <small class="align-self-center">@paginaExtras</small>
                                        <button class="btn btn-sm btn-light px-2 py-0"
                                                disabled="@(paginaExtras >= Math.Ceiling((double)despesaSelecionada.Bonus.Count / itensPorPaginaDetalhes))"
                                                @onclick="() => paginaExtras++">
                                            ›
                                        </button>
                                    </div>
                                }
                                break;
                            }
                        default:
                            {
                                <div style="background-color:#f0f0f0; padding:20px; border-radius:8px; margin-bottom:25px; border-left:5px solid #dc2626;">
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <p><strong>Descrição:</strong> @despesaSelecionada.Descricao</p>
                                            <p><strong>Fornecedor:</strong> @despesaSelecionada.Fornecedor</p>
                                            <p><strong>Categoria:</strong> @despesaSelecionada.Categoria</p>
                                            @if (despesaSelecionada.IsPago())
                                            {
                                                <p><strong>Quem Pagou:</strong> @despesaSelecionada.QuemPagou</p>
                                            }
                                            <p><strong>CNPJ Escola:</strong> @despesaSelecionada.CnpjEscola</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Vencimento:</strong> @despesaSelecionada.DataVencimento.ToString("dd/MM/yyyy")</p>
                                            <p><strong>CNPJ Fornecedor:</strong> @despesaSelecionada.CnpjFornecedor</p>
                                            <p><strong>Nº Nota Fiscal:</strong> @despesaSelecionada.NumeroNotaFiscal</p>
                                            <p><strong>Chave NF:</strong> @despesaSelecionada.ChaveAcessoNF</p>
                                            <p>
                                                <strong>Valor:</strong>
                                                <span class="text-danger fw-bold">R$ @despesaSelecionada.GetValorTotal().ToString("N2")</span>
                                            </p>
                                            <p>
                                                <strong>Status:</strong>
                                                <span class="badge @(despesaSelecionada.IsPago() ? "bg-success" : "bg-warning text-dark")">
                                                    @despesaSelecionada.GetStatusTexto()
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                break;
                            }
                    }

                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold m-0">Comprovante</h5>
                        <button class="btn btn-sm btn-outline-secondary" style="max-width: 280px"
                                @onclick="() => GerarPdfDespesa(despesaSelecionada)">
                            📄 Gerar PDF
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => mostrarComprovante = true">Ver Comprovante</button>
                    }
                    else
                    {
                        <small class="text-muted">Nenhum comprovante enviado.</small>
                    }
                }
                else if (abaAtiva == "gestao")
                {
                    @if (despesaSelecionada is Salario)
                    {
                        <!-- Descontos gestão despesa -->
                        <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius:12px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold m-0">Descontos</h6>
                                <button class="btn btn-success btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:1rem;line-height:1;display:flex;align-items:center;justify-content:center;"
                                        @onclick="AdicionarDescontoDespesa">
                                    +
                                </button>
                            </div>
                            @if (despesaSelecionada.Descontos.Count == 0)
                            {
                                <small class="text-muted">Nenhum desconto cadastrado.</small>
                            }
                            @foreach (var desconto in despesaSelecionada.Descontos)
                            {
                                <div class="d-flex gap-2 align-items-center mb-2">
                                    <input class="form-control form-control-sm" placeholder="Descrição" style="font-size:0.82rem;" @bind="desconto.Descricao" />
                                    <select class="form-select form-select-sm" style="width:70px;" @bind="desconto.Tipo">
                                        <option value="@Financeiro.Desconto.TipoValor.Fixo">R$</option>
                                        <option value="@Financeiro.Desconto.TipoValor.Percentual">%</option>
                                    </select>
                                    <input class="form-control form-control-sm" type="number" step="0.01" style="width:90px;" @bind="desconto.Valor" />
                                    <button class="btn btn-danger btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:0.9rem;line-height:1;display:flex;align-items:center;justify-content:center;flex-shrink:0;"
                                            @onclick="() => RemoverDescontoDespesa(desconto)">
                                        ×
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Extras gestão despesa -->
                        <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius:12px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold m-0">Extras</h6>
                                <button class="btn btn-success btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:1rem;line-height:1;display:flex;align-items:center;justify-content:center;"
                                        @onclick="AdicionarExtraDespesa">
                                    +
                                </button>
                            </div>
                            @if (despesaSelecionada.Bonus.Count == 0)
                            {
                                <small class="text-muted">Nenhum extra cadastrado.</small>
                            }
                            @foreach (var extra in despesaSelecionada.Bonus)
                            {
                                <div class="d-flex gap-2 align-items-center mb-2">
                                    <input class="form-control form-control-sm" placeholder="Descrição" style="font-size:0.82rem;" @bind="extra.Descricao" />
                                    <select class="form-select form-select-sm" style="width:70px;" @bind="extra.Tipo">
                                        <option value="@Financeiro.Extras.TipoValor.Fixo">R$</option>
                                        <option value="@Financeiro.Extras.TipoValor.Percentual">%</option>
                                    </select>
                                    <input class="form-control form-control-sm" type="number" step="0.01" style="width:90px;" @bind="extra.Valor" />
                                    <button class="btn btn-danger btn-sm" style="width:28px;height:28px;padding:0;border-radius:8px;font-size:0.9rem;line-height:1;display:flex;align-items:center;justify-content:center;flex-shrink:0;"
                                            @onclick="() => RemoverExtraDespesa(extra)">
                                        ×
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Resumo despesa -->
                        <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius:12px; background:#f8f9fa;">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Valor Base:</span>
                                <strong>R$ @despesaSelecionada.Valor.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-danger">
                                <span>Total Descontos:</span>
                                <strong>- R$ @despesaSelecionada.Descontos.Sum(d => d.GetValorFinal(despesaSelecionada.Valor)).ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Total Extras:</span>
                                <strong>+ R$ @despesaSelecionada.Bonus.Sum(b => b.GetValorFinal(despesaSelecionada.Valor)).ToString("N2")</strong>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">Valor Final:</span>
                                <strong class="text-primary">R$ @despesaSelecionada.GetValorTotal().ToString("N2")</strong>
                            </div>
                        </div>
                    }

                    @if (despesaSelecionada.Status != Receita.FinanceStatus.Pago)
                    {
                        <button class="btn btn-success w-100 p-3 fw-bold"
                                @onclick="() => IrParaFinanceiroDespesa(despesaSelecionada)">
                            CONFIRMAR PAGAMENTO
                        </button>
                    }
                    else
                    {
                        <!-- Comprovante upload despesa (pago) -->
                        <div class="card border-0 shadow-sm p-3 mt-4" style="border-radius:12px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="fw-bold m-0">Comprovante</h6>
                                    @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                                    {
                                        <small class="text-success">Comprovante enviado</small>
                                    }
                                    else
                                    {
                                        <small class="text-warning">Nenhum comprovante enviado</small>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                                {
                                    <button class="btn-ver-comprovante" @onclick="() => mostrarComprovante = true">👁</button>
                                }
                            </div>
                            <InputFile OnChange="SelecionarComprovanteGestao" class="form-control form-control-sm mb-3" />
                            @if (comprovanteGestao != null)
                            {
                                <small class="text-success d-block mb-3">Novo arquivo: @comprovanteGestao.Name</small>
                            }
                            <div class="d-flex gap-2">
                                <button class="btn btn-success btn-sm fw-bold"
                                        disabled="@(comprovanteGestao == null)"
                                        @onclick="SalvarComprovanteGestao">
                                    @(string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho) ? "SALVAR COMPROVANTE" : "ALTERAR COMPROVANTE")
                                </button>
                                @if (!string.IsNullOrWhiteSpace(despesaSelecionada.AnexoCaminho))
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="RemoverComprovante">Remover</button>
                                }
                            </div>
                        </div>
                    }
                }

            </div>
        }

    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     MODAL — COMPROVANTE VIEWER (shared)
════════════════════════════════════════════════════ -->
@{
    var anexoAtivo = receitaSelecionada?.AnexoCaminho ?? despesaSelecionada?.AnexoCaminho;
}
@if (mostrarComprovante && !string.IsNullOrWhiteSpace(anexoAtivo))
{
    var extensao = Path.GetExtension(anexoAtivo).ToLower();

    <div class="overlay-modal" @onclick="() => mostrarComprovante = false">
        <div class="modal-comprovante" @onclick:stopPropagation="true">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0">Comprovante</h5>
                <button class="btn-fechar-comprovante" @onclick="() => mostrarComprovante = false">×</button>
            </div>

            @if (extensao == ".pdf")
            {
                <iframe src="@anexoAtivo" width="100%" height="700px"
                        style="border:none; border-radius:12px; background:white;" />
            }
            else
            {
                <div class="text-center">
                    <img src="@anexoAtivo"
                         style="max-width:100%; max-height:75vh; border-radius:12px; object-fit:contain;" />
                </div>
            }

        </div>
    </div>
}

