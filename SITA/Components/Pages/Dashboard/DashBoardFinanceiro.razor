        }

        .tabela-Receitas tbody tr:hover {
            background: #f6f8ff;
        }

    .descricao {
        white-space: normal;
        word-break: break-word;
    }

        .descricao strong {
            display: block;
            font-weight: 600;
        }

        .descricao small {
            display: block;
            margin-top: 3px;
            color: #666;
            font-size: 13px;
        }

    .valor-despesa {
        color: #dc2626;
        font-weight: bold;
    }

    /* Sem comprovante indicator */
    .badge-alerta {
        position: relative;
        display: inline-block;
        width: 16px;
        height: 16px;
        line-height: 16px;
        border-radius: 50%;
        background: #facc15;
        color: #111;
        font-size: 10px;
        font-weight: bold;
        text-align: center;
        margin-left: 5px;
        vertical-align: middle;
        cursor: default;
    }

        .badge-alerta::after {
            content: "Sem comprovante";
            position: absolute;
            bottom: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            background: #1f2937;
            color: #fff;
            font-size: 11px;
            font-weight: normal;
            white-space: nowrap;
            padding: 4px 8px;
            border-radius: 5px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s ease;
            z-index: 9999;
        }

        .badge-alerta::before {
            content: "";
            position: absolute;
