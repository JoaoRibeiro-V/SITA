@page "/estoque"
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Util
@using SITA.Components.Pages.GUI
@inject NavigationManager Navigation

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #3650a1; font-weight: bold; letter-spacing: -0.5px;">Gestão de Estoque</h2>
        <div class="d-flex gap-2">
            <input @bind="search" @bind:event="oninput" class="form-control"
                   placeholder="Buscar item..." style="width: 250px; border-radius: 8px;" />
            <button class="btn fw-bold text-white px-4 shadow-sm" style="background:#3650a1; border: none; border-radius: 8px;"
                    @onclick="AbrirModalNovo">
                + Novo Item
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3" style="border-left: 5px solid #3650a1 !important; border-radius: 8px;">
                <small class="text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;">Total de Itens</small>
                <h4 class="fw-bold m-0 mt-1" style="color:#3650a1;">@itensFiltrados.Count()</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3" style="border-left: 5px solid #28a745 !important; border-radius: 8px;">
                <small class="text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;">Valor em Estoque (Venda)</small>
                <h4 class="fw-bold text-success m-0 mt-1">R$ @itensFiltrados.Sum(i => i.GetValorTotalVenda()).ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3" style="border-left: 5px solid #ffc107 !important; border-radius: 8px;">
                <small class="text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;">Valor em Estoque (Custo)</small>
                <h4 class="fw-bold text-warning m-0 mt-1">R$ @itensFiltrados.Sum(i => i.GetValorTotalCusto()).ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3" style="border-left: 5px solid #dc3545 !important; border-radius: 8px;">
                <small class="text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;">Itens com Estoque Baixo</small>
                <h4 class="fw-bold text-danger m-0 mt-1">@itens.Count(i => i.Quantidade < 5)</h4>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead style="background-color: #3650a1; color: white;">
                    <tr>
                        <th class="ps-4 py-3">Item</th>
                        <th class="py-3">Categoria</th>
                        <th class="py-3">Qtd</th>
                        <th class="py-3">Custo Unit.</th>
                        <th class="py-3">Venda Unit.</th>
                        <th class="py-3">Margem</th>
                        <th class="pe-4 py-3 text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in itensFiltrados)
                    {
                        <tr class="@(item.Quantidade < 5 ? "table-warning" : "")">
                            <td class="ps-4">
                                <strong style="color: #2b3e6b;">@item.Nome</strong>
                                @if (!string.IsNullOrEmpty(item.Descricao))
                                {
                                    <br /><small class="text-muted">@item.Descricao</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@(item.Categoria ?? "-")</span></td>
                            <td>
                                <span class="badge px-2 py-1 @(item.Quantidade < 5 ? "bg-danger" : "bg-success")" style="font-size: 0.85rem;">
                                    @item.Quantidade
                                </span>
                            </td>
                            <td class="fw-semibold text-secondary">R$ @item.PrecoCusto.ToString("N2")</td>
                            <td class="fw-semibold text-primary">R$ @item.PrecoVenda.ToString("N2")</td>
                            <td class="fw-bold text-info">@item.GetMargem().ToString("N1")%</td>
                            <td class="pe-4 text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <button class="btn btn-sm btn-outline-success fw-bold px-3" style="border-radius: 6px;"
                                            @onclick="() => AbrirModalEntrada(item)">
                                        Entrada
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary fw-bold px-3" style="border-radius: 6px;"
                                            @onclick="() => AbrirModalVenda(item)">
                                        Venda
                                    </button>
                                    <button class="btn btn-sm btn-light border text-danger px-2" style="border-radius: 6px;"
                                            @onclick="() => ExcluirItem(item)">
                                        ✕
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!itensFiltrados.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5 fs-6">Nenhum item encontrado no almoxarifado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<Modal IsOpen="showModalNovo" OnClose="() => showModalNovo = false">
    <div style="padding: 15px 20px;">
        <div class="text-center mb-4">
            <div class="mx-auto mb-2 d-inline-block rounded-circle bg-primary bg-opacity-10 p-3" style="color: #3650a1;">
                📦
            </div>
            <h4 class="fw-bold m-0" style="color:#3650a1;">Novo Item de Estoque</h4>
            <p class="text-muted small m-0">Insira as propriedades do produto.</p>
        </div>

        <div class="mb-3">
            <label class="fw-semibold small text-secondary mb-1">Nome do Item:</label>
            <input class="form-control py-2" @bind="novoItem.Nome" placeholder="Ex:Uniforme" style="border-radius: 8px;" />
        </div>
        <div class="mb-3">
            <label class="fw-semibold small text-secondary mb-1">Descrição Detalhada:</label>
            <input class="form-control py-2" @bind="novoItem.Descricao" placeholder="Ex: Tamanho G" style="border-radius: 8px;" />
        </div>
        <div class="mb-3">
            <label class="fw-semibold small text-secondary mb-1">Categoria Comercial:</label>
            <select class="form-select py-2" @bind="novoItem.Categoria" style="border-radius: 8px;">
                <option value="Uniforme">Uniforme</option>
                <option value="Material">Material Escolar</option>
                <option value="Outros">Outros</option>
            </select>
        </div>
        <div class="row g-3 mb-3">
            <div class="col">
                <label class="fw-semibold small text-secondary mb-1">Preço de Custo (R$):</label>
                <input type="number" class="form-control py-2 fw-bold text-warning" @bind="novoItem.PrecoCusto" step="0.01" style="border-radius: 8px;" />
            </div>
            <div class="col">
                <label class="fw-semibold small text-secondary mb-1">Preço de Venda (R$):</label>
                <input type="number" class="form-control py-2 fw-bold text-success" @bind="novoItem.PrecoVenda" step="0.01" style="border-radius: 8px;" />
            </div>
        </div>
        <div class="mb-4">
            <label class="fw-semibold small text-secondary mb-1">Fornecedor Padrão:</label>
            <input class="form-control py-2" @bind="novoItem.Fornecedor" placeholder="Nome da empresa" style="border-radius: 8px;" />
        </div>

        @if (!string.IsNullOrEmpty(msgModalErro))
        {
            <div class="alert alert-danger py-2 fw-semibold small border-0 shadow-sm" style="border-radius: 8px;">⚠ @msgModalErro</div>
        }

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-light border py-2 fw-bold text-muted w-100" style="border-radius: 8px;" @onclick="() => showModalNovo = false">CANCELAR</button>
            <button class="btn py-2 fw-bold text-white w-100 shadow-sm" style="background-color: #3650a1; border: none; border-radius: 8px;" @onclick="SalvarNovoItem">SALVAR ITEM</button>
        </div>
    </div>
</Modal>

<Modal IsOpen="showModalEntrada" OnClose="() => showModalEntrada = false">
    <div style="padding: 15px 20px;">
        <div class="text-center mb-4">
            <div class="mx-auto mb-2 d-inline-block rounded-circle bg-success bg-opacity-10 p-3" style="color: #28a745;">
                📥
            </div>
            <h4 class="fw-bold m-0" style="color:#28a745;">Entrada de Material</h4>
            <p class="text-muted small m-0">Item selecionado: <strong class="text-dark">@(itemSelecionado?.Nome ?? "")</strong></p>
        </div>

        <div class="mb-3">
            <label class="fw-semibold small text-secondary mb-1">Quantidade a Adicionar:</label>
            <input type="number" class="form-control py-2 fw-bold fs-5 text-center" @bind="qtdEntrada" min="1" style="border-radius: 8px; border: 1px solid #28a745;" />
        </div>
        <div class="mb-3">
            <label class="fw-semibold small text-secondary mb-1">Preço de Custo Unitário Atualizado (R$):</label>
            <input type="number" class="form-control py-2 text-success fw-bold" @bind="precoCustoEntrada" step="0.01" style="border-radius: 8px;" />
        </div>
        <div class="mb-4">
            <label class="fw-semibold small text-secondary mb-1">Fornecedor do Lote:</label>
            <input class="form-control py-2" @bind="fornecedorEntrada" style="border-radius: 8px;" />
        </div>

        <div class="p-3 bg-light rounded-3 text-center border mb-3">
            <span class="text-muted small d-block">Impacto Patrimonial Automático:</span>
            <span class="fw-bold text-danger fs-5">Despesa de R$ @((qtdEntrada * (itemSelecionado != null ? precoCustoEntrada : 0)).ToString("N2"))</span>
        </div>

        @if (!string.IsNullOrEmpty(msgModalErro))
        {
            <div class="alert alert-danger py-2 fw-semibold small border-0" style="border-radius: 8px;">⚠ @msgModalErro</div>
        }

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-light border py-2 fw-bold text-muted w-100" style="border-radius: 8px;" @onclick="() => showModalEntrada = false">CANCELAR</button>
            <button class="btn btn-success py-2 fw-bold text-white w-100 shadow-sm" style="border-radius: 8px; border: none;" @onclick="ConfirmarEntrada">CONFIRMAR ENTRADA</button>
        </div>
    </div>
</Modal>

<Modal IsOpen="showModalVenda" OnClose="() => showModalVenda = false">
    <div style="padding: 15px 20px;">
        <div class="text-center mb-4">
            <div class="mx-auto mb-2 d-inline-block rounded-circle bg-info bg-opacity-10 p-3" style="color: #3650a1;">
                💰
            </div>
            <h4 class="fw-bold m-0" style="color:#3650a1;">Registrar Saída / Venda</h4>
            <p class="text-muted small m-0">Item: <strong class="text-dark">@(itemSelecionado?.Nome ?? "")</strong> | Estoque: <span class="badge bg-secondary">@(itemSelecionado?.Quantidade ?? 0) disp.</span></p>
        </div>

        <div class="mb-3">
            <label class="fw-semibold small text-secondary mb-1">Quantidade Solicitada:</label>
            <input type="number" class="form-control py-2 text-center fw-bold fs-5" @bind="qtdVenda" min="1" max="@(itemSelecionado?.Quantidade ?? 1)" style="border-radius: 8px; border: 1px solid #3650a1;" />
        </div>
        <div class="mb-3">
            <label class="fw-semibold small text-secondary mb-1">CPF do Responsável Financeiro:</label>
            <input class="form-control py-2 fw-bold" value="@cpfVenda" @oninput="OnCpfVendaInput" placeholder="000.000.000-00" maxlength="14" style="border-radius: 8px; letter-spacing: 0.5px;" />
            @if (responsavelVenda != null)
            {
                <div class="mt-2 text-success small fw-bold">
                    <span class="me-1">✔</span> Vinculado a: @responsavelVenda.Nome
                </div>
            }
        </div>

        <div class="p-3 bg-light rounded-3 text-center border mb-3">
            <span class="text-muted small d-block">Previsão de Caixa Direto:</span>
            <span class="fw-bold text-success fs-5">Receita de R$ @((qtdVenda * (itemSelecionado != null ? itemSelecionado.PrecoVenda : 0)).ToString("N2"))</span>
        </div>

        @if (!string.IsNullOrEmpty(msgModalErro))
        {
            <div class="alert alert-danger py-2 fw-semibold small border-0" style="border-radius: 8px;">⚠ @msgModalErro</div>
        }

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-light border py-2 fw-bold text-muted w-100" style="border-radius: 8px;" @onclick="() => showModalVenda = false">CANCELAR</button>
            <button class="btn btn-primary py-2 fw-bold text-white w-100 shadow-sm" style="background-color: #3650a1; border: none; border-radius: 8px;" @onclick="ConfirmarVenda">CONFIRMAR VENDA</button>
        </div>
    </div>
</Modal>

@code {
    private List<ItemEstoque> itens = new();
    private string search = "";
    private string msgModalErro = "";

    private bool showModalNovo = false;
    private ItemEstoque novoItem = new();

    private bool showModalEntrada = false;
    private ItemEstoque? itemSelecionado = null;
    private int qtdEntrada = 1;
    private double precoCustoEntrada = 0;
    private string fornecedorEntrada = "";

    private bool showModalVenda = false;
    private int qtdVenda = 1;
    private string cpfVenda = "";
    private Responsavel? responsavelVenda = null;

    IEnumerable<ItemEstoque> itensFiltrados =>
        (itens ?? new List<ItemEstoque>()).Where(i => i != null && (string.IsNullOrEmpty(search) ||
                         (i.Nome != null && i.Nome.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                         (i.Categoria != null && i.Categoria.Contains(search, StringComparison.OrdinalIgnoreCase))));

    protected override void OnInitialized()
    {
        try
        {
            itens = EstoqueController.GetAll() ?? new List<ItemEstoque>();
        }
        catch (Exception)
        {
            itens = new List<ItemEstoque>();
        }
    }

    void AbrirModalNovo()
    {
        novoItem = new ItemEstoque { Categoria = "Uniforme" };
        msgModalErro = "";
        showModalNovo = true;
    }

    void SalvarNovoItem()
    {
        if (string.IsNullOrWhiteSpace(novoItem.Nome))
        {
            msgModalErro = "Informe o nome do item.";
            return;
        }
        EstoqueController.Register(novoItem);
        itens = EstoqueController.GetAll() ?? new List<ItemEstoque>();
        showModalNovo = false;
    }

    void ExcluirItem(ItemEstoque item)
    {
        if (item == null) return;
        EstoqueController.Delete(item);
        itens = EstoqueController.GetAll() ?? new List<ItemEstoque>();
    }

    void AbrirModalEntrada(ItemEstoque item)
    {
        if (item == null) return;
        itemSelecionado = item;
        qtdEntrada = 1;
        precoCustoEntrada = item.PrecoCusto;
        fornecedorEntrada = item.Fornecedor ?? "";
        msgModalErro = "";
        showModalEntrada = true;
    }

    void ConfirmarEntrada()
    {
        if (itemSelecionado == null || qtdEntrada <= 0 || precoCustoEntrada <= 0)
        {
            msgModalErro = "Informe quantidade e preço de custo válidos.";
            return;
        }
        EstoqueController.EntradaEstoque(itemSelecionado, qtdEntrada, (float)precoCustoEntrada, fornecedorEntrada);
        itens = EstoqueController.GetAll() ?? new List<ItemEstoque>();
        showModalEntrada = false;
    }

    void AbrirModalVenda(ItemEstoque item)
    {
        if (item == null) return;
        itemSelecionado = item;
        qtdVenda = 1;
        cpfVenda = "";
        responsavelVenda = null;
        msgModalErro = "";
        showModalVenda = true;
    }

    void OnCpfVendaInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 11) digits = digits[..11];
        cpfVenda = Mask.FormatCpf(digits);
        if (digits.Length == 11)
            responsavelVenda = ResponsavelController.Get("CPF", digits);
        else
            responsavelVenda = null;
    }

    void ConfirmarVenda()
    {
        if (itemSelecionado == null || qtdVenda <= 0)
        {
            msgModalErro = "Informe uma quantidade válida.";
            return;
        }
        try
        {
            Aluno? aluno = responsavelVenda?.GetParentescos()?.FirstOrDefault()?.Aluno;
            EstoqueController.VendaEstoque(itemSelecionado, qtdVenda, aluno, responsavelVenda);
            itens = EstoqueController.GetAll() ?? new List<ItemEstoque>();
            showModalVenda = false;
        }
        catch (Exception ex)
        {
            msgModalErro = ex.Message;
        }
    }
}