@namespace SITA.Maui.Components
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Util
@inject NavigationManager Navigation

<div class="container-fluid p-4"
     style="background-color: #f8f9fa; min-height: 100vh;">

    <!-- HEADER -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 style="color:#3650a1; font-weight:bold;">
                Painel da Secretaria
            </h2>

            <p class="text-muted">
                Controle operacional e administrativo da instituição.
            </p>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card-kpi shadow-sm border-start border-primary border-4">

                <div class="icon-box" style="background:#e3f2fd;">
                    <i class="oi oi-people"></i>
                </div>

                <div>
                    <h6 class="text-muted mb-1">
                        Alunos Ativos
                    </h6>

                    <h4 class="fw-bold mb-0"
                        style="color:#3650a1;">
                        @quantidadeAlunos
                    </h4>

                    <small class="text-muted">
                        @quantidadeTurmas turma(s)
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-kpi shadow-sm border-start border-success border-4">

                <div class="icon-box" style="background:#e8f5e9;">
                    <i class="oi oi-check"></i>
                </div>

                <div>
                    <h6 class="text-muted mb-1">
                        Pagamentos Confirmados
                    </h6>

                    <h4 class="fw-bold mb-0 text-success">
                        @quantidadePagas
                    </h4>

                    <small class="text-muted">
                        mensalidades pagas
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-kpi shadow-sm border-start border-warning border-4">

                <div class="icon-box" style="background:#fff8e1;">
                    <i class="oi oi-warning"></i>
                </div>

                <div>
                    <h6 class="text-muted mb-1">
                        Pendências
                    </h6>

                    <h4 class="fw-bold mb-0 text-warning">
                        @quantidadePendentes
                    </h4>

                    <small class="text-muted">
                        cobranças pendentes
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-kpi shadow-sm border-start border-danger border-4">

                <div class="icon-box" style="background:#ffebee;">
                    <i class="oi oi-clock"></i>
                </div>

                <div>
                    <h6 class="text-muted mb-1">
                        Atrasadas
                    </h6>

                    <h4 class="fw-bold mb-0 text-danger">
                        @quantidadeAtrasadas
                    </h4>

                    <small class="text-muted">
                        cobranças vencidas
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- MAIN GRID -->
    <div class="row mb-4 align-items-stretch">

        <!-- CALENDÁRIO -->
        <div class="col-md-8 d-flex">

            <div class="card shadow-sm border-0 flex-fill p-4"
                 style="border-radius:15px;">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h5 class="fw-bold mb-0"
                        style="color:#3650a1;">
                        Calendário Operacional
                    </h5>

                    <div class="btn-group">

                        <button class="btn btn-sm @(tipoExibicao == TipoExibicao.Mensalidades ? "btn-success" : "btn-outline-success")"
                                @onclick="() => AlterarTipo(TipoExibicao.Mensalidades)">
                            Mensalidades
                        </button>

                        <button class="btn btn-sm @(tipoExibicao == TipoExibicao.Despesas ? "btn-warning" : "btn-outline-warning")"
                                @onclick="() => AlterarTipo(TipoExibicao.Despesas)">
                            Despesas
                        </button>

                        <button class="btn btn-sm @(tipoExibicao == TipoExibicao.Ambos ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => AlterarTipo(TipoExibicao.Ambos)">
                            Ambos
                        </button>

                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-1" style="font-size: 0.75rem; width:10%;" @onclick="MesAnterior">
                        ◄
                    </button>
                    <h6 class="mb-0 fw-bold">@mesAtual.ToString("MMMM yyyy")</h6>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-1" style="font-size: 0.75rem; width:10%;" @onclick="ProximoMes">
                        ►
                    </button>
                </div>

                <div class="calendar-grid">

                    <div class="calendar-header">
                        <div>Dom</div>
                        <div>Seg</div>
                        <div>Ter</div>
                        <div>Qua</div>
                        <div>Qui</div>
                        <div>Sex</div>
                        <div>Sáb</div>
                    </div>

                    <div class="calendar-days">

                        @foreach (var dia in ObterDiasDoMes())
                        {
                            var isHoje = dia.Data.Date == DateTime.Now.Date;

                            <div class="calendar-day @(isHoje ? "today" : "")"
                                 @onclick="() => SelecionarDia(dia.Data)">

                                <div class="day-number">
                                    @dia.Data.Day
                                </div>

                                @if (dia.Mensalidades > 0)
                                {
                                    <div class="calendar-event bg-success">
                                        @dia.Mensalidades mensalidade(s)
                                    </div>
                                }

                                @if (dia.Despesas > 0)
                                {
                                    <div class="calendar-event bg-warning text-dark">
                                        @dia.Despesas despesa(s)
                                    </div>
                                }

                                @if (dia.Atrasos > 0)
                                {
                                    <div class="calendar-event bg-danger">
                                        @dia.Atrasos atraso(s)
                                    </div>
                                }

                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>

        <!-- LATERAL -->
        <div class="col-md-4 d-flex flex-column gap-4">

            <!-- DESPESAS -->
            <div class="card shadow-sm border-0 p-4"
                 style="border-radius:15px;">

                <h5 class="fw-bold mb-3"
                    style="color:#3650a1;">
                    Controle de Despesas
                </h5>

                <div class="d-flex justify-content-between mb-2">
                    <span>Despesas do mês</span>

                    <span class="fw-bold">
                        @despesasMes
                    </span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span>Pendentes</span>

                    <span class="badge bg-warning text-dark">
                        @quantidadeDespesasPendentes
                    </span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span>Pagas</span>

                    <span class="badge bg-success">
                        @despesasPagas
                    </span>
                </div>

                <div class="d-flex justify-content-between">
                    <span>Vencendo Hoje</span>

                    <span class="badge bg-danger">
                        @despesasHoje
                    </span>
                </div>

            </div>

            <div class="card shadow-sm border-0 h-100"
                 style="border-radius: 15px;">

                <div class="card-body d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0" style="color:#3650a1;">
                            Atividades Recentes
                        </h5>
                    </div>

                    <!-- LISTA -->
                    <div style="
                        min-height: 350px;
                        max-height: 350px;
                        overflow-y: auto;
                        overflow-x: hidden;
                        ">

                        @foreach (var atividade in AtividadesPaginadas)
                        {
                            <div class="border-bottom py-2">
                                <div class="fw-bold">@atividade.Data.ToString("dd/MM/yyyy")</div>

                                <small class="text-muted">
                                    @atividade.Texto
                                </small>
                            </div>
                        }

                    </div>

                    <!-- PAGINAÇÃO -->
                    @if (TotalPaginasAtividade > 1)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-3">

                            <button style="width: 10%" class="btn btn-sm btn-outline-secondary"
                                    disabled="@(paginaAtividade == 1)"
                                    @onclick="PaginaAnterior">
                                ◄
                            </button>

                            <small class="text-muted">
                                Página @paginaAtividade de @TotalPaginasAtividade
                            </small>

                            <button style="width: 10%" class="btn btn-sm btn-outline-secondary"
                                    disabled="@(paginaAtividade == TotalPaginasAtividade)"
                                    @onclick="ProximaPagina">
                                ►
                            </button>
                        </div>
                    }

                </div>
            </div>

            <!-- RESUMO -->
            <div class="card shadow-sm border-0 p-4"
                 style="border-radius:15px;">

                <h5 class="fw-bold mb-3"
                    style="color:#3650a1;">
                    Resumo Operacional
                </h5>

                <div class="mb-3">

                    <div class="d-flex justify-content-between mb-1">
                        <span>Pagamentos em Dia</span>

                        <span class="fw-bold text-success">
                            @percentualPago%
                        </span>
                    </div>

                    <div class="progress"
                         style="height:10px;">

                        <div class="progress-bar bg-success"
                             style="width:@percentualPago%">
                        </div>

                    </div>
                </div>

                <div class="mb-4">

                    <div class="d-flex justify-content-between mb-1">
                        <span>Pendências</span>

                        <span class="fw-bold text-warning">
                            @percentualPendencias%
                        </span>
                    </div>

                    <div class="progress"
                         style="height:10px;">

                        <div class="progress-bar bg-warning"
                             style="width:@percentualPendencias%">
                        </div>

                    </div>
                </div>

                <div class="alert alert-info mb-0"
                     style="border-radius:10px;">

                    <div class="fw-bold mb-2">
                        Análise Rápida
                    </div>

                    @GerarResumoSecretaria()

                </div>

            </div>

        </div>
    </div>
</div>

@code {

    private int quantidadeAlunos;
    private int quantidadeTurmas;

    private int quantidadePagas;
    private int quantidadePendentes;
    private int quantidadeAtrasadas;

    private int quantidadeDespesasPendentes;
    private int despesasPagas;
    private int despesasHoje;
    private int despesasMes;

    private int percentualPago;
    private int percentualPendencias;

    private DateTime mesAtual = DateTime.Now;

    private enum TipoExibicao
    {
        Mensalidades,
        Despesas,
        Ambos
    }

    private TipoExibicao tipoExibicao = TipoExibicao.Ambos;

    private List<Receita> Receitas = new();
    private List<Despesa> despesas = new();

    private int paginaAtividade = 1;
    private int itensPorPagina = 3;

    private List<AtividadeRecente> atividadesRecentes = new();

    private int TotalPaginasAtividade =>
        (int)Math.Ceiling((double)atividadesRecentes.Count / itensPorPagina);

    private List<AtividadeRecente> AtividadesPaginadas =>
        atividadesRecentes
            .Skip((paginaAtividade - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    protected override void OnInitialized()
    {
        if (Session.GetInstanceAccess().Level <= -1)
        {
            Navigation.NavigateTo("/signin");
            return;
        }

        Receitas = ReceitaController.GetAll();
        despesas = DespesaController.GetAll();

        quantidadeAlunos = AlunoController.GetAll().Count;
        quantidadeTurmas = TurmaController.GetAll().Count;

        AtualizarDadosDoMes();

        GerarAtividades();
    }

    private void AtualizarDadosDoMes()
    {
        AtualizarCardsDoMes();
        AtualizarDespesasDoMes();

        paginaAtividade = 1;
    }

    private List<Receita> ReceitasDoMes()
    {
        return Receitas
            .Where(r =>
                r.DataVencimento.Month == mesAtual.Month &&
                r.DataVencimento.Year == mesAtual.Year)
            .ToList();
    }

    private List<Despesa> DespesasDoMes()
    {
        return despesas
            .Where(d =>
                d.DataVencimento.Month == mesAtual.Month &&
                d.DataVencimento.Year == mesAtual.Year)
            .ToList();
    }

    private void AtualizarCardsDoMes()
    {
        var receitasDoMes = ReceitasDoMes();

        quantidadePagas = receitasDoMes.Count(r =>
            r.IsPago());

        quantidadePendentes = receitasDoMes.Count(r =>
            r.Status == Receita.FinanceStatus.EmAndamento);

        quantidadeAtrasadas = receitasDoMes.Count(r =>
            r.Status == Receita.FinanceStatus.EmAtraso);

        int totalReceitas = receitasDoMes.Count;

        if (totalReceitas > 0)
        {
            percentualPago =
                (int)((double)quantidadePagas / totalReceitas * 100);

            percentualPendencias =
                (int)((double)(quantidadePendentes + quantidadeAtrasadas)
                / totalReceitas * 100);
        }
        else
        {
            percentualPago = 0;
            percentualPendencias = 0;
        }
    }

    private void AtualizarDespesasDoMes()
    {
        var despesasDoMes = DespesasDoMes();

        quantidadeDespesasPendentes = despesasDoMes.Count(d =>
            !d.IsPago());

        despesasPagas = despesasDoMes.Count(d =>
            d.IsPago());

        despesasHoje = despesas.Count(d =>
            d.DataVencimento.Date == DateTime.Now.Date);

        despesasMes = despesasDoMes.Count;
    }

    private void GerarAtividades()
    {
        atividadesRecentes.Clear();

        var receitasDoMes = ReceitasDoMes();
        var despesasDoMes = DespesasDoMes();

        atividadesRecentes.AddRange(
            receitasDoMes
                .OrderByDescending(r => r.DataVencimento)
                .Take(5)
                .Select(r => new AtividadeRecente
                {
                    Data = r.DataVencimento,
                    Texto = $"Mensalidade '{r.Descricao}' - {r.GetStatusTexto()}"
                }));

        atividadesRecentes.AddRange(
            despesasDoMes
                .OrderByDescending(d => d.DataVencimento)
                .Take(5)
                .Select(d => new AtividadeRecente
                {
                    Data = d.DataVencimento,
                    Texto = $"Despesa '{d.Descricao}' - {(d.IsPago() ? "Paga" : "Pendente")}"
                }));

        atividadesRecentes =
            atividadesRecentes
                .OrderByDescending(a => a.Data)
                .Take(8)
                .ToList();
    }

    private string GerarResumoSecretaria()
    {
        if (quantidadeAtrasadas >= 10)
        {
            return "Existem muitas cobranças em atraso aguardando contato.";
        }

        if (quantidadePendentes >= 5)
        {
            return "Há pendências administrativas aguardando resolução.";
        }

        if (quantidadeDespesasPendentes >= 5)
        {
            return "Existem despesas pendentes aguardando confirmação.";
        }

        return "Fluxo administrativo funcionando normalmente.";
    }

    private void AlterarTipo(TipoExibicao tipo)
    {
        tipoExibicao = tipo;
    }

    private void MesAnterior()
    {
        mesAtual = mesAtual.AddMonths(-1);

        AtualizarDadosDoMes();

        GerarAtividades();
    }

    private void ProximoMes()
    {
        mesAtual = mesAtual.AddMonths(1);

        AtualizarDadosDoMes();

        GerarAtividades();
    }

    private void SelecionarDia(DateTime data)
    {

    }

    private List<DiaCalendario> ObterDiasDoMes()
    {
        var dias = new List<DiaCalendario>();

        int diasNoMes =
            DateTime.DaysInMonth(mesAtual.Year, mesAtual.Month);

        for (int i = 1; i <= diasNoMes; i++)
        {
            var data =
                new DateTime(mesAtual.Year, mesAtual.Month, i);

            int mensalidades = 0;
            int despesasDia = 0;
            int atrasos = 0;

            if (tipoExibicao == TipoExibicao.Mensalidades ||
                tipoExibicao == TipoExibicao.Ambos)
            {
                mensalidades = Receitas.Count(r =>
                    r.DataVencimento.Date == data.Date);

                atrasos = Receitas.Count(r =>
                    r.Status == Receita.FinanceStatus.EmAtraso &&
                    r.DataVencimento.Date == data.Date);
            }

            if (tipoExibicao == TipoExibicao.Despesas ||
                tipoExibicao == TipoExibicao.Ambos)
            {
                despesasDia = despesas.Count(d =>
                    d.DataVencimento.Date == data.Date);
            }

            dias.Add(new DiaCalendario
            {
                Data = data,
                Mensalidades = mensalidades,
                Despesas = despesasDia,
                Atrasos = atrasos
            });
        }

        return dias;
    }

    private class DiaCalendario
    {
        public DateTime Data { get; set; }

        public int Mensalidades { get; set; }

        public int Despesas { get; set; }

        public int Atrasos { get; set; }
    }

    private class AtividadeRecente
    {
        public DateTime Data { get; set; }

        public string Texto { get; set; } = "";
    }

    private void PaginaAnterior()
    {
        if (paginaAtividade > 1)
            paginaAtividade--;
    }

    private void ProximaPagina()
    {
        if (paginaAtividade < TotalPaginasAtividade)
            paginaAtividade++;
    }
}