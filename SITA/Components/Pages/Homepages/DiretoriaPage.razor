@namespace SITA.Maui.Components
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Storage
@using SITA.src.Util
@inject NavigationManager Navigation

<div class="container-fluid p-4" style="background-color: #f8f9fa; min-height: 100vh;">

	<!-- Cabeçalho de Boas-Vindas -->
	<div class="row mb-4">
		<div class="col-12">
			<h1 style="color: #3650a1; font-weight: bold;">Painel de Controle - Direção</h1>
		</div>
	</div>

	<!-- Seção de KPIs Principais -->
	<div class="row mb-4 mobile-gap ">
		<div class="col-md-3">
			<div class="card-kpi shadow-sm border-start border-primary border-4">
				<div class="icon-box" style="background: #e3f2fd;"><i class="oi oi-graph"></i></div>
				<div>
					<h6 class="text-muted mb-1">Mensalidades do Mês</h6>
					<h4 class="fw-bold mb-0" style="color: #3650a1;">R$ @Movimentacoes[Key].Receita.Mensalidades.ToString("N2")</h4>
					<small class="text-muted">@Movimentacoes[Key].Receita.qtMensalidades alunos - @Movimentacoes[Key].Receita.qtMensalidadesPagas pagas</small>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card-kpi shadow-sm border-start border-success border-4">
				<div class="icon-box" style="background: #e8f5e9;"><i class="oi oi-dollar"></i></div>
				<div>
					<h6 class="text-muted mb-1">Receitas Recebidas</h6>
					<h4 class="fw-bold mb-0" style="color: #2e7d32;">R$ @Movimentacoes[Key].Receita.Recebido.ToString("N2")<small style="font-size: x-small"> / @Movimentacoes[Key].Receita.Total.ToString("N2")</small></h4>
					<small class="text-muted">@Movimentacoes[Key].Receita.qtRecebido pagas</small>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card-kpi shadow-sm border-start border-danger border-4">
				<div class="icon-box" style="background: #ffebee;"><i class="oi oi-cart"></i></div>
				<div>
					<h6 class="text-muted mb-1">Despesas Pagas</h6>
					<h4 class="fw-bold mb-0" style="color: #c62828;">R$ @Movimentacoes[Key].Despesa.Pagas.ToString("N2")<small style="font-size: x-small"> / @Movimentacoes[Key].Despesa.Total.ToString("N2")</small></h4>
					<small class="text-muted">@Movimentacoes[Key].Despesa.qtPagas lançamentos - @Movimentacoes[Key].Despesa.qtPendentes pendentes</small>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card-kpi shadow-sm border-start border-info border-4">
				<div class="icon-box" style="background: @(SaldoLiquidoTotal >= 0 ? "#e0f7fa" : "#ffebee");"><i class="oi oi-badge"></i></div>
				<div>
					<h6 class="text-muted mb-1">Caixa</h6>
					<h4 class="fw-bold mb-0" style="color: @(SaldoLiquidoTotal >= 0 ? "#00838f" : "#c62828");">
						R$ @SaldoLiquidoTotal.ToString("N2")
					</h4>
					<small class="text-muted">Receitas - Despesas</small>
				</div>
			</div>
		</div>
	</div>

	<!-- Linha de Cards Secundários -->
	<div class="row mb-4 align-items-stretch">
		<div class="col-md-4 d-flex">
			<div class="card shadow-sm border-0 flex-fill dashboard-card" style="border-radius: 10px; padding: 20px;">

				<div class="d-flex justify-content-between align-items-center"
					 style="cursor:pointer;"
					 @onclick="() => fluxoCaixaAtivo = !fluxoCaixaAtivo">

					<h6 class="fw-bold m-0" style="color: #3650a1;">
						Fluxo de Caixa Acumulado
					</h6>

					<h6 class="fw-bold m-0"
						style="
                        transition: transform 0.25s ease;
                        transform: @(fluxoCaixaAtivo ? "rotate(180deg)" : "rotate(0deg)");
                        ">
						▾
					</h6>
				</div>

				<hr />

				<div class="dropdown-content @(fluxoCaixaAtivo ? "open" : "")">

					<div class="mb-2">
						<div class="d-flex justify-content-between">
							<span class="text-muted">Total Recebido (Geral):</span>
							<span class="fw-bold text-success">
								R$ @Movimentacoes[Key].Receita.Recebido.ToString("N2")
							</span>
						</div>
					</div>

					<div class="mb-3">
						<div class="d-flex justify-content-between">
							<span class="text-muted">Total Despesas (Geral):</span>
							<span class="fw-bold text-danger">
								R$ @Movimentacoes[Key].Despesa.Pagas.ToString("N2")
							</span>
						</div>
					</div>

					<hr />
				</div>

				<div class="mb-3">
					<div class="d-flex justify-content-between">
						<span class="fw-bold">Saldo Acumulado:</span>

						<span class="fw-bold fs-5"
							  style="color: @(Movimentacoes[Key].Saldo >= 0 ? "#2e7d32" : "#c62828");">
							R$ @Movimentacoes[Key].Saldo.ToString("N2")
						</span>
					</div>
				</div>

				<div class="progress" style="height: 25px;">
					@{
						double percent = 0;

						if (Movimentacoes[Key].Receita.Recebido != 0)
						{
							percent = (Math.Abs(Movimentacoes[Key].Saldo) / Math.Abs(Movimentacoes[Key].Receita.Recebido)) * 100;
						}

						bool isPositivo = Movimentacoes[Key].Saldo >= 0;
						
						percent = Math.Clamp(percent, 0, 100);
					}

					<div class="progress-bar @(isPositivo ? "bg-success" : "bg-danger")"
						 style="width: @(percent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%"
							  )">
						<span style="color: @(Movimentacoes[Key].Saldo <= 0 ? "#000000" : "#FFFFFFF")">
							@percent.ToString("F1")%
						</span>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-4 d-flex">
			<div class="card shadow-sm border-0 flex-fill dashboard-card" style="border-radius: 10px; padding: 20px;">

				<div class="d-flex justify-content-between align-items-center"
					 style="cursor:pointer;"
					 @onclick="() => pendenciasAtivo = !pendenciasAtivo">

					<h6 class="fw-bold m-0" style="color: #3650a1;">
						Pendências
					</h6>

					<h6 class="fw-bold m-0"
						style="
                        transition: transform 0.25s ease;
                        transform: @(pendenciasAtivo ? "rotate(180deg)" : "rotate(0deg)");
                        ">
						▾
					</h6>
				</div>

				<hr />

				<div class="dropdown-content @(pendenciasAtivo ? "open" : "")">

					<div class="mb-2">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-warning">Mensalidades Pendentes:</span>
							<span class="badge bg-warning text-dark">
                                @Movimentacoes[Key].Receita.qtMensalidadesPendentes
							</span>
						</div>

						<small class="text-muted">
							R$ @Movimentacoes[Key].Receita.MensalidadesPendentes.ToString("N2")
						</small>
					</div>

					<div class="mb-2">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-danger">Mensalidades Atrasadas:</span>
							<span class="badge bg-danger">
								@Movimentacoes[Key].Receita.qtMensalidadesAtrasadas
							</span>
						</div>

						<small class="text-muted">
							R$ @Movimentacoes[Key].Receita.Atrasadas.ToString("N2")
						</small>
					</div>

					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-warning">Despesas a Pagar:</span>
							<span class="badge bg-warning text-dark">
								@Movimentacoes[Key].Despesa.qtPendentes
							</span>
						</div>

						<small class="text-muted">
							R$ @Movimentacoes[Key].Despesa.Pendentes.ToString("N2")
						</small>
					</div>


				</div>
				<div class="alert alert-warning mb-0"
					 style="font-size: 0.85rem; padding: 10px;">

					<i class="oi oi-warning"></i>

					<strong>@(Movimentacoes[Key].Receita.qtAtrasadas)</strong>
					cobrança(s) vencida(s)
				</div>
			</div>
		</div>
		<div class="col-md-4 d-flex">
			<div class="card shadow-sm border-0 flex-fill dashboard-card"
				 style="border-radius: 10px; padding: 20px; cursor:pointer;"
				 @onclick="() => taxaAtivo = !taxaAtivo">

				<div class="d-flex justify-content-between align-items-center">

					<h6 class="fw-bold m-0" style="color: #3650a1;">
						Taxa de Recebimento
					</h6>

					<h6 class="fw-bold m-0"
						style="
						transition: transform 0.25s ease;
						transform: @(taxaAtivo ? "rotate(180deg)" : "rotate(0deg)");
						">
						▾
					</h6>
				</div>

				<hr />

				<div class="dropdown-content @(taxaAtivo ? "open" : "")">

					<div class="mt-2">

						<div class="d-flex justify-content-between mb-2">
							<span>Recebido</span>
							<span class="fw-bold text-success">
								@percentualRecebido%
							</span>
						</div>

						<div class="progress mb-4" style="height: 10px;">
							<div class="progress-bar bg-success"
								 style="width: @($"{percentualRecebido}%")">
							</div>
						</div>

						<div class="d-flex justify-content-between mb-2">
							<span>Pendente</span>
							<span class="fw-bold text-warning">
								@percentualPendente%
							</span>
						</div>

						<div class="progress mb-4" style="height: 10px;">
							<div class="progress-bar bg-warning"
								 style="width: @($"{percentualPendente}%")">
							</div>
						</div>

						<div class="d-flex justify-content-between mb-2">
							<span>Atrasado</span>
							<span class="fw-bold text-danger">
								@percentualAtrasado%
							</span>
						</div>

						<div class="progress mb-3" style="height: 10px;">
							<div class="progress-bar bg-danger"
								 style="width: @($"{percentualAtrasado}%")">
							</div>
						</div>

					</div>
				</div>

				@{
					var analise = GerarAnaliseFinanceira();
				}

				<div class="alert alert-info mb-0"
					 style="font-size: 0.85rem; padding: 10px;">

					<div class="fw-bold mb-2 d-flex justify-content-between">
						<span>Análise Rápida</span>

						<span class="@analise.classe">
							Score: @Math.Round(analise.score)/100
						</span>
					</div>

					<span class="@analise.classe">
						@analise.mensagem
					</span>
				</div>
			</div>
		</div>
	</div>

	<div class="row mb-6">
		<!-- Calendário Financeiro -->
		<div class="col-md-12">
			<div class="card p-4 shadow-sm border-0" style="border-radius: 15px; height: 100%;">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h5 class="fw-bold mb-0" style="color: #3650a1;">Calendário Financeiro</h5>
					<div class="btn-group" role="group">
						<button type="button" class="btn btn-sm @(tipoExibicao == TipoExibicao.Receitas ? "btn-success" : "btn-outline-success")" @onclick="() => AlterarTipo(TipoExibicao.Receitas)">
							Receitas
						</button>
						<button type="button" class="btn btn-sm @(tipoExibicao == TipoExibicao.Despesas ? "btn-danger" : "btn-outline-danger")" @onclick="() => AlterarTipo(TipoExibicao.Despesas)">
							Despesas
						</button>
						<button type="button" class="btn btn-sm @(tipoExibicao == TipoExibicao.Ambos ? "btn-primary" : "btn-outline-primary")" @onclick="() => AlterarTipo(TipoExibicao.Ambos)">
							Ambos
						</button>
					</div>
				</div>

				<div class="calendar-container p-2" style="height: 600px; overflow-y: auto;">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<button type="button" class="btn btn-sm btn-outline-secondary py-1 px-1" style="font-size: 0.75rem; width:10%;" @onclick="MesAnterior">
							◄
						</button>
						<h6 class="mb-0 fw-bold">@mesAtual.ToString("MMMM yyyy")</h6>
						<button type="button" class="btn btn-sm btn-outline-secondary py-1 px-1" style="font-size: 0.75rem; width:10%;" @onclick="ProximoMes">
							►
						</button>
					</div>

					<div class="calendar-grid" style="max-width: 100%;">
						<div class="calendar-header">
							<div class="calendar-day-name">Dom</div>
							<div class="calendar-day-name">Seg</div>
							<div class="calendar-day-name">Ter</div>
							<div class="calendar-day-name">Qua</div>
							<div class="calendar-day-name">Qui</div>
							<div class="calendar-day-name">Sex</div>
							<div class="calendar-day-name">Sáb</div>
						</div>
						<div class="calendar-days">
							@foreach (var dia in ObterDiasDoMes())
							{
								var isHoje = dia.Data.Date == DateTime.Now.Date;
								var isSelecionado = dia.Data.Date == dataSelecionada.Date;
								var cssClass = $"calendar-day {(dia.ForaDoMes ? "fora-mes" : "")} {(isHoje ? "hoje" : "")} {(isSelecionado ? "selecionado" : "")}";

								<a href="#transacoes-dia" style="text-decoration: none; color: black;">
									<div class="@cssClass" @onclick="() => SelecionarDia(dia.Data)">
										<div class="day-number">@dia.Data.Day</div>
										@if (!dia.ForaDoMes && dia.Total != 0)
										{
											<div class="day-value @(dia.Total > 0 ? "positivo" : "negativo")">
												@(dia.Total > 0 ? "+" : "")@dia.Total.ToString("N0")
											</div>
										}
									</div>
								</a>
							}
						</div>
					</div>

					
				</div>
				@if (dataSelecionada != DateTime.MinValue)
				{
					<div class="mt-3 p-3" style="background: #f8f9fa; border-radius: 10px;" id="transacoes-dia">
						<h6 class="fw-bold mb-2">@dataSelecionada.ToString("dd/MM/yyyy")</h6>
						@if (ObterTransacoesDoDia().Any())
						{
							<div class="list-group list-group-flush">
								@foreach (var item in ObterTransacoesDoDia())
								{
									<div class="list-group-item px-0 py-2 bg-transparent border-0">
										<div class="d-flex justify-content-between align-items-start">
											<div class="flex-grow-1">
												<small class="text-muted">@item.Tipo</small>
												<div class="fw-bold" style="font-size: 0.9rem;">@item.Descricao</div>
												@if (!string.IsNullOrEmpty(item.Status))
												{
													<span class="badge @GetStatusBadgeClass(item.Status) mt-1" style="font-size: 0.7rem;">
														@item.Status
													</span>
												}
											</div>
											<span class="badge @(item.Valor > 0 ? "bg-success" : "bg-danger") ms-2">
												@(item.Valor > 0 ? "+" : "")R$ @Math.Abs(item.Valor).ToString("N2")
											</span>
										</div>
									</div>
								}
							</div>
						}
						else
						{
							<p class="text-muted small mb-0">Nenhuma transação neste dia.</p>
						}
					</div>
				}
			</div>
		</div>
	</div>
</div>

@code {
	private (int, int) Key => (mesAtual.Month, mesAtual.Year);

	private FinanceData DadosAtual => Movimentacoes.ContainsKey(Key) ? Movimentacoes[Key] : new FinanceData();

	private class FinanceData
	{
		public ReceitaData Receita = new ReceitaData();
		public DespesaData Despesa = new DespesaData();
		public double Saldo = 0;

		public class ReceitaData
		{
			public double Total = 0;
			public double Recebido = 0;
			public double Mensalidades = 0;
			public double MensalidadesPagas = 0;
			public double MensalidadesPendentes = 0;
			public double MensalidadesAtrasadas = 0;
			public double Pendentes = 0;
			public double Atrasadas = 0;

			public int qtMensalidades = 0;
			public int qtMensalidadesPagas = 0;
			public int qtMensalidadesPendentes = 0;
			public int qtMensalidadesAtrasadas = 0;
			public int qtRecebido = 0;
			public int qtPendentes = 0;
			public int qtAtrasadas = 0;
		}

		public class DespesaData
		{
			public double Total = 0;
			public double Pagas = 0;
			public double Pendentes = 0;
			public int qtPagas = 0;
			public int qtPendentes = 0;
		}

		public void CalcularSaldo()
		{
			Saldo = Receita.Recebido - Despesa.Pagas;
		}
	}

	private Dictionary<(int month, int year), FinanceData> Movimentacoes = new();

	private double SaldoLiquidoTotal = 0;

	private int percentualRecebido = 0;
	private int percentualPendente = 0;
	private int percentualAtrasado = 0;

	private bool visaoGeralMesAtivo = true;
	private bool fluxoCaixaAtivo = true;
	private bool pendenciasAtivo = true;
	private bool taxaAtivo = true;

	private enum TipoExibicao { Receitas, Despesas, Ambos }
	private TipoExibicao tipoExibicao = TipoExibicao.Ambos;

	private DateTime mesAtual = DateTime.Now;
	private DateTime dataSelecionada = DateTime.Now;

	private List<Receita> todasReceitas = new();
	private List<Despesa> todasDespesas = new();

	protected override void OnInitialized()
	{
		if (Session.GetInstanceAccess().Level <= -1)
		{
			Navigation.NavigateTo("/signin");
			return;
		}

		CarregarDados();
		CalcularDados();
	}

	private void CarregarDados()
	{
		todasReceitas = ReceitaController.GetAll();
		todasDespesas = DespesaController.GetAll();

		SaldoLiquidoTotal = todasReceitas.Where(r => r.DataVencimento.Year == mesAtual.Year && r.GetStatusTexto() == "Pago").Sum(r => r.GetValorTotal()) - todasDespesas.Where(d => d.DataVencimento.Year == mesAtual.Year && d.IsPago()).Sum(d => d.GetValorTotal());
	}

	private void CalcularDados()
	{
		// Se já calculou, apenas atualiza UI
		if (Movimentacoes.ContainsKey(Key))
		{
			AtualizarPercentuais();
			return;
		}

		var ReceitasMesAtual = todasReceitas
			.Where(r => r.DataReferente.Month == mesAtual.Month && r.DataReferente.Year == mesAtual.Year)
			.ToList();

		var despesasMesAtual = todasDespesas
					.Where(d => d.DataReferente.Month == mesAtual.Month && d.DataReferente.Year == mesAtual.Year)
					.ToList();

		var financeData = new FinanceData();

		foreach (var Receita in ReceitasMesAtual)
		{
			double valor = (double)Receita.GetValorTotal();
			bool isMensalidade = Receita.GetTypeTexto() == "Mensalidade";

			financeData.Receita.Total += valor;

			switch (Receita.Status)
			{
				case Receita.FinanceStatus.Pago:
					financeData.Receita.Recebido += valor;
					financeData.Receita.qtRecebido++;
					if (isMensalidade)
					{
						financeData.Receita.MensalidadesPagas += valor;
						financeData.Receita.qtMensalidadesPagas++;
					}
					break;

				case Receita.FinanceStatus.Pendente:
					financeData.Receita.Pendentes += valor;
					financeData.Receita.qtPendentes++;
					if (isMensalidade)
					{
						financeData.Receita.MensalidadesPendentes += valor;
						financeData.Receita.qtMensalidadesPendentes++;
					}
					break;

				case Receita.FinanceStatus.EmAndamento:
					financeData.Receita.Pendentes += valor;
					financeData.Receita.qtPendentes++;
					if (isMensalidade)
					{
						financeData.Receita.MensalidadesPendentes += valor;
						financeData.Receita.qtMensalidadesPendentes++;
					}
					break;

				case Receita.FinanceStatus.EmAtraso:
					financeData.Receita.Atrasadas += valor;
					financeData.Receita.qtAtrasadas++;
					if (isMensalidade)
					{
						financeData.Receita.MensalidadesAtrasadas += valor;
						financeData.Receita.qtMensalidadesAtrasadas++;
					}
					break;
			}

			if (isMensalidade)
			{
				financeData.Receita.Mensalidades += valor;
				financeData.Receita.qtMensalidades++;
			}
		}

		foreach (var despesa in despesasMesAtual)
		{
			double valor = (double)despesa.GetValorTotal();
			financeData.Despesa.Total += valor;

			if (despesa.IsPago())
			{
				financeData.Despesa.Pagas += valor;
				financeData.Despesa.qtPagas++;
			}
			else
			{
				financeData.Despesa.Pendentes += valor;
				financeData.Despesa.qtPendentes++;
			}
		}

		financeData.CalcularSaldo();
		Movimentacoes[Key] = financeData;
		AtualizarPercentuais();
	}

	private void AtualizarPercentuais()
	{
		var dados = DadosAtual;

		if (dados.Receita.Total > 0)
		{
			percentualRecebido = (int)((dados.Receita.Recebido / dados.Receita.Total) * 100);
			percentualPendente = (int)((dados.Receita.Pendentes / dados.Receita.Total) * 100);
			percentualAtrasado = (int)((dados.Receita.Atrasadas / dados.Receita.Total) * 100);
		}
		else
		{
			percentualRecebido = percentualPendente = percentualAtrasado = 0;
		}
	}

	private (string mensagem, string classe, double score) GerarAnaliseFinanceira()
	{
		var dados = DadosAtual;
		double score = 0;

		if (percentualRecebido >= 90) score += 35;
		else if (percentualRecebido >= 75) score += 25;
		else if (percentualRecebido >= 60) score += 15;
		else score += 5;

		if (dados.Receita.Total > 0) score += 25;
		else if (dados.Receita.Total >= -(dados.Receita.Mensalidades * 0.1)) score += 10;
		else score -= 15;

		if (dados.Receita.qtAtrasadas == 0) score += 20;
		else if (dados.Receita.qtAtrasadas <= 3) score += 10;
		else if (dados.Receita.qtAtrasadas <= 6) score += 0;
		else score -= 15;

		double percentualDespesas = dados.Receita.Recebido > 0
			? (dados.Despesa.Pagas / dados.Receita.Recebido) * 100
			: 100;

		if (percentualDespesas <= 50) score += 20;
		else if (percentualDespesas <= 75) score += 10;
		else if (percentualDespesas <= 90) score += 0;
		else score -= 15;

		score = Math.Clamp(score, 0, 100);

		string mensagem, classe;

		if (score >= 80)
		{
			mensagem = "Situação financeira excelente. Fluxo de caixa saudável e baixa inadimplência.";
			classe = "text-success";
		}
		else if (score >= 60)
		{
			mensagem = "Situação financeira estável, mas existem pontos de atenção.";
			classe = "text-primary";
		}
		else if (score >= 40)
		{
			mensagem = "Atenção ao fluxo financeiro. Existem atrasos e margem reduzida.";
			classe = "text-warning";
		}
		else
		{
			mensagem = "Situação financeira crítica. Necessário revisar recebimentos e despesas.";
			classe = "text-danger";
		}

		return (mensagem, classe, score);
	}

	private void AlterarTipo(TipoExibicao tipo)
	{
		tipoExibicao = tipo;
	}

	private void MesAnterior()
	{
		mesAtual = mesAtual.AddMonths(-1);
		CalcularDados();
	}

	private void ProximoMes()
	{
		mesAtual = mesAtual.AddMonths(1);
		CalcularDados();
	}

	private void SelecionarDia(DateTime data)
	{
		dataSelecionada = data;
	}

	private List<DiaCalendario> ObterDiasDoMes()
	{
		var dias = new List<DiaCalendario>();
		var primeiroDia = new DateTime(mesAtual.Year, mesAtual.Month, 1);
		var ultimoDia = primeiroDia.AddMonths(1).AddDays(-1);

		var diaSemanaInicio = (int)primeiroDia.DayOfWeek;
		var dataInicio = primeiroDia.AddDays(-diaSemanaInicio);

		for (int i = 0; i < 42; i++)
		{
			var data = dataInicio.AddDays(i);
			var foraDoMes = data.Month != mesAtual.Month;
			var total = CalcularTotalDoDia(data);

			dias.Add(new DiaCalendario
			{
				Data = data,
				ForaDoMes = foraDoMes,
				Total = total
			});
		}

		return dias;
	}

	private float CalcularTotalDoDia(DateTime data)
	{
		float total = 0;

		if (tipoExibicao == TipoExibicao.Receitas || tipoExibicao == TipoExibicao.Ambos)
		{
			total += todasReceitas
				.Where(r =>
				{
					// Se não está paga: mostrar no DataReferente
					if (!r.IsPago())
					{
						return r.DataReferente.Date == data.Date;
					}

					// Se está paga: verificar se estava atrasada
					// Atrasada = DataPagamento > DataVencimento
					bool estavaAtrasada = r.DataPagamento.HasValue && r.DataPagamento.Value.Date > r.DataVencimento.Date;

					if (estavaAtrasada)
					{
						// Se pagou com atraso: mostrar no DataReferente
						return r.DataReferente.Date == data.Date;
					}
					else
					{
						// Se pagou no prazo: mostrar no DataPagamento
						return r.DataPagamento?.Date == data.Date;
					}
				})
				.Sum(r => r.GetValorTotal());
		}

		if (tipoExibicao == TipoExibicao.Despesas || tipoExibicao == TipoExibicao.Ambos)
		{
			total -= todasDespesas
				.Where(d =>
				{
					if (!d.IsPago())
					{
						return d.DataReferente.Date == data.Date;
					}

					bool estavaAtrasada = d.DataPagamento.HasValue && d.DataPagamento.Value.Date > d.DataVencimento.Date;

					if (estavaAtrasada)
					{
						return d.DataReferente.Date == data.Date;
					}
					else
					{
						return d.DataPagamento?.Date == data.Date;
					}
				})
				.Sum(d => d.GetValorTotal());
		}

		return total;
	}

	private List<TransacaoDia> ObterTransacoesDoDia()
	{
		var transacoes = new List<TransacaoDia>();

		if (tipoExibicao == TipoExibicao.Receitas || tipoExibicao == TipoExibicao.Ambos)
		{
			var receitas = todasReceitas
				.Where(r =>
				{
					if (!r.IsPago())
					{
						return r.DataReferente.Date == dataSelecionada.Date;
					}

					bool estavaAtrasada = r.DataPagamento.HasValue && r.DataPagamento.Value.Date > r.DataVencimento.Date;

					if (estavaAtrasada)
					{
						return r.DataReferente.Date == dataSelecionada.Date;
					}
					else
					{
						return r.DataPagamento?.Date == dataSelecionada.Date;
					}
				})
				.Select(r => new TransacaoDia
				{
					Descricao = r.Descricao ?? "Sem descrição",
					Valor = r.GetValorTotal(),
					Tipo = r.GetTypeTexto(),
					Status = ObterStatusDetalhado(r)
				});
			transacoes.AddRange(receitas);
		}

		if (tipoExibicao == TipoExibicao.Despesas || tipoExibicao == TipoExibicao.Ambos)
		{
			var despesas = todasDespesas
				.Where(d =>
				{
					if (!d.IsPago())
					{
						return d.DataReferente.Date == dataSelecionada.Date;
					}

					bool estavaAtrasada = d.DataPagamento.HasValue && d.DataPagamento.Value.Date > d.DataVencimento.Date;

					if (estavaAtrasada)
					{
						return d.DataReferente.Date == dataSelecionada.Date;
					}
					else
					{
						return d.DataPagamento?.Date == dataSelecionada.Date;
					}
				})
				.Select(d => new TransacaoDia
				{
					Descricao = d.Descricao ?? "Sem descrição",
					Valor = -d.GetValorTotal(),
					Tipo = d.Categoria ?? "Despesa",
					Status = ObterStatusDetalhado(d)
				});
			transacoes.AddRange(despesas);
		}

		return transacoes.OrderByDescending(t => Math.Abs(t.Valor)).ToList();
	}

	private string ObterStatusDetalhado(Financeiro financeiro)
	{
		if (!financeiro.IsPago())
		{
			return financeiro.GetStatusTexto();
		}

		bool estavaAtrasada = financeiro.DataPagamento.HasValue &&
								  financeiro.DataPagamento.Value.Date > financeiro.DataVencimento.Date;

		if (estavaAtrasada)
		{
			return $"Pago com atraso em {financeiro.DataPagamento?.ToString("dd/MM/yyyy")}";
		}

		return "Pago";
	}

	private string GetStatusBadgeClass(string status)
	{
		return status switch
		{
			"Pago" => "bg-success",
			"Em andamento" => "bg-warning text-dark",
			"Em atraso" => "bg-danger",
			"Pendente" => "bg-warning text-dark",
			_ => "bg-secondary"
		};
	}

	private class DiaCalendario
	{
		public DateTime Data { get; set; }
		public bool ForaDoMes { get; set; }
		public float Total { get; set; }
	}

	private class TransacaoDia
	{
		public string Descricao { get; set; }
		public float Valor { get; set; }
		public string Tipo { get; set; }
		public string Status { get; set; }
	}
