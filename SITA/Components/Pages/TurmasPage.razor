@page "/turmas"
@using SITA.Components.Pages.GUI
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="header">
    <h1>Turmas</h1>

    <input type="text"
           placeholder="Pesquisar"
           @bind="search"
           @bind:event="oninput" />
</div>

<div class="campo-btn">
    <button @onclick="AbrirModal">Cadastrar Turma</button>
</div>

<section class="container-card">

    @foreach (var turma in turmas)
    {
        <div class="card" @onclick="() => GoToTurma(turma.Id)">
            <h4>@turma.Nome</h4>
            <p>@(turma.Professor?.Nome ?? "Sem professor")</p>
            <p>@turma.Alunos.Count alunos</p>
            <p>@turma.Turno</p>
        </div>
    }

</section>

<Modal IsOpen="showModal" OnClose="FecharModal">

    <h3>Nova Turma</h3>

    <input @bind="nome" placeholder="Nome da turma" />

    <select @bind="turno">
        @foreach (var t in Turma.Turnos)
        {
            <option value="@t">@t</option>
        }
    </select>

    <div class="modal-actions">
        <button @onclick="Cadastrar">Salvar</button>
        <button class="cancel" @onclick="FecharModal">Cancelar</button>
    </div>

</Modal>

@code {
    private List<Turma> turmas = new();
    private string search = "";

    private bool showModal = false;
    private string nome = "";
    private string turno = Turma.Turnos[0];

    protected override void OnParametersSet()
    {
        var storage = MauiProgram.AppStorage.GetStorage<Turma>();
        turmas = storage.Values.ToList();
    }

    IEnumerable<Turma> TurmasFiltradas =>
        turmas.Where(t =>
            string.IsNullOrWhiteSpace(search) ||
            t.Nome.Contains(search, StringComparison.OrdinalIgnoreCase));

    void AbrirModal()
    {
        nome = "";
        turno = Turma.Turnos[0];
        showModal = true;
    }

    void FecharModal()
    {
        showModal = false;
    }

    void Cadastrar()
    {
        if (string.IsNullOrWhiteSpace(nome))
            return;

        var turma = new Turma
        {
            Nome = nome,
            Turno = turno
        };

        TurmaController.Register(turma);
        var storage = MauiProgram.AppStorage.GetStorage<Turma>();
        turmas = storage.Values.ToList();

        showModal = false;
    }

    void Excluir(Turma turma)
    {
        TurmaController.Delete(turma);
    }
    void GoToTurma(Guid id)
    {
        Navigation.NavigateTo($"/turma/{id}");
    }
}