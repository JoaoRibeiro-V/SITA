@page "/"
@namespace SITA.Maui.Components
@using SITA.src.Model
@using SITA.src.Controller
@using SITA.src.Storage
@inject NavigationManager Navigation

<div class="container-fluid p-4" style="background-color: #f8f9fa; min-height: 100vh;">
    
    <!-- Cabeçalho de Boas-Vindas -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 style="color: #000080; font-weight: bold;">Painel de Controle - Direção</h2>
            <p class="text-muted">Resumo estratégico do SITA em tempo real.</p>
        </div>
    </div>

    <!-- Seção de Quadrados (KPIs) -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card-kpi shadow-sm">
                <div class="icon-box" style="background: #e3f2fd;"><i class="oi oi-graph"></i></div>
                <div>
                    <h5 class="text-muted">Mensalidades do Mês</h5>
                    <h3 class="fw-bold" style="color: #000080;">R$ @totalMensalidades.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-kpi shadow-sm border-start border-success border-5">
                <div class="icon-box" style="background: #e8f5e9;"><i class="oi oi-dollar"></i></div>
                <div>
                    <h5 class="text-muted">Total Recebido</h5>
                    <h3 class="fw-bold" style="color: #2e7d32;">R$ @totalRecebido.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-kpi shadow-sm border-start border-danger border-5">
                <div class="icon-box" style="background: #ffebee;"><i class="oi oi-cart"></i></div>
                <div>
                    <h5 class="text-muted">Despesas Pendentes</h5>
                    <h3 class="fw-bold" style="color: #c62828;">R$ @totalDespesas.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Calendário Escolar -->
        <div class="col-md-8">
            <div class="card p-3 shadow-sm border-0" style="border-radius: 15px; height: 100%;">
                <h5 class="fw-bold mb-3" style="color: #000080;">Calendário de Eventos</h5>
                <div class="calendar-placeholder d-flex align-items-center justify-content-center" style="background: #f1f1f1; height: 400px; border-radius: 10px;">
                
                    <p class="text-muted">Carregando Calendário Escolar...</p>
                </div>
            </div>
        </div>

        <!-- Resumo Financeiro Lateral -->
        <div class="col-md-4">
            <div class="card p-4 shadow-sm border-0" style="border-radius: 15px; background: white; height: 100%;">
                <h4 class="fw-bold" style="color: #000080; border-bottom: 2px solid #eee; padding-bottom: 10px;">Resumo Financeiro</h4>
                
                <div class="mt-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Recebido</span>
                        <span class="fw-bold text-success">@percentualRecebido%</span>
                    </div>
                    <div class="progress mb-4" style="height: 10px;">
                        <div class="progress-bar bg-success" style="width: @percentualRecebido%"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Em Aberto</span>
                        <span class="fw-bold text-warning">@percentualPendente%</span>
                    </div>
                    <div class="progress mb-4" style="height: 10px;">
                        <div class="progress-bar bg-warning" style="width: @percentualPendente%"></div>
                    </div>
                </div>

                <div class="alert alert-info mt-auto" style="border-radius: 10px; font-size: 0.9rem;">
                    <i class="oi oi-info"></i> Existem <strong>5 pedidos</strong> de uniformes aguardando aprovação.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private double totalMensalidades = 0;
    private double totalRecebido = 0;
    private double totalDespesas = 4535.18; 
    private int percentualRecebido = 75;
    private int percentualPendente = 25;

    protected override void OnInitialized()
    {
        if (MauiProgram.AppSession.GetInstanceAccess().Level <= -1)
        {
            Navigation.NavigateTo("/signin");
            return;
        }

        CalcularDados();
    }

    private void CalcularDados()
    {
       
        var todasReceitas = ReceitaController.GetAll();
        totalRecebido = todasReceitas.Where(r => r.Status == 1).Sum(r => (double)r.Valor);
        totalMensalidades = todasReceitas.Where(r => r.DataVencimento.Month == DateTime.Now.Month).Sum(r => (double)r.Valor);
        
  
        double totalGeral = todasReceitas.Sum(r => (double)r.Valor);
        if (totalGeral > 0)
        {
            percentualRecebido = (int)((totalRecebido / totalGeral) * 100);
            percentualPendente = 100 - percentualRecebido;
        }
    }
}