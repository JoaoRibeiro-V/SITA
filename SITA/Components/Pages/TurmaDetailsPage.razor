@page "/turma/{Id:guid}"
@using SITA.src.Model
@inject NavigationManager Navigation

<div class="page-bg">

    @if (turma == null)
    {
        <p>Turma não encontrada</p>
    }
    else
    {
        <div class="form-container">

            <h2>@turma.Nome</h2>

            <div class="field">
                <label>Professor</label>
                <span>@(turma.Professor?.Nome ?? "Não definido")</span>
            </div>

            <div class="field">
                <label>Turno</label>
                <span>@turma.Turno</span>
            </div>

            <div class="field">
                <label>Total de Alunos</label>
                <span>@turma.Alunos.Count</span>
            </div>

            <h3>Alunos</h3>

            @if (turma.Alunos.Count == 0)
            {
                <p>Nenhum aluno cadastrado</p>
            }
            else
            {
                <div class="aluno-list">
                    @foreach (var aluno in turma.Alunos)
                    {
                        <div class="aluno-card" @onclick="() => GoAluno(aluno.Id)">
                            <strong>@aluno.Nome</strong>
                            <span>RA: @aluno.RA</span>
                            <span>Idade: @(aluno.Idade?.ToString() ?? "-")</span>
                        </div>
                    }
                </div>
            }

            <button @onclick="Voltar">Voltar</button>

        </div>
    }

</div>

@code {
    [Parameter] public Guid Id { get; set; }

    Turma? turma;

    protected override void OnInitialized()
    {
        var storage = MauiProgram.AppStorage.GetStorage<Turma>();
        turma = storage.Values.FirstOrDefault(t => t.Id == Id);
    }

    void Voltar()
    {
        Navigation.NavigateTo("/turmas");
    }
    void GoAluno(Guid id)
    {
        Navigation.NavigateTo($"/aluno-details/{id}");
    }
}