@page "/turma/{TurmaIdGuid:guid}"
@using SITA.src.Model
@using SITA.src.Storage
@using SITA.src.Controller
@inject NavigationManager Navigation

<div class="container mt-4" style="background-color: white; padding: 25px; border-radius: 12px; border: 2px solid #3650a1;">
    @if (turma == null)
    {
        <div class="alert alert-info">Carregando dados da turma...</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center">
            <h2 style="color: #3650a1; font-weight: bold;">Turma: @turma.Nome</h2>
            <span class="badge bg-primary">ID: @turma.Id.ToString().Substring(0, 8)</span>
        </div>
        <hr />

        <!-- Seção do Professor -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="p-3" style="background-color: #f0f8ff; border-radius: 8px; border-left: 5px solid #3650a1;">
                    <h5 class="mb-1"><b>Professor Responsável</b></h5>
                    @if (professor != null)
                    {
                        <p class="mb-0">@professor.Nome — <small>@professor.Cargo</small></p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Nenhum professor vinculado a esta turma.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Lista de Alunos -->
        <h4 style="color: #3650a1;">Lista de Alunos (@alunosDaTurma.Count)</h4>
        <div class="table-responsive">
            <table class="table table-striped table-hover mt-2">
                <thead style="background-color: #3650a1; color: white;">
                    <tr>
                        <th>Nome do Aluno</th>
                        <th>RA</th>
                        <th>Idade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aluno in alunosDaTurma)
                    {
                        <tr>
                            
                                <td><a href="#" @onclick="() => GoAluno(aluno.Id)">@aluno.Nome</a></td>
                            <td>@aluno.RA</td>
                            <td>@aluno.CalcularIdade() anos</td>
                        </tr>
                    }
                    @if (!alunosDaTurma.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">Nenhum aluno matriculado nesta turma.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public Guid TurmaIdGuid { get; set; }

    private Turma? turma;
    private Funcionario? professor;
    private List<Aluno> alunosDaTurma = new List<Aluno>();

    protected override void OnInitialized()
    {
        CarregarDadosDaTurma();
    }

    private void CarregarDadosDaTurma()
    {
        // 1. Busca a Turma no Storage
        turma = TurmaController.Get(TurmaIdGuid.ToString(), null);

        if (turma != null)
        {
            // 2. Busca o Professor usando o ProfessorId armazenado na Turma
            if (turma.Professor != null)
            {
                professor = FuncionarioController.Get(turma.Professor.Id.ToString(), null);
            }

            // 3. Busca os Alunos comparando os IDs da lista da Turma com o Storage Global
            alunosDaTurma = turma.Alunos.ToList();
        }
    }
    void GoAluno(Guid id) => Navigation.NavigateTo($"/aluno-details/{id}");
}