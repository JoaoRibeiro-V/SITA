@page "/aluno-details/{id:guid}"
@using SITA.src.Model
@using SITA.src.Util
@using SITA.src.Controller
@using System.Text.Json
@inject NavigationManager Navigation

<div class="container" style="background-color: white; padding: 30px; border-radius: 12px; border: 2px solid #000080; max-width: 950px; margin: 20px auto; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">

    <div style="text-align: center; border-bottom: 2px solid #000080; margin-bottom: 30px; padding-bottom: 10px;">
        <h2 style="color: #000080; font-weight: bold;">FICHA DE MATRÍCULA COMPLETA</h2>
    </div>

    <!-- SEÇÃO 1: Dados do Aluno -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="fw-bold" style="color: #000080;">Nome Completo do Aluno:</label>
            <input class="form-control border-navy" @bind="Nome" />
        </div>
        <div class="col-md-3">
            <label class="fw-bold" style="color: #000080;">Data de Nascimento:</label>
            <input type="date" class="form-control border-navy" @bind="dataNascimento" @bind:after="() => CalcularIdade()" />
        </div>
        <div class="col-md-3">
            <label class="fw-bold text-muted">Idade Calculada:</label>
            <div class="p-2 bg-light border rounded">@idadeExtenso</div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <label class="fw-bold" style="color: #000080;">RA:</label>
            <input readonly class="form-control border-navy" @bind="RA" />
        </div>
        <div class="col-md-4">
            <label class="fw-bold" style="color: #000080;">Religião:</label>
            <input class="form-control border-navy" @bind="Religiao" />
        </div>
        <div class="col-md-4">
            <label class="fw-bold" style="color: #000080;">Turma:</label>
            <select class="form-select border-navy" @bind="turmaId">
                <option value="">Selecione...</option>
                @foreach (var t in listaTurmas)
                {
                    <option value="@t.Id">@t.Nome</option>
                }
            </select>
        </div>
    </div>

    <!-- SEÇÃO 2: Dados do Responsável -->
    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #000080;">
        <h5 style="color: #000080; font-weight: bold;">Dados do Responsável</h5>
        <div class="row mt-3 position-relative">
            <div class="col-md-6">
                <label class="fw-bold">CPF do Responsável:</label>

                <input class="form-control @(responsavelSelecionado != null ? "border-success" : "")"
                       @bind="responsavelCpf"
                       @oninput="OnCpfInput"
                       onkeypress="onlyNumbers(event)"
                       placeholder="000.000.000-00"
                       maxlength="14" />

                @if (sugestoesResponsaveis.Any())
                {
                    <div class="list-group position-absolute w-100" style="z-index: 1000;">
                        @foreach (var r in sugestoesResponsaveis)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action"
                                    @onclick="() => SelecionarResponsavel(r)">
                                <strong>@r.Nome</strong><br />
                                <small>@Mask.FormatCpf(r.CPF)</small>
                            </button>
                        }
                    </div>
                }

                @if (responsavelSelecionado != null)
                {
                    <div class="text-success mt-1">
                        ✔ @responsavelSelecionado.Nome selecionado
                    </div>
                }
            </div>

            <div class="col-md-6">
                <label class="fw-bold">Grau de Parentesco:</label>
                <select class="form-select" @bind="tipoParentesco">
                    <option value="1">Pai / Mãe</option>
                    <option value="2">Avô / Avó</option>
                    <option value="3">Tio / Tia</option>
                    <option value="6">Outro Responsável</option>
                </select>
            </div>
        </div>
    </div>

    <!-- SEÇÃO 3: Saúde e Emergência -->
    <div style="background-color: #fff5f5; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 5px solid #d9534f;">
        <h5 style="color: #d9534f; font-weight: bold;">Saúde e Emergência</h5>

        <div class="row mt-3">
            <div class="col-md-6">
                <label class="fw-bold">Pediatra do Aluno:</label>
                <input class="form-control" @bind="Pediatra" />
            </div>
            <div class="col-md-6">
                <label class="fw-bold">Orientações de Emergência:</label>
                <textarea class="form-control" @bind="Orientacoes"></textarea>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label>Alergias (Enter):</label>
                <input class="form-control" @bind="addAlergia" @onkeyup="HandleAlergiaKeyUp" />
                <div class="mt-2">
                    @foreach (var a in Alergias)
                    {
                        <span class="badge bg-danger me-1">@a</span>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <label>Condições Especiais:</label>
                <input class="form-control" @bind="addCondicao" @onkeyup="HandleCondicoesKeyUp" />
                <div class="mt-2">
                    @foreach (var c in CondicoesEspeciais)
                    {
                        <span class="badge bg-warning text-dark me-1">@c</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Botões -->
    <div class="d-flex gap-3 mt-4">
        <button class="btn btn-outline-secondary w-25 p-3 fw-bold" @onclick="CancelarEdicao")'>CANCELAR</button>
        <button class="btn w-75 p-3 fw-bold" style="background-color: #000080; color: white;" @onclick="SalvarAluno">
            SALVAR
        </button>
    </div>
    <div class="d-flex gap-6 mt-4">
        <button class="btn w-10 p-1 fw-bold" style="background-color: #000080; color: white;" @onclick="IrParaFinanceiro">
            FINANCEIRO
        </button>
    </div>

    @if (!string.IsNullOrEmpty(msgErro))
    {
        <div class="alert alert-danger mt-3">@msgErro</div>
    }

</div>

@code {
    private List<Turma> listaTurmas = new();
    private List<Responsavel> listaResponsaveis = new();
    private List<Responsavel> sugestoesResponsaveis = new();

    private Aluno? aluno;

    private Responsavel? responsavelSelecionado = null;
    private Responsavel responsavelAluno = null;

    private string Nome = "";
    private DateTime? dataNascimento = new DateTime();
    private string RA = "";
    private string Religiao = "";
    private string turmaId = "";
    private string responsavelCpf = "";
    private int tipoParentesco = 6;
    private int Idade = 0;
    private string Pediatra = "";
    private string Orientacoes = "";
    private List<string> Alergias = new List<string>();
    private List<string> CondicoesEspeciais = new List<string>();

    private string idadeExtenso = "0 anos e 0 meses";


    private string addAlergia = "";
    private string addCondicao = "";
    private string msgErro = "";
    [Parameter] public Guid id { get; set; }



    protected override void OnInitialized()
    {
        aluno = AlunoController.Get(id.ToString(), null);
        Nome = aluno.Nome;
        dataNascimento = aluno.DataNascimento;
        RA = aluno.RA;
        Religiao = aluno.Religiao;
        turmaId = aluno.Turma?.Id.ToString();
        Pediatra = aluno.NomePediatra;
        Orientacoes = aluno.OrientacoesEmergencia;
        Alergias = new List<string>(aluno.Alergias);
        CondicoesEspeciais = new List<string>(aluno.CondicoesEspeciais);

        responsavelAluno = aluno.Responsaveis.FirstOrDefault();

        responsavelCpf = Mask.FormatCpf(responsavelAluno.CPF);

        tipoParentesco = responsavelAluno.GetAlunoParentesco(aluno).Tipo;
        CalcularIdade();
        listaTurmas = TurmaController.GetAll();
        listaResponsaveis = ResponsavelController.GetAll();
    }
    void IrParaFinanceiro()
    {
        Navigation.NavigateTo($"/folha-pagamento/{aluno.Id}");
    }
    void CancelarEdicao()
    {
        Navigation.NavigateTo("/alunos");
    }

    void OnCpfInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "")
            .Where(char.IsDigit)
            .ToArray());

        if (digits.Length > 11)
            digits = digits[..11];

        responsavelCpf = Mask.FormatCpf(digits);

        sugestoesResponsaveis = listaResponsaveis
            .Where(r => !string.IsNullOrEmpty(r.CPF) && r.CPF.Contains(digits))
            .Take(5)
            .ToList();

        responsavelSelecionado = null;
    }

    void SelecionarResponsavel(Responsavel r)
    {
        responsavelSelecionado = r;
        responsavelCpf = Mask.FormatCpf(r.CPF);
        sugestoesResponsaveis.Clear();
    }

    private void CalcularIdade()
    {
        DateTime data = dataNascimento ?? DateTime.Today;

        DateTime hoje = DateTime.Today;
        int anos = hoje.Year - data.Year;
        if (hoje < data.AddYears(anos)) anos--;

        int meses = hoje.Month - data.Month;
        if (hoje.Day < data.Day) meses--;
        if (meses < 0) meses += 12;

        idadeExtenso = $"{anos} anos e {meses} meses";
        Idade = anos;
    }

    private async Task SalvarAluno()
    {
        var cpfSemMascara = Mask.RemoveMask(responsavelCpf);

        if (string.IsNullOrWhiteSpace(Nome) || string.IsNullOrWhiteSpace(cpfSemMascara))
        {
            msgErro = "Nome e CPF do responsável são obrigatórios.";
            return;
        }

        try
        {
            var resp = responsavelSelecionado
                       ?? ResponsavelController.Get("CPF", cpfSemMascara);

            if (resp == null)
            {
                msgErro = "Responsável não encontrado no sistema.";
                return;
            }
            aluno.Nome = Nome;
            aluno.DataNascimento = dataNascimento;
            aluno.Religiao = Religiao;
            Turma newTurma = TurmaController.Get(turmaId, null);
            TurmaController.MoverAlunoParaOutraTurma(newTurma, aluno.Turma, aluno);
            aluno.NomePediatra = Pediatra;
            aluno.OrientacoesEmergencia = Orientacoes;
            aluno.Alergias = Alergias;
            aluno.CondicoesEspeciais = CondicoesEspeciais;
            responsavelAluno.GetAlunoParentesco(aluno).Tipo = tipoParentesco;

            Navigation.NavigateTo("/alunos");
        }
        catch (Exception ex)
        {
            msgErro = "Erro: " + ex.Message;
        }
    }

    private void HandleAlergiaKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAlergia))
        {
            Alergias.Add(addAlergia);
            addAlergia = "";
        }
    }

    private void HandleCondicoesKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addCondicao))
        {
            CondicoesEspeciais.Add(addCondicao);
            addCondicao = "";
        }
    }
}