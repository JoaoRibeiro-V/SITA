@inject NavigationManager Navigation
@using SITA.src.Util
@using SITA.src.Model

<section class="nav-bar">

    <!-- LOGO -->
    <div class="nav-logo">
        <img src="assets/images/Logo.png"
             @onclick="GoHome"
             style="cursor:pointer;" />
    </div>

    <!-- MAIN NAV -->
    <ul class="nav-list">
        @foreach (var item in RouteHandler.MainNav.Where(CanAccess))
        {
            <li class="nav-item">
                <a href="javascript:void(0)"
                       @onclick='() => GoAndClose(item.Path)'>
                    @item.Name
                </a>
            </li>
        }
    </ul>

    <!-- tem que fazer aparecer so no cell -->

    <!-- HAMBURGER -->
    <div class="checkbox-wrapper">

        <!-- BUTTON -->
        <div class="checkbox @(menuOpen ? "open" : "")" @onclick="ToggleMenu">
            <div class="trace"></div>
            <div class="trace"></div>
            <div class="trace"></div>
        </div>

        <!-- OVERLAY -->
        <div class="menu @(menuOpen ? "open" : "")"
             @onclick="CloseMenu"></div>

        <!-- SIDE MENU -->
        <nav class="menu-items @(menuOpen ? "open" : "")">
            <ul>

                @foreach (var item in RouteHandler.CadastroNav.Where(CanAccess))
                {
                    <li>
                        <a href="javascript:void(0)"
                               @onclick='() => GoAndClose(item.Path)'>
                            @item.Name
                        </a>
                    </li>
                }

                <li style="margin-top:30px;">
                    <a href="javascript:void(0)"
                           @onclick="Logout"
                           style="color:#ffcccc;">
                        Sair
                    </a>
                </li>

            </ul>
        </nav>

    </div>

</section>

@code {

    private int userLevel;
    private bool menuOpen = false;

    protected override void OnInitialized()
    {
        userLevel = Session.GetInstanceAccess().Level;
    }

    bool CanAccess(RouteHandler.RouteItem item)
        => userLevel >= item.MinAccessLevel;

    void ToggleMenu() => menuOpen = !menuOpen;
    void CloseMenu() => menuOpen = false;

    void Go(string route)
    {
        Navigation.NavigateTo(route);
    }

    void GoAndClose(string route)
    {
        menuOpen = false;
        Navigation.NavigateTo(route);
    }

    void GoHome()
    {
        GoAndClose(RouteHandler.Home);
    }

    void Logout()
    {
        Session.InitSession(new User
        {
            AccessType = new AccessType
            {
                Level = -1
            }
        });

        Navigation.NavigateTo(RouteHandler.SignIn, true);
    }
}