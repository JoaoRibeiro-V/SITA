@inject NavigationManager Navigation
@using SITA.src.Util
@using SITA.src.Model

<section class="app-navbar">

    <div class="app-navbar-logo">
        <img src="assets/images/NewCanvas1.png"
             @onclick="GoHome" />
    </div>

    <ul class="app-navbar-list">
        @foreach (var item in RouteHandler.MainNav.Where(CanAccess))
        {
            <li class="app-navbar-item">
                <a href="javascript:void(0)"
                       @onclick='() => GoAndClose(item.Path)'>
                    @item.Name
                </a>
            </li>
        }
    </ul>

    <button type="button"
            class="app-navbar-logout"
            @onclick="Logout">
        Sair
    </button>

    <div class="app-mobile-menu">

        <button type="button"
                class="app-hamburger @(menuOpen ? "open" : "")"
                @onclick="ToggleMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="app-menu-overlay @(menuOpen ? "open" : "")"
             @onclick="CloseMenu">
        </div>

        <nav class="app-menu-panel @(menuOpen ? "open" : "")">
            <ul>
                @foreach (var item in RouteHandler.MainNav.Where(CanAccess))
                {
                    <li>
                        <a href="javascript:void(0)"
                               @onclick='() => GoAndClose(item.Path)'>
                            @item.Name
                        </a>
                    </li>
                }

                @foreach (var item in RouteHandler.CadastroNav.Where(CanAccess))
                {
                    <li>
                        <a href="javascript:void(0)"
                               @onclick='() => GoAndClose(item.Path)'>
                            @item.Name
                        </a>
                    </li>
                }

                <li class="app-menu-logout">
                    <a href="javascript:void(0)" @onclick="Logout">
                        Sair
                    </a>
                </li>
            </ul>
        </nav>

    </div>

</section>

                        
@code {
    private int userLevel;
    private bool menuOpen = false;

    protected override void OnInitialized()
    {
        userLevel = Session.GetInstanceAccess().Level;
    }

    bool CanAccess(RouteHandler.RouteItem item)
        => userLevel >= item.MinAccessLevel;

    void ToggleMenu() => menuOpen = !menuOpen;

    void CloseMenu() => menuOpen = false;

    void GoAndClose(string route)
    {
        menuOpen = false;
        Navigation.NavigateTo(route);
    }

    void GoHome()
    {
        GoAndClose(RouteHandler.Home);
    }

    void Logout()
    {
        Session.InitSession(new User
        {
            AccessType = new AccessType
            {
                Level = -1
            }
        });

        Navigation.NavigateTo(RouteHandler.SignIn, true);
    }
}